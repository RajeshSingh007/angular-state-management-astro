---
import Navbar from '../components/Navbar.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Angular Signals — Deep Dive</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>

<Navbar active="/signal_v1" />

<main>
<div class="pt-14">

  <!-- ══ HERO ══ -->
  <div class="hero-wrap">
  <div class="hero">
    <p class="pill"><span class="pill-dot"></span>Angular · Signals</p>
    <h1>Angular <span>Signals</span></h1>
    <p class="hero-sub">
      The reactive state system that tells Angular <em>exactly</em> what changed —
      so only the right parts of your UI update. No more guessing. No more Zone.js magic.
    </p>
  </div>
  </div><!-- /hero-wrap -->

  <!-- ══ APP SHELL ══ -->
  <div class="app-shell">

    <!-- ── Sidebar ── -->
    <aside class="tl-sidebar" aria-label="Section navigation">
      <p class="tl-group-label">Foundation</p>
      <div class="tl-list">
        {[
          { sid:'the-problem',    n:'01', label:'The Problem'       },
          { sid:'what-is-signal', n:'02', label:'What Is a Signal?' },
          { sid:'signal-vs-prop', n:'03', label:'Signal vs Property'},
        ].map(({ sid, n, label }) => (
          <button class={`tl-item${sid === 'the-problem' ? ' active' : ''}`} data-target={sid} type="button">
            <span class="tl-badge">{n}</span>
            <span class="tl-meta">
              <span class="tl-step-num">Section {n}</span>
              <span class="tl-step-label">{label}</span>
            </span>
          </button>
        ))}
      </div>
      <p class="tl-group-label">Deep Dive</p>
      <div class="tl-list">
        {[
          { sid:'creating-signals', n:'04', label:'Creating Signals' },
          { sid:'computed',         n:'05', label:'computed()'       },
          { sid:'effects',          n:'06', label:'effect()'         },
        ].map(({ sid, n, label }) => (
          <button class="tl-item" data-target={sid} type="button">
            <span class="tl-badge">{n}</span>
            <span class="tl-meta">
              <span class="tl-step-num">Section {n}</span>
              <span class="tl-step-label">{label}</span>
            </span>
          </button>
        ))}
      </div>
      <p class="tl-group-label">Advanced</p>
      <div class="tl-list">
        {[
          { sid:'readonly',  n:'07', label:'asReadonly()'   },
          { sid:'untracked', n:'08', label:'untracked()'    },
          { sid:'gotchas',   n:'09', label:'The Rules'      },
          { sid:'rxjs',      n:'10', label:'Signals vs RxJS'},
        ].map(({ sid, n, label }) => (
          <button class="tl-item" data-target={sid} type="button">
            <span class="tl-badge">{n}</span>
            <span class="tl-meta">
              <span class="tl-step-num">Section {n}</span>
              <span class="tl-step-label">{label}</span>
            </span>
          </button>
        ))}
      </div>
    </aside>

    <!-- ── Content Pane ── -->
    <div class="content-pane">

      <!-- ════ 01 THE PROBLEM ════ -->
      <section data-sid="the-problem" class="section sec-panel active">
        <p class="eyebrow">01 · The Problem</p>
        <h2 class="sec-title">Why Does Your UI <span>Lie to You</span>?</h2>
        <p class="sec-lead">
          You update a variable. Nothing happens on screen. Or you change one tiny thing and the
          entire component tree re-renders. Both are symptoms of the same root cause:
          <strong>Angular had no way to know exactly what changed — and who actually cares.</strong>
        </p>

        <!-- ══ GRAPHIC: Zoney vs Sparky ══ -->
        <div class="s1-graphic">

          <!-- LEFT: Old Way -->
          <div class="s1-panel-graphic s1-panel-old">
            <div class="s1-panel-tag s1-tag-red">Zone.js — Old Way</div>

            <svg class="s1-mascot zoney-anim" viewBox="0 0 130 145" xmlns="http://www.w3.org/2000/svg">
              <!-- Shadow -->
              <ellipse cx="62" cy="138" rx="32" ry="6" fill="rgba(0,0,0,.08)"/>
              <!-- Body -->
              <circle cx="62" cy="62" r="48" fill="#ff9600" stroke="#c46700" stroke-width="3"/>
              <!-- Belly shine -->
              <ellipse cx="50" cy="45" rx="14" ry="10" fill="rgba(255,255,255,.18)" transform="rotate(-20,50,45)"/>
              <!-- Cheek blush -->
              <circle cx="32" cy="75" r="12" fill="#e07000" opacity=".35"/>
              <circle cx="92" cy="75" r="12" fill="#e07000" opacity=".35"/>
              <!-- Left stressed eyebrow -->
              <path d="M28 36 Q40 26 52 35" fill="none" stroke="#7a3800" stroke-width="4" stroke-linecap="round"/>
              <!-- Right stressed eyebrow -->
              <path d="M72 35 Q84 26 96 36" fill="none" stroke="#7a3800" stroke-width="4" stroke-linecap="round"/>
              <!-- Left eye white -->
              <ellipse cx="40" cy="52" rx="11" ry="12" fill="white"/>
              <circle cx="43" cy="54" r="7" fill="#1a1a1a"/>
              <circle cx="45" cy="51" r="2.5" fill="white"/>
              <!-- Right eye white -->
              <ellipse cx="84" cy="52" rx="11" ry="12" fill="white"/>
              <circle cx="87" cy="54" r="7" fill="#1a1a1a"/>
              <circle cx="89" cy="51" r="2.5" fill="white"/>
              <!-- Worried mouth -->
              <path d="M44 79 Q62 72 80 79" fill="none" stroke="#7a3800" stroke-width="3" stroke-linecap="round"/>
              <!-- Sweat drop -->
              <path d="M100 18 Q106 9 112 18 Q112 28 100 28 Z" fill="#1cb0f6"/>
              <path d="M104 18 Q107 14 110 18 Q110 24 104 24 Z" fill="rgba(255,255,255,.4)"/>
              <!-- Left leg -->
              <rect x="38" y="105" width="18" height="28" rx="9" fill="#c46700" transform="rotate(-15,47,119)"/>
              <!-- Right leg -->
              <rect x="74" y="108" width="18" height="28" rx="9" fill="#c46700" transform="rotate(15,83,122)"/>
              <!-- Left shoe -->
              <ellipse cx="36" cy="131" rx="14" ry="7" fill="#7a3800" transform="rotate(-15,36,131)"/>
              <!-- Right shoe -->
              <ellipse cx="92" cy="133" rx="14" ry="7" fill="#7a3800" transform="rotate(15,92,133)"/>
              <!-- Magnifying glass handle -->
              <line x1="105" y1="78" x2="122" y2="96" stroke="#7a3800" stroke-width="6" stroke-linecap="round"/>
              <!-- Magnifying glass ring -->
              <circle cx="97" cy="68" r="18" fill="rgba(255,255,255,.25)" stroke="#7a3800" stroke-width="4.5"/>
              <!-- Glass shine -->
              <path d="M87 57 Q91 54 96 57" fill="none" stroke="rgba(255,255,255,.6)" stroke-width="2.5" stroke-linecap="round"/>
            </svg>

            <p class="s1-mascot-name">Zoney</p>
            <p class="s1-mascot-caption">Scans <em>everything</em> after every async event</p>

            <div class="s1-comps-row">
              <div class="s1-comp-box s1-comp-scan" style="animation-delay:0s">
                <span class="s1-comp-icon">📦</span>
                <span>C1</span>
              </div>
              <div class="s1-comp-box s1-comp-scan" style="animation-delay:.5s">
                <span class="s1-comp-icon">📦</span>
                <span>C2</span>
              </div>
              <div class="s1-comp-box s1-comp-scan s1-comp-changed" style="animation-delay:1s">
                <span class="s1-comp-icon">🔥</span>
                <span>C3</span>
              </div>
              <div class="s1-comp-box s1-comp-scan" style="animation-delay:1.5s">
                <span class="s1-comp-icon">📦</span>
                <span>C4</span>
              </div>
              <div class="s1-comp-box s1-comp-scan" style="animation-delay:2s">
                <span class="s1-comp-icon">📦</span>
                <span>C5</span>
              </div>
            </div>
            <div class="s1-verdict s1-verdict-bad">Checked 5 — found 1 change — wasted 4 checks</div>
          </div>

          <!-- VS pill -->
          <div class="s1-vs">VS</div>

          <!-- RIGHT: Signal Way -->
          <div class="s1-panel-graphic s1-panel-new">
            <div class="s1-panel-tag s1-tag-green">Signals — New Way</div>

            <svg class="s1-mascot sparky-anim" viewBox="0 0 130 155" xmlns="http://www.w3.org/2000/svg">
              <!-- Shadow -->
              <ellipse cx="65" cy="148" rx="30" ry="6" fill="rgba(0,0,0,.08)"/>
              <!-- Lightning bolt body -->
              <polygon points="80,6 42,72 66,72 32,148 92,68 68,68 100,6"
                       fill="#58cc02" stroke="#2d6e00" stroke-width="3.5" stroke-linejoin="round"/>
              <!-- Inner bolt highlight -->
              <polygon points="77,14 52,62 68,62 45,118 84,74 68,74 92,14"
                       fill="#7ae800" opacity=".45"/>
              <!-- Face background -->
              <ellipse cx="68" cy="46" rx="20" ry="24" fill="#7ae800" opacity=".3"/>
              <!-- Left eye white -->
              <ellipse cx="58" cy="40" rx="9" ry="10" fill="white"/>
              <circle cx="60" cy="42" r="6" fill="#1a1a1a"/>
              <circle cx="62" cy="39" r="2" fill="white"/>
              <!-- Right eye white -->
              <ellipse cx="79" cy="38" rx="9" ry="10" fill="white"/>
              <circle cx="81" cy="40" r="6" fill="#1a1a1a"/>
              <circle cx="83" cy="37" r="2" fill="white"/>
              <!-- Happy eyebrows -->
              <path d="M51 30 Q58 26 65 31" fill="none" stroke="#2d6e00" stroke-width="3" stroke-linecap="round"/>
              <path d="M72 29 Q79 25 86 30" fill="none" stroke="#2d6e00" stroke-width="3" stroke-linecap="round"/>
              <!-- Big smile -->
              <path d="M55 56 Q68 68 82 56" fill="none" stroke="#2d6e00" stroke-width="3" stroke-linecap="round"/>
              <!-- Cheek blush -->
              <circle cx="48" cy="52" rx="8" fill="#46a302" opacity=".3"/>
              <circle cx="88" cy="50" rx="8" fill="#46a302" opacity=".3"/>
              <!-- Left arm pointing -->
              <path d="M44 75 Q30 90 20 105" fill="none" stroke="#2d6e00" stroke-width="5" stroke-linecap="round"/>
              <circle cx="18" cy="108" r="5" fill="#2d6e00"/>
              <!-- Right arm -->
              <path d="M90 70 Q104 82 112 75" fill="none" stroke="#2d6e00" stroke-width="5" stroke-linecap="round"/>
              <circle cx="114" cy="74" r="5" fill="#2d6e00"/>
              <!-- Star sparkles -->
              <circle cx="22" cy="22" r="4" fill="#ffc800"/>
              <circle cx="112" cy="30" r="3" fill="#ffc800"/>
              <circle cx="18" cy="52" r="2.5" fill="#ffc800"/>
            </svg>

            <p class="s1-mascot-name">Sparky</p>
            <p class="s1-mascot-caption">Notifies <em>only the exact</em> component that cares</p>

            <div class="s1-comps-row">
              <div class="s1-comp-box s1-comp-idle">
                <span class="s1-comp-icon">📦</span>
                <span>C1</span>
              </div>
              <div class="s1-comp-box s1-comp-idle">
                <span class="s1-comp-icon">📦</span>
                <span>C2</span>
              </div>
              <div class="s1-comp-box s1-comp-target">
                <span class="s1-comp-icon">⚡</span>
                <span>C3</span>
              </div>
              <div class="s1-comp-box s1-comp-idle">
                <span class="s1-comp-icon">📦</span>
                <span>C4</span>
              </div>
              <div class="s1-comp-box s1-comp-idle">
                <span class="s1-comp-icon">📦</span>
                <span>C5</span>
              </div>
            </div>
            <div class="s1-verdict s1-verdict-good">Notified C3 only — C1 C2 C4 C5 untouched ✓</div>
          </div>

        </div>
        <!-- ══ /GRAPHIC ══ -->

        <!-- Zone.js plain-language card -->
        <div class="mental-section">
          <header class="route-section-title">Wait — What Even Is Zone.js?</header>
          <div class="zonejs-card">
            <div class="zonejs-icon">🕵️</div>
            <div class="zonejs-body">
              <p class="zonejs-title">Zone.js is a spy Angular hired to watch your browser</p>
              <p class="card-body">Your browser does async things constantly — click events, HTTP responses, timers. Zone.js secretly wraps all of them. The moment any async thing finishes, Zone.js taps Angular on the shoulder and says <strong>"Hey! Something just happened. You should probably check if anything changed."</strong></p>
              <p class="card-body" style="margin-top:.5rem;">That's it. Zone.js doesn't know <em>what</em> changed. It just knows <em>that</em> something async ran. Angular then has to do the checking itself.</p>
              <div class="zonejs-flow">
                <div class="zonejs-step">
                  <span class="zonejs-step-icon">🖱️</span>
                  <span class="zonejs-step-label">Async event<br/>(click, HTTP, timer)</span>
                </div>
                <div class="zonejs-arrow">→</div>
                <div class="zonejs-step">
                  <span class="zonejs-step-icon">🕵️</span>
                  <span class="zonejs-step-label">Zone.js<br/>intercepts it</span>
                </div>
                <div class="zonejs-arrow">→</div>
                <div class="zonejs-step">
                  <span class="zonejs-step-icon">⚠️</span>
                  <span class="zonejs-step-label">Tells Angular:<br/>"Something ran!"</span>
                </div>
                <div class="zonejs-arrow">→</div>
                <div class="zonejs-step zonejs-step-panic">
                  <span class="zonejs-step-icon">😰</span>
                  <span class="zonejs-step-label">Angular checks<br/><strong>everything</strong></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mental-section">
          <header class="route-section-title">How Angular Used to Detect Changes</header>
          <div class="g2 mb-md">
            <div class="sticker sticker-red">
              <header class="sticker-title">😩 The Old Way — Zone.js</header>
              <p class="card-body">Angular wrapped every async operation in the browser — <code>setTimeout</code>, HTTP calls, click events — and after each one it would walk your entire component tree asking <strong>"did anything change?"</strong>. It had to check everything because it had no idea what your code touched.</p>
              <div class="tag-row">
                <span class="chip chip-red">Checks everything</span>
                <span class="chip chip-red">Imprecise</span>
                <span class="chip chip-red">Slow on big trees</span>
              </div>
            </div>
            <div class="sticker sticker-green">
              <header class="sticker-title">✅ The Signal Way</header>
              <p class="card-body">When you read a signal inside a template, Angular registers: <strong>"this component cares about this signal."</strong> When the signal value changes, Angular knows exactly which components to update — nothing more.</p>
              <div class="tag-row">
                <span class="chip chip-green">Surgical updates</span>
                <span class="chip chip-green">No guessing</span>
                <span class="chip chip-green">Fast</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mental-section">
          <header class="route-section-title">The Real-World Analogy</header>
          <div class="sticker sticker-top-orange mb-md">
            <header class="sticker-title">🚨 Old Way = A Fire Alarm That Trips on Everything</header>
            <p class="card-body">
              Every time anything happens in the building (someone opens a door, a light flickers, a breeze moves a curtain),
              the fire alarm goes off. Everyone evacuates. Security checks every single room to see if there's actually a fire.
              <strong>Most of the time: no fire. Wasted effort.</strong>
            </p>
          </div>
          <div class="sticker sticker-top-green">
            <header class="sticker-title">⚡ Signal Way = Smart Smoke Detector in Each Room</header>
            <p class="card-body">
              Each room has its own sensor. When Room 4B's sensor triggers, only Room 4B is investigated.
              The other 200 rooms are not disturbed. <strong>Angular knows exactly which "room" (component) to update
              because each signal reports exactly who is listening.</strong>
            </p>
          </div>
        </div>

        <div class="callout callout-blue">
          <header class="callout-title callout-title-blue">💡 The Root Insight</header>
          <p>The problem was never Angular being slow. The problem was Angular being <strong>blind</strong> — it couldn't see inside your properties, so it had to assume everything might have changed. Signals fix the blindness.</p>
        </div>

        <!-- Animated tree demo -->
        <div class="mental-section">
          <header class="route-section-title">Watch it happen — Angular checking every component</header>
          <p class="card-body" style="margin-bottom:1rem;">When a button is clicked, here's what Angular does under the hood. Watch the tree get scanned node by node, even though only <strong>Chart</strong> actually changed.</p>

          <div class="tree-demo">
            <!-- Trigger bar -->
            <div class="tree-trigger">
              <div class="tree-trigger-btn">🖱️ Button clicked — HTTP response arrived</div>
              <div class="tree-trigger-arrow">↓</div>
              <div class="tree-zone-intercept">
                <span class="tree-zone-dot"></span>
                Zone.js intercepts → tells Angular → <strong>"Check everything now"</strong>
              </div>
              <div class="tree-trigger-arrow">↓</div>
            </div>

            <!-- Component tree: fully nested tree-col so all connectors auto-align -->
            <div class="tree-visual">
              <div class="tree-col">
                <!-- AppRoot -->
                <div class="tree-node-wrap">
                  <div class="tree-node tnode-1">
                    <span class="tnode-emoji">🏠</span>
                    <span class="tnode-label">AppRoot</span>
                    <span class="tnode-status">checking...</span>
                  </div>
                </div>
                <!-- AppRoot → [Navbar, Dashboard]: asymmetric children → tbranch-root offsets the lines -->
                <div class="tbranch tbranch-root">
                  <span class="tbranch-l"></span>
                  <span class="tbranch-r"></span>
                </div>
                <div class="tree-sub-level">
                  <!-- Navbar (leaf) -->
                  <div class="tree-node-wrap">
                    <div class="tree-node tnode-2">
                      <span class="tnode-emoji">🧭</span>
                      <span class="tnode-label">Navbar</span>
                      <span class="tnode-status">checking...</span>
                    </div>
                  </div>
                  <div class="tree-node-gap"></div>
                  <!-- Dashboard tree-col with all descendants inside -->
                  <div class="tree-col">
                    <div class="tree-node-wrap">
                      <div class="tree-node tnode-3">
                        <span class="tnode-emoji">📊</span>
                        <span class="tnode-label">Dashboard</span>
                        <span class="tnode-status">checking...</span>
                      </div>
                    </div>
                    <div class="tbranch"><span class="tbranch-l"></span><span class="tbranch-r"></span></div>
                    <div class="tree-sub-level">
                      <!-- Chart tree-col -->
                      <div class="tree-col">
                        <div class="tree-node-wrap">
                          <div class="tree-node tnode-4 tnode-changed">
                            <span class="tnode-emoji">📈</span>
                            <span class="tnode-label">Chart</span>
                            <span class="tnode-changed-badge">CHANGED!</span>
                          </div>
                        </div>
                        <div class="tbranch"><span class="tbranch-l"></span><span class="tbranch-r"></span></div>
                        <div class="tree-sub-level">
                          <div class="tree-node-wrap">
                            <div class="tree-node tnode-sm tnode-5">
                              <span class="tnode-emoji">📌</span>
                              <span class="tnode-label">Legend</span>
                              <span class="tnode-status">checking...</span>
                            </div>
                          </div>
                          <div class="tree-node-gap-sm"></div>
                          <div class="tree-node-wrap">
                            <div class="tree-node tnode-sm tnode-6">
                              <span class="tnode-emoji">💬</span>
                              <span class="tnode-label">Tooltip</span>
                              <span class="tnode-status">checking...</span>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="tree-node-gap-sm"></div>
                      <!-- Table tree-col -->
                      <div class="tree-col">
                        <div class="tree-node-wrap">
                          <div class="tree-node tnode-7">
                            <span class="tnode-emoji">📋</span>
                            <span class="tnode-label">Table</span>
                            <span class="tnode-status">checking...</span>
                          </div>
                        </div>
                        <div class="tbranch"><span class="tbranch-l"></span><span class="tbranch-r"></span></div>
                        <div class="tree-sub-level">
                          <div class="tree-node-wrap">
                            <div class="tree-node tnode-sm tnode-8">
                              <span class="tnode-emoji">📑</span>
                              <span class="tnode-label">TblHeader</span>
                              <span class="tnode-status">checking...</span>
                            </div>
                          </div>
                          <div class="tree-node-gap-sm"></div>
                          <div class="tree-node-wrap">
                            <div class="tree-node tnode-sm tnode-9">
                              <span class="tnode-emoji">📝</span>
                              <span class="tnode-label">TblRow</span>
                              <span class="tnode-status">checking...</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Result bar -->
            <div class="tree-result-bar">
              <div class="tree-result-item tree-result-total">
                <span class="tree-result-num">9</span>
                <span class="tree-result-lbl">Components<br/>checked</span>
              </div>
              <div class="tree-result-divider"></div>
              <div class="tree-result-item tree-result-changed-item">
                <span class="tree-result-num tree-result-num-red">1</span>
                <span class="tree-result-lbl">Actually<br/>changed</span>
              </div>
              <div class="tree-result-divider"></div>
              <div class="tree-result-item tree-result-wasted-item">
                <span class="tree-result-num tree-result-num-grey">8</span>
                <span class="tree-result-lbl">Wasted<br/>checks</span>
              </div>
              <div class="tree-result-verdict">Every async event → full tree scan. No exceptions.</div>
            </div>
          </div>
        </div>

        <!-- ══ WHY CAN'T ANGULAR JUST STOP? ══ -->
        <div class="mental-section">
          <header class="route-section-title">The crux — why Zone.js left Angular blind</header>

          <!-- Message comparison -->
          <div class="msg-compare">
            <div class="msg-card msg-card-bad">
              <div class="msg-card-from">
                <span class="msg-from-dot msg-from-dot-orange"></span>
                Zone.js → Angular
              </div>
              <div class="msg-bubble msg-bubble-orange">
                <p class="msg-bubble-text">"Hey, a click handler just finished."</p>
              </div>
              <ul class="msg-missing">
                <li><span class="msg-x">✗</span> Which variable changed?</li>
                <li><span class="msg-x">✗</span> Which component owns it?</li>
                <li><span class="msg-x">✗</span> How many things changed?</li>
              </ul>
              <div class="msg-result msg-result-bad">Angular's only option: <strong>check everything</strong></div>
            </div>

            <div class="msg-vs">→</div>

            <div class="msg-card msg-card-good">
              <div class="msg-card-from">
                <span class="msg-from-dot msg-from-dot-green"></span>
                Signal → Angular
              </div>
              <div class="msg-bubble msg-bubble-green">
                <p class="msg-bubble-text">"The <code>data</code> signal changed. Chart and Dashboard are watching it."</p>
              </div>
              <ul class="msg-missing">
                <li><span class="msg-check">✓</span> Exact variable named</li>
                <li><span class="msg-check">✓</span> Exact components named</li>
                <li><span class="msg-check">✓</span> Zero guessing needed</li>
              </ul>
              <div class="msg-result msg-result-good">Angular's action: <strong>update only those 2</strong></div>
            </div>
          </div>

          <!-- Why the walk doesn't stop early -->
          <div class="no-stop-card">
            <div class="no-stop-title">❓ But why doesn't Angular stop after finding Chart's property changed?</div>
            <p class="card-body no-stop-body">Angular walks the <strong>entire tree</strong>, depth-first. After Chart changes, Angular still dives into Chart's children (because Chart re-rendering may have changed what it passes down via <code>@Input()</code>). Then it checks Table and all of Table's children too. Every node. Every time.</p>
            <div class="no-stop-walk">
              <div class="nsw-step nsw-same">AppRoot <span class="nsw-tag nsw-tag-grey">template output same → dive into children</span></div>
              <div class="nsw-children">
                <div class="nsw-step nsw-same">Navbar <span class="nsw-tag nsw-tag-grey">template output same → no children, back up</span></div>
                <div class="nsw-step nsw-same">Dashboard <span class="nsw-tag nsw-tag-grey">template output same → dive into children</span></div>
                <div class="nsw-children">
                  <div class="nsw-step nsw-changed">Chart 📈 <span class="nsw-tag nsw-tag-red">property CHANGED → update DOM</span><span class="nsw-keep"> still dives into children ↓</span></div>
                  <div class="nsw-children">
                    <div class="nsw-step nsw-same">ChartLegend <span class="nsw-tag nsw-tag-grey">template output same → back up</span></div>
                    <div class="nsw-step nsw-same">ChartTooltip <span class="nsw-tag nsw-tag-grey">template output same → back up</span></div>
                  </div>
                  <div class="nsw-step nsw-same">Table <span class="nsw-tag nsw-tag-grey">template output same → dive into children</span></div>
                  <div class="nsw-children">
                    <div class="nsw-step nsw-same">TableHeader <span class="nsw-tag nsw-tag-grey">template output same → back up</span></div>
                    <div class="nsw-step nsw-same">TableRow <span class="nsw-tag nsw-tag-grey">template output same → 9 checks for 1 change</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- What "template output same" means -->
          <div class="tpl-explain-card">
            <div class="tpl-explain-title">📐 What "template output same" actually means</div>
            <div class="tpl-explain-body">
              <div class="tpl-step">
                <span class="tpl-step-num">1</span>
                <div class="tpl-step-text">
                  <strong>Angular re-runs the template function.</strong> Every component has a template like:
                  <pre class="tpl-code-block">&lt;h1&gt;&#123;&#123; title &#125;&#125;&lt;/h1&gt;
&lt;p&gt;&#123;&#123; user.name &#125;&#125;&lt;/p&gt;</pre>
                  Angular compiled this into a JS function. After every async event it calls that function — which reads the component's properties and returns a list of current values.
                </div>
              </div>
              <div class="tpl-step">
                <span class="tpl-step-num">2</span>
                <div class="tpl-step-text">
                  <strong>Angular compares the new list against the old list, value by value.</strong>
                  <div class="tpl-compare">
                    <div class="tpl-compare-row">
                      <span class="tpl-compare-label">Last render</span>
                      <code class="tpl-compare-code">["Hello World", "David"]</code>
                    </div>
                    <div class="tpl-compare-row">
                      <span class="tpl-compare-label">This render</span>
                      <code class="tpl-compare-code">["Hello World", "David"]</code>
                    </div>
                    <div class="tpl-compare-result tpl-compare-same">→ Every value identical. DOM untouched. This is what "template output same" means.</div>
                    <div class="tpl-compare-row" style="margin-top:.65rem">
                      <span class="tpl-compare-label">This render<br/><span style="font-size:.6rem">(after API update)</span></span>
                      <code class="tpl-compare-code tpl-compare-code-red">["Hello World", "<strong>New Name</strong>"]</code>
                    </div>
                    <div class="tpl-compare-result tpl-compare-changed">→ Position 1 differs. Angular updates only that one DOM text node.</div>
                  </div>
                </div>
              </div>
              <div class="tpl-explain-note">The wasted work is re-running the template function for every node just to discover the output is identical. Angular can't skip it — it has no idea which component's properties changed.</div>
            </div>
          </div>

          <!-- The silent assignment insight -->
          <div class="silent-card">
            <div class="silent-title">🔇 The root cause — <code>this.data = response</code> is completely silent</div>
            <div class="silent-compare">
              <div class="silent-side silent-side-bad">
                <div class="silent-side-label">Old — plain property</div>
                <div class="silent-code">this.data = response</div>
