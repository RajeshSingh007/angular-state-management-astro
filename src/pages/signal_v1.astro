    font-size: var(--text-body);
    font-weight: 900;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: .75rem;
  }
  .mental-section { margin-bottom: 1.75rem; }
  .mb-md { margin-bottom: 1rem; }
  .mb-lg { margin-bottom: 1.5rem; }
  .mt-sm { margin-top: .5rem; }

  /* ── Grid layouts ── */
  .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; }
  .g3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: .9rem; }

  /* ── Stickers ── */
  .sticker {
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    padding: .9rem;
    background: var(--surface);
  }
  .sticker-title { font-size: var(--text-body); font-weight: var(--fw-bold); color: var(--ink); letter-spacing: var(--ls-base); margin-bottom: .4rem; }
  .sticker-emoji { font-size: 1.5rem; margin-bottom: .35rem; line-height: 1; }

  .sticker-red    { border-color: var(--red);    background: var(--red-pale);    }
  .sticker-green  { border-color: var(--green);  background: var(--green-pale);  }
  .sticker-blue   { border-color: var(--blue);   background: var(--blue-pale);   }
  .sticker-orange { border-color: var(--orange); background: var(--orange-pale); }
  .sticker-top-green  { border-top: 4px solid var(--green);  border-radius: var(--radius); padding: .9rem; background: var(--surface); }
  .sticker-top-blue   { border-top: 4px solid var(--blue);   border-radius: var(--radius); padding: .9rem; background: var(--surface); }
  .sticker-top-orange { border-top: 4px solid var(--orange); border-radius: var(--radius); padding: .9rem; background: var(--surface); }
  .sticker-left-green  { border-left: 4px solid var(--green);  border-radius: var(--radius); padding: .9rem; background: var(--surface); border-top: var(--border-w) solid var(--border); border-right: var(--border-w) solid var(--border); border-bottom: var(--border-w) solid var(--border); }
  .sticker-left-blue   { border-left: 4px solid var(--blue);   border-radius: var(--radius); padding: .9rem; background: var(--surface); border-top: var(--border-w) solid var(--border); border-right: var(--border-w) solid var(--border); border-bottom: var(--border-w) solid var(--border); }
  .sticker-left-red    { border-left: 4px solid var(--red);    border-radius: var(--radius); padding: .9rem; background: var(--surface); border-top: var(--border-w) solid var(--border); border-right: var(--border-w) solid var(--border); border-bottom: var(--border-w) solid var(--border); }
  .sticker-left-orange { border-left: 4px solid var(--orange); border-radius: var(--radius); padding: .9rem; background: var(--surface); border-top: var(--border-w) solid var(--border); border-right: var(--border-w) solid var(--border); border-bottom: var(--border-w) solid var(--border); }

  /* ── Callouts ── */
  .callout { border: var(--border-w) solid var(--border); border-radius: var(--radius); padding: .9rem 1rem; margin-bottom: 1rem; }
  .callout p { font-size: var(--text-body); color: var(--ink); line-height: var(--lh-body); }
  .callout-title { font-size: var(--text-body); font-weight: var(--fw-bold); margin-bottom: .4rem; }
  .callout-green  { background: var(--green-pale);  border-color: var(--green);  }
  .callout-blue   { background: var(--blue-pale);   border-color: var(--blue);   }
  .callout-yellow { background: var(--yellow-pale); border-color: var(--yellow); }
  .callout-red-left { border-left: 4px solid var(--red); background: var(--red-pale); border-radius: var(--radius); padding: .9rem 1rem; margin-bottom: 1rem; }
  .callout-title-green  { color: var(--green-dark); }
  .callout-title-blue   { color: #0369a1; }
  .callout-title-yellow { color: #92400e; }
  .callout-title-red    { color: var(--red); }

  /* ── Tags ── */
  .tag-row { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .65rem; }
  .chip {
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .05em;
    padding: .15rem .5rem;
    border-radius: var(--radius);
    border: 1.5px solid transparent;
  }
  .chip-green { background: var(--green-pale); border-color: var(--green); color: var(--green-dark); }
  .chip-red   { background: var(--red-pale);   border-color: var(--red);   color: var(--red);        }

  /* ── Explain rows ── */
  .explain-rows { display: flex; flex-direction: column; gap: .5rem; margin-top: .35rem; }
  .explain-row  { display: flex; align-items: flex-start; gap: .6rem; font-size: var(--text-body); color: var(--ink); line-height: var(--lh-body); }
  .explain-num  { flex-shrink: 0; width: 1.25rem; height: 1.25rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .58rem; font-weight: 900; }
  .explain-num-green  { background: var(--green);  color: white; }
  .explain-num-blue   { background: var(--blue);   color: white; }
  .explain-num-orange { background: var(--orange); color: white; }

  /* ── Sol steps ── */
  .sol-steps { display: flex; flex-direction: column; gap: .85rem; margin-bottom: 1rem; }
  .sol-step { display: flex; align-items: flex-start; gap: .85rem; }
  .sol-step-err { background: var(--red-pale); border: var(--border-w) solid var(--red-light); border-radius: var(--radius); padding: .75rem; }
  .sol-num {
    flex-shrink: 0;
    width: 1.7rem; height: 1.7rem;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: .72rem; font-weight: 900;
    color: white;
  }
  .sol-num-green  { background: var(--green); }
  .sol-num-blue   { background: var(--blue); }
  .sol-num-orange { background: var(--orange); }
  .sol-num-red    { background: var(--red); }
  .sol-num-err    { background: var(--red); }

  /* ── Code blocks ── */
  .code-wrap { border: var(--border-w) solid var(--border); border-radius: var(--radius); overflow: hidden; margin-bottom: .5rem; }
  .code-bar {
    display: flex; align-items: center; gap: .5rem;
    padding: .4rem .75rem;
    background: #f7f7f7;
    border-bottom: 1px solid var(--border);
  }
  .code-dots { display: flex; gap: .3rem; }
  .code-dot  { width: .65rem; height: .65rem; border-radius: 50%; }
  .code-filename { font-size: .62rem; font-weight: 700; color: var(--ink); letter-spacing: .04em; margin-left: .2rem; }
  .code-body {
    padding: .85rem 1rem;
    background: #fafafa;
    font-family: var(--font-mono);
    font-size: .75rem;
    line-height: 1.8;
    color: var(--ink);
    overflow-x: auto;
  }
  .code-body-sm { font-size: .68rem; padding: .65rem .85rem; }

  /* code tokens */
  .ky  { color: #9333ea; font-weight: 700; }
  .fn  { color: #0369a1; }
  .st  { color: #16a34a; }
  .hi  { color: #0891b2; }
  .vl  { color: #d97706; }
  .ok  { color: var(--green-dark); font-weight: 700; }
  .rd  { color: var(--red); font-weight: 700; }

  /* ── Before/After panels ── */
  .ba-code-panel { border: var(--border-w) solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .ba-code-head  { padding: .45rem .85rem; font-size: .65rem; font-weight: 800; letter-spacing: .03em; }
  .ba-code-bad  .ba-code-head { background: var(--red-pale);   color: var(--red);        border-bottom: 1px solid var(--red-light); }
  .ba-code-good .ba-code-head { background: var(--green-pale); color: var(--green-dark); border-bottom: 1px solid #bbf7d0; }

  /* ── Final Banner ── */
  .final-banner {
    background: var(--green);
    padding: 1.25rem 2rem;
    text-align: center;
  }
  .final-banner h2 {
    font-family: var(--font-head);
    font-size: 1.35rem;
    font-weight: 900;
    color: white;
    margin-bottom: .35rem;
    letter-spacing: -.01em;
  }
  .final-banner p {
    font-size: 1rem;
    color: rgba(255,255,255,.88);
    max-width: 60ch;
    margin: 0 auto;
    line-height: 1.65;
  }
  .final-banner code {
    background: rgba(255,255,255,.2);
    padding: .1rem .35rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: .88rem;
  }

  /* ══ Section 01 Graphic — Zoney vs Sparky ══ */
  .s1-graphic {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.25rem;
    align-items: start;
    margin: 1.75rem 0 2rem;
  }
  .s1-panel-graphic {
    border-radius: 16px;
    border: 2.5px solid var(--border);
    padding: 1.5rem 1.25rem 1.25rem;
    text-align: center;
    background: var(--surface);
    position: relative;
    overflow: hidden;
  }
  .s1-panel-old { border-color: #fecaca; background: #fff8f8; }
  .s1-panel-new { border-color: #bbf7d0; background: #f6fef0; }

  .s1-panel-tag {
    display: inline-block;
    font-size: .62rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: .22rem .65rem;
    border-radius: var(--radius);
    margin-bottom: 1rem;
  }
  .s1-tag-red   { background: var(--red-pale);   color: var(--red);        border: 1.5px solid var(--red-light); }
  .s1-tag-green { background: var(--green-pale);  color: var(--green-dark); border: 1.5px solid var(--green); }

  .s1-mascot { width: 120px; height: auto; display: block; margin: 0 auto .5rem; }

  .s1-mascot-name {
    font-size: 1rem;
    font-weight: 900;
    color: var(--ink);
    margin-bottom: .15rem;
    letter-spacing: -.01em;
  }
  .s1-mascot-caption {
    font-size: .72rem;
    color: var(--ink);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .s1-comps-row {
    display: flex;
    gap: .4rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: .75rem;
  }
  .s1-comp-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .2rem;
    width: 2.8rem;
    padding: .4rem .2rem;
    border-radius: 10px;
    border: 2px solid var(--border);
    font-size: .65rem;
    font-weight: 800;
    color: var(--ink);
    background: var(--surface);
    letter-spacing: .04em;
  }
  .s1-comp-icon { font-size: .85rem; line-height: 1; }

  /* Scan animation — orange flash sweeping across */
  @keyframes comp-scan {
    0%, 18%  { background: var(--surface);      border-color: var(--border);       color: var(--ink); transform: scale(1);    }
    20%, 35% { background: var(--orange-pale);  border-color: var(--orange);       color: var(--orange);    transform: scale(1.12); }
    55%, 100%{ background: var(--surface);      border-color: var(--border);       color: var(--ink); transform: scale(1);    }
  }
  .s1-comp-scan { animation: comp-scan 2.8s ease-in-out infinite; }
  .s1-comp-changed {
    border-color: var(--red) !important;
    color: var(--red) !important;
  }
  @keyframes comp-scan-changed {
    0%, 18%  { background: var(--red-pale);  border-color: var(--red);  color: var(--red);  transform: scale(1);    }
    20%, 35% { background: #ffa0a0;          border-color: var(--red);  color: white;        transform: scale(1.15); }
    55%, 100%{ background: var(--red-pale);  border-color: var(--red);  color: var(--red);  transform: scale(1);    }
  }
  .s1-comp-changed { animation: comp-scan-changed 2.8s ease-in-out infinite !important; }

  /* Idle components (signal way) — greyed out */
  .s1-comp-idle {
    opacity: .35;
    filter: grayscale(1);
  }

  /* Target component — pulse green */
  @keyframes comp-target {
    0%, 100% { background: var(--green-pale); border-color: var(--green);      transform: scale(1);    box-shadow: none; }
    50%      { background: var(--green-light); border-color: var(--green-dark); transform: scale(1.13); box-shadow: 0 0 0 5px rgba(88,204,2,.22); }
  }
  .s1-comp-target {
    animation: comp-target 1.6s ease-in-out infinite;
    color: var(--green-dark);
    border-color: var(--green);
    background: var(--green-pale);
  }

  /* Character animations */
  @keyframes zoney-run {
    0%, 100% { transform: rotate(-4deg) translateY(0);  }
    25%      { transform: rotate(4deg)  translateY(-5px); }
    50%      { transform: rotate(-4deg) translateY(0);  }
    75%      { transform: rotate(4deg)  translateY(-5px); }
  }
  .zoney-anim { animation: zoney-run .7s ease-in-out infinite; }

  @keyframes sparky-float {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50%      { transform: translateY(-10px) rotate(2deg); }
  }
  .sparky-anim { animation: sparky-float 2.2s ease-in-out infinite; }

  /* VS pill */
  .s1-vs {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--ink);
    color: white;
    font-size: .65rem;
    font-weight: 900;
    letter-spacing: .05em;
    align-self: center;
    flex-shrink: 0;
  }

  /* Verdict labels */
  .s1-verdict {
    font-size: .68rem;
    font-weight: 700;
    border-radius: var(--radius);
    padding: .35rem .65rem;
    line-height: 1.5;
  }
  .s1-verdict-bad  { background: var(--red-pale);   color: var(--red);        border: 1.5px solid var(--red-light); }
  .s1-verdict-good { background: var(--green-pale);  color: var(--green-dark); border: 1.5px solid #bbf7d0; }

  /* ══ Zone.js explanation card ══ */
  .zonejs-card {
    display: flex;
    gap: 1rem;
    background: #fef9ec;
    border: 2px solid var(--yellow);
    border-radius: 16px;
    padding: 1.25rem;
    align-items: flex-start;
  }
  .zonejs-icon { font-size: 2.2rem; flex-shrink: 0; line-height: 1; margin-top: .15rem; }
  .zonejs-title { font-size: .9rem; font-weight: 900; color: var(--ink); margin-bottom: .45rem; letter-spacing: -.01em; }
  .zonejs-flow {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-top: .85rem;
    flex-wrap: wrap;
  }
  .zonejs-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .25rem;
    background: white;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: .5rem .65rem;
    min-width: 80px;
    text-align: center;
  }
  .zonejs-step-icon { font-size: 1.15rem; line-height: 1; }
  .zonejs-step-label { font-size: .6rem; font-weight: 700; color: var(--ink); line-height: 1.4; }
  .zonejs-step-panic { background: var(--red-pale); border-color: var(--red); }
  .zonejs-step-panic .zonejs-step-label { color: var(--red); }
  .zonejs-arrow { font-size: 1rem; color: var(--ink-light); font-weight: 700; flex-shrink: 0; }

  /* ══ Animated Component Tree ══ */
  .tree-demo {
    background: #f8f9fa;
    border: 2px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }
  .tree-trigger {
    background: white;
    border-bottom: 2px solid var(--border);
    padding: 1rem 1.5rem .75rem;
    text-align: center;
  }
  .tree-trigger-btn {
    display: inline-block;
    background: var(--blue-pale);
    border: 2px solid var(--blue);
    border-radius: var(--radius);
    padding: .45rem 1rem;
    font-size: .78rem;
    font-weight: 800;
    color: #0369a1;
    letter-spacing: .02em;
    animation: btn-pulse 2s ease-in-out infinite;
  }
  @keyframes btn-pulse {
    0%,100% { transform: scale(1); box-shadow: none; }
    50% { transform: scale(1.04); box-shadow: 0 0 0 4px rgba(28,176,246,.2); }
  }
  .tree-trigger-arrow {
    font-size: 1.2rem;
    color: var(--ink-light);
    margin: .3rem 0;
    animation: arrow-bounce .8s ease-in-out infinite;
  }
  @keyframes arrow-bounce {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }
  .tree-zone-intercept {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    background: var(--orange-pale);
    border: 1.5px solid var(--orange);
    border-radius: var(--radius);
    padding: .35rem .85rem;
    font-size: .74rem;
    font-weight: 700;
    color: #92400e;
  }
  .tree-zone-dot {
    width: .55rem;
    height: .55rem;
    border-radius: 50%;
    background: var(--orange);
    animation: zone-dot-blink .6s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes zone-dot-blink {
    0%,100% { opacity: 1; transform: scale(1); }
    50% { opacity: .4; transform: scale(.7); }
  }

  /* Tree layout */
  .tree-visual {
    padding: 1.5rem 2rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .tree-level {
    display: flex;
    align-items: center;
    gap: 0;
    justify-content: center;
  }
  .tree-level-offset {
    /* kept for responsive override reference */
  }
  .tree-node-wrap { padding: .35rem; }
  .tree-node-gap  { width: 5rem; }

  .tree-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .25rem;
    width: 5.5rem;
    padding: .6rem .4rem .5rem;
    border-radius: 14px;
    border: 2.5px solid var(--border);
    background: white;
    position: relative;
    transition: transform .15s;
  }
  .tnode-emoji { font-size: 1.3rem; line-height: 1; }
  .tnode-label { font-size: .68rem; font-weight: 800; color: var(--ink); }
  .tnode-status {
    font-size: .55rem;
    font-weight: 700;
    color: transparent;
    background: var(--border);
    border-radius: 4px;
    padding: .1rem .3rem;
  }
  .tnode-changed-badge {
    font-size: .52rem;
    font-weight: 900;
    color: white;
    background: var(--red);
    border-radius: 4px;
    padding: .12rem .35rem;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  /* Scan animations — each node lights up orange in sequence */
  @keyframes node-scan {
    0%, 8%   { background: white;              border-color: var(--border); transform: scale(1); }
    12%, 22% { background: var(--orange-pale); border-color: var(--orange); transform: scale(1.1); }
    12%, 22% { box-shadow: 0 0 0 4px rgba(255,150,0,.18); }
    35%,100% { background: white;              border-color: var(--border); transform: scale(1); box-shadow: none; }
  }
  @keyframes node-scan-status {
    0%, 8%   { color: transparent; background: var(--border); }
    12%, 22% { color: var(--orange); background: var(--orange-pale); }
    35%,100% { color: transparent; background: var(--border); }
  }
  @keyframes node-changed {
    0%, 8%   { background: var(--red-pale);  border-color: #fca5a5; transform: scale(1); }
    12%, 22% { background: var(--red);       border-color: var(--red); transform: scale(1.14); box-shadow: 0 0 0 5px rgba(255,75,75,.22); }
    35%,100% { background: var(--red-pale);  border-color: #fca5a5; transform: scale(1); box-shadow: none; }
  }

  /* Staggered delays: depth-first order, 0.6s apart, loop every 8s */
  .tnode-1 { animation: node-scan    8s ease-in-out infinite 0s; }
  .tnode-2 { animation: node-scan    8s ease-in-out infinite .6s; }
  .tnode-3 { animation: node-scan    8s ease-in-out infinite 1.2s; }
  .tnode-4 { animation: node-changed 8s ease-in-out infinite 1.8s; }
  .tnode-5 { animation: node-scan    8s ease-in-out infinite 2.4s; }
  .tnode-6 { animation: node-scan    8s ease-in-out infinite 3.0s; }
  .tnode-7 { animation: node-scan    8s ease-in-out infinite 3.6s; }
  .tnode-8 { animation: node-scan    8s ease-in-out infinite 4.2s; }
  .tnode-9 { animation: node-scan    8s ease-in-out infinite 4.8s; }

  /* Status text inside each node follows same timing */
  .tnode-1 .tnode-status { animation: node-scan-status 8s ease-in-out infinite 0s; }
  .tnode-2 .tnode-status { animation: node-scan-status 8s ease-in-out infinite .6s; }
  .tnode-3 .tnode-status { animation: node-scan-status 8s ease-in-out infinite 1.2s; }
  .tnode-5 .tnode-status { animation: node-scan-status 8s ease-in-out infinite 2.4s; }
  .tnode-6 .tnode-status { animation: node-scan-status 8s ease-in-out infinite 3.0s; }
  .tnode-7 .tnode-status { animation: node-scan-status 8s ease-in-out infinite 3.6s; }
  .tnode-8 .tnode-status { animation: node-scan-status 8s ease-in-out infinite 4.2s; }
  .tnode-9 .tnode-status { animation: node-scan-status 8s ease-in-out infinite 4.8s; }

  /* Smaller nodes for level 4 children */
  .tnode-sm { width: 4.5rem !important; }
  .tnode-sm .tnode-emoji { font-size: 1rem; }
  .tnode-sm .tnode-label { font-size: .6rem; }

  /* Tree column (parent + connector + children as one vertical unit) */
  .tree-col { display: flex; flex-direction: column; align-items: center; }
  .tree-sub-level { display: flex; align-items: flex-start; }
  .tree-node-gap-sm { width: .75rem; }
  .tree-conn-tight { /* removed — replaced by tbranch */ }

  /* Connector lines between tree nodes */
  .tree-connectors {
    display: flex;
    justify-content: center;
    gap: 5rem;
    height: 1.6rem;
    position: relative;
    width: 100%;
  }
  .tree-conn-left, .tree-conn-right {
    width: 2px;
    height: 100%;
    background: var(--border);
  }

  /* ── Branching connector (inside tree-col, auto-aligns with sub-level) ── */
  .tbranch {
    position: relative;
    width: 100%;
    height: 1.8rem;
    flex-shrink: 0;
  }
  /* Vertical stem from parent down to bar */
  .tbranch::before {
    content: '';
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 2px; height: 50%;
    background: var(--border);
  }
  /* Horizontal bar */
  .tbranch::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 24%; right: 24%;
    height: 2px;
    background: var(--border);
  }
  /* Left drop */
  .tbranch-l {
    position: absolute;
    top: 50%; bottom: 0;
    left: 24%;
    transform: translateX(-50%);
    width: 2px;
    background: var(--border);
  }
  /* Right drop */
  .tbranch-r {
    position: absolute;
    top: 50%; bottom: 0;
    right: 24%;
    transform: translateX(50%);
    width: 2px;
    background: var(--border);
  }
  /* AppRoot has unequal children (Navbar narrow, Dashboard-col wide) — tune line positions */
  .tbranch-root::after { left: 9%; right: 34%; }
  .tbranch-root .tbranch-l { left: 9%; }
  .tbranch-root .tbranch-r { right: 34%; }

  /* Result bar */
  .tree-result-bar {
    display: flex;
    align-items: center;
    gap: 0;
    border-top: 2px solid var(--border);
    background: white;
    padding: .85rem 1.5rem;
    flex-wrap: wrap;
    gap: .5rem;
  }
  .tree-result-item {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .5rem .85rem;
    border-radius: var(--radius);
    flex-shrink: 0;
  }
  .tree-result-total   { background: #f1f5f9; }
  .tree-result-changed-item { background: var(--red-pale); }
  .tree-result-wasted-item  { background: #f8f9fa; }
  .tree-result-num {
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--ink);
    line-height: 1;
    font-family: var(--font-head);
  }
  .tree-result-num-red  { color: var(--red); }
  .tree-result-num-grey { color: var(--ink-light); }
  .tree-result-lbl { font-size: .65rem; font-weight: 700; color: var(--ink); line-height: 1.4; }
  .tree-result-divider { width: 1.5px; height: 2.2rem; background: var(--border); flex-shrink: 0; margin: 0 .25rem; }
  .tree-result-verdict {
    margin-left: auto;
    font-size: .72rem;
    font-weight: 700;
    color: var(--red);
    background: var(--red-pale);
    border: 1.5px solid #fca5a5;
    border-radius: var(--radius);
    padding: .35rem .75rem;
  }

  /* ══ Zone.js card + tree responsive ══ */
  @media (max-width: 600px) {
    .zonejs-flow { flex-direction: column; align-items: flex-start; }
    .tree-result-bar { flex-direction: column; align-items: flex-start; }
    .tree-result-verdict { margin-left: 0; }
    .tree-level-offset { margin-left: 3rem; }
    .tree-node-gap { width: 2rem; }
  }

  /* ══ Template output explanation card ══ */
  .tpl-explain-card {
    background: #f8faff;
    border: 2px solid #bfdbfe;
    border-radius: 16px;
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.1rem;
  }
  .tpl-explain-title {
    font-size: .82rem;
    font-weight: 900;
    color: var(--ink);
    margin-bottom: .85rem;
  }
  .tpl-explain-body { display: flex; flex-direction: column; gap: .75rem; }
  .tpl-step {
    display: flex;
    gap: .75rem;
    align-items: flex-start;
  }
  .tpl-step-num {
    width: 1.4rem; height: 1.4rem;
    border-radius: 50%;
    background: var(--blue);
    color: white;
    font-size: .65rem;
    font-weight: 900;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    margin-top: .1rem;
  }
  .tpl-step-text { font-size: .75rem; color: var(--ink); line-height: 1.6; font-weight: 600; }
  .tpl-step-text strong { color: var(--ink); }
  .tpl-code-block {
    font-family: var(--font-mono);
    font-size: .68rem;
    background: #1e293b;
    color: #e2e8f0;
    border-radius: 8px;
    padding: .55rem .85rem;
    margin: .45rem 0 .45rem;
    line-height: 1.7;
    white-space: pre;
    overflow-x: auto;
  }
  .tpl-compare {
    margin-top: .55rem;
    background: white;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: .65rem .85rem;
    display: flex;
    flex-direction: column;
    gap: .35rem;
  }
  .tpl-compare-row { display: flex; align-items: flex-start; gap: .65rem; }
  .tpl-compare-label { font-size: .6rem; font-weight: 800; color: var(--ink); min-width: 5rem; padding-top: .15rem; line-height: 1.4; }
  .tpl-compare-code {
    font-family: var(--font-mono);
    font-size: .68rem;
    background: #f1f5f9;
    border: 1.5px solid var(--border);
    border-radius: 6px;
    padding: .15rem .45rem;
    color: var(--ink);
  }
  .tpl-compare-code-red { background: var(--red-pale); border-color: #fca5a5; }
  .tpl-compare-result {
    font-size: .68rem;
    font-weight: 700;
    border-radius: 6px;
    padding: .25rem .6rem;
  }
  .tpl-compare-same    { background: var(--green-pale); color: var(--green-dark); }
  .tpl-compare-changed { background: var(--red-pale);   color: var(--red); }
  .tpl-explain-note {
    font-size: .7rem;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.6;
    border-left: 3px solid var(--blue);
    padding-left: .65rem;
  }

  /* ══ Zone.js vs Signal message comparison ══ */
  .msg-compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: start;
    margin-bottom: 1.25rem;
  }
  .msg-card {
    border-radius: 16px;
    border: 2.5px solid var(--border);
    padding: 1.1rem;
    background: var(--surface);
  }
  .msg-card-bad  { border-color: #fecaca; background: #fff8f8; }
  .msg-card-good { border-color: #bbf7d0; background: #f6fef0; }
  .msg-card-from {
    display: flex;
    align-items: center;
    gap: .4rem;
    font-size: .65rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: .65rem;
  }
  .msg-from-dot {
    width: .55rem; height: .55rem;
    border-radius: 50%; flex-shrink: 0;
  }
  .msg-from-dot-orange { background: var(--orange); }
  .msg-from-dot-green  { background: var(--green); }
  .msg-bubble {
    border-radius: 12px 12px 12px 2px;
    padding: .65rem .85rem;
    margin-bottom: .75rem;
  }
  .msg-bubble-orange { background: var(--orange-pale); border: 1.5px solid #fed7aa; }
  .msg-bubble-green  { background: var(--green-pale);  border: 1.5px solid #bbf7d0; }
  .msg-bubble-text { font-size: .78rem; font-weight: 700; color: var(--ink); line-height: 1.5; margin: 0; }
  .msg-missing {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: .3rem;
    margin-bottom: .75rem;
    font-size: .72rem;
    color: var(--ink);
    font-weight: 600;
  }
  .msg-x     { color: var(--red);        margin-right: .35rem; font-weight: 900; }
  .msg-check { color: var(--green-dark); margin-right: .35rem; font-weight: 900; }
  .msg-result {
    font-size: .7rem;
    font-weight: 800;
    border-radius: var(--radius);
    padding: .35rem .65rem;
    text-align: center;
  }
  .msg-result-bad  { background: var(--red-pale);  color: var(--red);        border: 1.5px solid #fca5a5; }
  .msg-result-good { background: var(--green-pale); color: var(--green-dark); border: 1.5px solid #86efac; }
  .msg-vs {
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; color: var(--ink-light); font-weight: 900;
    align-self: center; padding-top: 2rem;
  }

  /* ══ No early stop walk ══ */
  .no-stop-card {
    background: #fffbeb;
    border: 2px solid var(--yellow);
    border-radius: 16px;
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.1rem;
  }
  .no-stop-title {
    font-size: .82rem;
    font-weight: 900;
    color: var(--ink);
    margin-bottom: .6rem;
    letter-spacing: -.01em;
  }
  .no-stop-body { margin-bottom: .85rem; }
  .no-stop-walk {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    overflow: hidden;
  }
  .nsw-step {
    display: flex;
    align-items: center;
    gap: .55rem;
    font-size: .72rem;
    font-weight: 700;
    color: var(--ink);
    padding: .3rem .65rem;
    border-radius: var(--radius);
    background: white;
    border: 1.5px solid var(--border);
    width: 100%;
    flex-wrap: wrap;
  }
  .nsw-same    { }
  .nsw-changed { background: var(--red-pale); border-color: #fca5a5; color: var(--ink); }
  .nsw-arrow   { font-size: .75rem; color: var(--ink-light); padding-left: 1.5rem; line-height: 1.2; }
  .nsw-children {
    border-left: 2.5px solid var(--border);
    padding-left: .85rem;
    display: flex;
    flex-direction: column;
    gap: .3rem;
    padding-top: .3rem;
    padding-bottom: .3rem;
    width: 100%;
    box-sizing: border-box;
  }
  .nsw-tag {
    font-size: .6rem;
    font-weight: 800;
    border-radius: 6px;
    padding: .1rem .4rem;
    margin-left: auto;
  }
  .nsw-tag-grey { background: #f1f5f9; color: var(--ink); }
  .nsw-tag-red  { background: var(--red); color: white; }
  .nsw-keep { font-size: .62rem; font-weight: 800; color: var(--red); margin-left: .25rem; animation: nsw-blink 1.2s ease-in-out infinite; }
  @keyframes nsw-blink { 0%,100% { opacity: 1; } 50% { opacity: .35; } }

  /* ══ Silent assignment card ══ */
  .silent-card {
    background: white;
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 1.1rem 1.25rem;
  }
  .silent-title {
    font-size: .82rem;
    font-weight: 900;
    color: var(--ink);
    margin-bottom: .85rem;
    letter-spacing: -.01em;
  }
  .silent-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .9rem;
  }
  .silent-side {
    border-radius: 12px;
    padding: .85rem;
    border: 2px solid var(--border);
  }
  .silent-side-bad  { background: var(--red-pale);  border-color: #fca5a5; }
  .silent-side-good { background: var(--green-pale); border-color: #86efac; }
  .silent-side-label {
    font-size: .6rem;
    font-weight: 900;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: .45rem;
  }
  .silent-code {
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 700;
    color: var(--ink);
    background: white;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: .35rem .65rem;
    margin-bottom: .55rem;
  }
  .silent-code-green { border-color: #86efac; background: #f0fde4; color: var(--green-dark); }
  .silent-effect {
    display: flex;
    gap: .45rem;
    align-items: flex-start;
    font-size: .7rem;
    color: var(--ink);
    line-height: 1.55;
    font-weight: 600;
  }
  .silent-effect-icon { font-size: 1rem; flex-shrink: 0; }

  /* ── Code Anatomy Panel ── */
  .anatomy-panel { border-radius: var(--radius); border: var(--border-w) solid var(--border); overflow: hidden; }
  .anatomy-bad  { border-color: var(--red); }
  .anatomy-good { border-color: var(--green); }
  .anatomy-head { padding: .6rem 1rem; font-size: .68rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .anatomy-head-red   { background: var(--red-pale);   color: var(--red);        }
  .anatomy-head-green { background: var(--green-pale); color: var(--green-dark); }
  .anatomy-panel .code-wrap { border-radius: 0; border-left: none; border-right: none; }
  .anatomy-panel .code-body { border-radius: 0; }
  .anatomy-panel .code-bar  { border-radius: 0; }
  .anatomy-hl { border-radius: 3px; padding: 0 2px; }
  .anatomy-hl-red   { background: #ffd7d7; color: #c53030; }
  .anatomy-hl-green { background: var(--green-light); color: var(--green-dark); }
  .anat-n { display: inline-flex; align-items: center; justify-content: center; width: 1rem; height: 1rem; border-radius: 50%; background: var(--border); font-size: .55rem; font-weight: 900; color: var(--ink); margin-left: .35rem; vertical-align: middle; }
  .anatomy-notes { padding: .7rem 1rem; display: flex; flex-direction: column; gap: .4rem; }
  .anatomy-bad  .anatomy-notes { background: #fff8f8; }
  .anatomy-good .anatomy-notes { background: #f8fef2; }
  .anatomy-note { display: flex; align-items: flex-start; gap: .45rem; font-size: .78rem; line-height: 1.5; color: var(--ink); }
  .anat-badge { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 1.1rem; height: 1.1rem; border-radius: 50%; font-size: .58rem; font-weight: 900; margin-top: .1rem; }
  .anat-badge-red   { background: var(--red-pale);   color: var(--red);        }
  .anat-badge-green { background: var(--green-pale); color: var(--green-dark); }
  .anat-substeps { display: flex; flex-direction: column; gap: .35rem; margin-top: .45rem; padding-left: .2rem; }
  .anat-substep  { display: flex; align-items: flex-start; gap: .5rem; font-size: var(--text-caption); line-height: 1.55; }
  .anat-sub-num  { flex-shrink: 0; font-weight: 800; color: var(--green-dark); min-width: 1.1rem; }
  .anatomy-note-block { flex-direction: column; align-items: flex-start; gap: .3rem; }
  .anat-note-head { display: flex; align-items: center; gap: .5rem; }

  /* ── Signal trace steps ── */
  .sig-trace { display: flex; flex-direction: column; gap: .5rem; }
  .sig-trace-step { display: flex; align-items: flex-start; gap: .75rem; padding: .75rem 1rem; border-radius: var(--radius); border: 1.5px solid transparent; }
  .sig-step-blue  { background: #eff6ff; border-color: #bfdbfe; }
  .sig-step-green { background: var(--green-pale); border-color: var(--green); }
  .sig-trace-num { width: 1.6rem; height: 1.6rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .7rem; font-weight: 900; flex-shrink: 0; margin-top: .05rem; }
  .sig-num-blue  { background: #bfdbfe; color: #1d4ed8; }
  .sig-num-green { background: var(--green-light); color: var(--green-dark); }
  .sig-trace-body strong { font-size: .88rem; color: var(--ink); display: block; margin-bottom: .2rem; font-weight: 700; }
  .sig-trace-body p { font-size: var(--text-body); color: var(--ink); line-height: var(--lh-body); margin: 0; }

  /* ── Signal tree (static, targeted) ── */
  .sig-tree-wrap { border: 1.5px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; background: #fafafa; }
  .sig-tree-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: .75rem; flex-wrap: wrap; gap: .5rem; }
  .sig-tree-title { font-size: .72rem; font-weight: 700; color: var(--ink); letter-spacing: .05em; text-transform: uppercase; }
  .sig-tree-badge { font-size: .72rem; font-weight: 800; color: var(--green-dark); background: var(--green-pale); border: 1px solid var(--green); padding: .15rem .65rem; border-radius: 20px; }
  .sig-walk { display: flex; flex-direction: column; gap: .3rem; }
  .sig-node { display: flex; align-items: center; gap: .5rem; font-size: var(--text-body); font-weight: 700; padding: .3rem .5rem; border-radius: 6px; }
  .sig-node-idle   { color: var(--ink-light); }
  .sig-node-target { color: var(--ink); background: var(--green-pale); border: 1.5px solid var(--green); }
  .sig-tag { font-size: .68rem; font-weight: 600; padding: .12rem .45rem; border-radius: 20px; white-space: nowrap; }
  .sig-tag-grey  { background: #f3f4f6; color: var(--ink); }
  .sig-tag-green { background: var(--green-pale); color: var(--green-dark); border: 1px solid var(--green); }
  .sig-tag-blue  { background: var(--blue-pale);  color: #0369a1;           border: 1px solid var(--blue); }

  /* sig-node-input: @Input receiver (blue, not green watcher) */
  .sig-node-input {
    color: var(--ink);
    background: var(--blue-pale);
    border: 1.5px solid var(--blue);
    border-radius: var(--radius-sm);
    padding: .28rem .65rem;
    font-size: var(--text-body);
    font-weight: var(--fw-semi);
  }

  /* sig-step-red / sig-num-red: "never visited" step */
  .sig-trace-step.sig-step-red { background: var(--red-pale); border-left-color: var(--red); }
  .sig-trace-num.sig-num-red   { background: var(--red); color: #fff; }

  /* ── Notify-list flow (nl-flow) ── */
  .nl-flow { display: flex; flex-direction: column; gap: 0; }
  .nl-arrow { text-align: center; font-size: 1.1rem; color: var(--ink); line-height: 1; padding: .2rem 0; }
  .nl-state {
    display: flex;
    gap: .9rem;
    align-items: flex-start;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: .85rem 1rem;
    background: #fafafa;
  }
  .nl-state-grey   { background: #f9fafb; border-color: #d1d5db; }
  .nl-state-orange { background: #fff7ed; border-color: var(--orange,#f97316); }
  .nl-state-green  { background: var(--green-pale); border-color: var(--green); }
  .nl-step-num {
    flex-shrink: 0;
    width: 1.6rem; height: 1.6rem;
    border-radius: 50%;
    background: var(--ink-muted);
    color: #fff;
    font-size: .72rem;
    font-weight: 800;
    display: flex; align-items: center; justify-content: center;
  }
  .nl-state-orange .nl-step-num { background: var(--orange,#f97316); }
  .nl-state-green  .nl-step-num { background: var(--green-dark,#389e0d); }
  .nl-step-body { display: flex; flex-direction: column; gap: .35rem; }
  .nl-step-title { font-size: var(--text-body); font-weight: var(--fw-bold); color: var(--ink); }
  .nl-list { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
  .nl-list-label { font-size: var(--text-caption); font-weight: var(--fw-semi); color: var(--ink); }
  .nl-list-empty { font-size: var(--text-caption); font-style: italic; color: var(--ink); }
  .nl-list-item  { font-size: var(--text-caption); font-weight: var(--fw-semi); padding: .1rem .45rem; border-radius: 20px; }
  .nl-list-green { background: var(--green-pale); color: var(--green-dark); border: 1px solid var(--green); }
  .nl-caption { font-size: var(--text-caption); color: var(--ink); line-height: 1.55; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .app-shell { grid-template-columns: 1fr; }
    .tl-sidebar { display: none; }
    .content-pane { padding: 1rem; }
    .g2, .g3 { grid-template-columns: 1fr; }
    .s1-graphic { grid-template-columns: 1fr; }
    .s1-vs { display: none; }
  }
</style>

<script is:inline>
  const items  = document.querySelectorAll('.tl-item');
  const panels = document.querySelectorAll('.sec-panel');

  function activate(sid) {
    items.forEach(i  => i.classList.toggle('active',  i.dataset.target === sid));
    panels.forEach(p => p.classList.toggle('active',  p.dataset.sid    === sid));
    window.scrollTo({ top: document.querySelector('.app-shell').offsetTop - 72, behavior: 'smooth' });
  }

  items.forEach(item => item.addEventListener('click', () => activate(item.dataset.target)));
</script>

</body>
</html>
