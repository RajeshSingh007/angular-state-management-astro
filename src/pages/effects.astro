---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import EffectsPlayground from '../components/EffectsPlayground.tsx';
import ExcitementBanner from '../components/ExcitementBanner.astro';
import WhatYouWillLearn from '../components/WhatYouWillLearn.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
---
<MainLayout title="NgRx Effects — Angular State Management Visualizer"
  description="Learn NgRx Effects — handle HTTP calls, navigation, and other side effects outside the pure NgRx store/reducer flow with an interactive demo.">
  <Navbar active="/effects" step="Step 4 of 4" />
  <main id="main-content">

  <div class="pt-14">
    <div class="bg-gradient-to-r from-amber-500 to-orange-600 text-white px-4 py-14 text-center">
      <p class="text-amber-100 text-xs font-bold uppercase tracking-widest mb-3">Step 4 of 4 · NgRx Effects</p>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-4">🚚 NgRx Effects Playground</h1>
      <p class="text-amber-100 max-w-2xl mx-auto text-base">
        The "Delivery Guy" of NgRx. Effects handle everything OUTSIDE the store — HTTP calls, navigation, localStorage — and dispatch new actions when done.
      </p>
    </div>

    <div class="max-w-6xl mx-auto px-4 py-10 space-y-8">

      <WhatYouWillLearn color="amber" items={[
        'Why side effects (HTTP, navigation, localStorage) must live <strong>outside</strong> the pure reducer.',
        'How an Effect listens for specific Actions, performs async work, and dispatches a Success or Failure action.',
        'The full flow: <strong>Component → Action → Effect → HTTP → Success Action → Reducer → Store → UI</strong>.',
      ]} />

      <!-- Analogy grid -->
      <div class="grid md:grid-cols-2 gap-6 reveal">
        <div class="bg-amber-50 border-2 border-amber-400 rounded-2xl p-6">
          <h3 class="font-bold text-amber-800 text-base mb-3">🚚 The Delivery Guy Analogy</h3>
          <p class="text-sm text-gray-600 mb-3">The Chef (Reducer) <strong>never leaves the kitchen</strong>. They only work with what's already on the counter. If you need ingredients from outside — that is the Delivery Guy's job.</p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li>🧑‍💼 <strong>Customer orders pizza</strong> → dispatches <code class="bg-amber-100 px-1 rounded text-xs">loadProducts()</code></li>
            <li>🚚 <strong>Delivery Guy hears the order</strong> → Effect listens for this action</li>
            <li>🛒 <strong>Delivery Guy goes to the supplier</strong> → Effect calls the HTTP API</li>
            <li>✅ <strong>Delivery returns with goods</strong> → dispatches <code class="bg-amber-100 px-1 rounded text-xs">loadProductsSuccess()</code></li>
            <li>👨‍🍳 <strong>Chef processes the delivery</strong> → Reducer updates the store</li>
          </ul>
        </div>
        <div class="bg-orange-50 border-2 border-orange-400 rounded-2xl p-6">
          <h3 class="font-bold text-orange-800 text-base mb-3">🔄 The Effect Pipeline</h3>
          <div class="space-y-2 text-sm">
            {[
              ['1','Component', 'dispatches loadProducts()', 'bg-blue-100 text-blue-800'],
              ['2','Effect',    'listens via ofType(loadProducts)', 'bg-amber-100 text-amber-800'],
              ['3','Effect',    'calls http.get("/api/products")', 'bg-orange-100 text-orange-800'],
              ['4','Effect',    'success → dispatches loadProductsSuccess({ products })', 'bg-green-100 text-green-800'],
              ['4','Effect',    'failure → dispatches loadProductsFailure({ error })', 'bg-red-100 text-red-800'],
              ['5','Reducer',   'processes success/failure → updates store', 'bg-purple-100 text-purple-800'],
            ].map(([num, who, what, cls]) => (
              <div class={`${cls} rounded-lg px-3 py-2 flex items-start gap-2`}>
                <span class="font-bold text-xs mt-0.5 w-4 shrink-0">{num}.</span>
                <span><strong>{who}:</strong> {what}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Code snippet -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200 reveal">
        <h3 class="font-bold text-lg mb-4">📝 What an Effect looks like in code</h3>
        <pre class="bg-[#1a1a2e] text-green-400 p-4 rounded-xl text-xs font-mono leading-relaxed overflow-x-auto">{`@Injectable()
export class ProductEffects {

  loadProducts$ = createEffect(() =>
    this.actions$.pipe(
      ofType(loadProducts),          // 👂 Listen for this action
      switchMap(() =>
        this.http.get<Product[]>('/api/products').pipe(
          map(products =>
            loadProductsSuccess({ products })  // ✅ Dispatch success
          ),
          catchError(error =>
            of(loadProductsFailure({ error })) // ❌ Dispatch failure
          )
        )
      )
    )
  );

  constructor(
    private actions$: Actions,
    private http: HttpClient
  ) {}
}`}</pre>
        <p class="mt-3 text-xs text-gray-500">
          💡 <strong>Key rule:</strong> Effects must <em>never throw</em> — always catch errors and dispatch a failure action so the store stays consistent.
        </p>
      </div>

      <ExcitementBanner
        gradient="linear-gradient(90deg, #d97706, #ea580c)"
        title="Now watch it all come alive 🚀"
        subtitle="Click Load Products — watch the Effect trigger an async HTTP call, and see the Reducer process the result into the store."
        pills={['🎬 Action dispatched','🚚 Effect intercepts','🌐 HTTP call (mock)','✅/❌ Success or Failure','📦 Reducer updates store']}
      />

      <EffectsPlayground client:load />

      <KeyTakeaways color="amber" points={[
        '<strong>Effects are the only place</strong> in NgRx where async operations (HTTP, localStorage, navigation) should live — the Reducer must remain a pure, synchronous function.',
        'An Effect always dispatches a new action when done: <code class="bg-amber-100 px-1 rounded text-xs">loadProductsSuccess()</code> or <code class="bg-amber-100 px-1 rounded text-xs">loadProductsFailure()</code>. The Reducer then handles these in its switch statement.',
        'Effects are <strong>observable streams</strong> — they use RxJS operators like <code class="bg-amber-100 px-1 rounded text-xs">switchMap</code>, <code class="bg-amber-100 px-1 rounded text-xs">mergeMap</code>, and <code class="bg-amber-100 px-1 rounded text-xs">catchError</code> to handle async logic cleanly.',
      ]} />


    </div>
  </div>
  </main>
  <Footer />
</MainLayout>
