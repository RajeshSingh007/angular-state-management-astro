                &nbsp;&nbsp;<span class="st">`</span>,<br/>
                &#125;)<br/>
                <span class="ky">export class</span> <span class="fn">HelloComponent</span> &#123;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// 🧩 blueprint — Angular calls new HelloComponent() from this</span><br/>
                <br/>
                &nbsp;&nbsp;<span class="cm">// 🧩 These define WHAT the Component Object will contain when Angular creates it:</span><br/>
                &nbsp;&nbsp;<span class="hi">name</span>     = <span class="st">'World'</span>;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// → fills &#123;&#123; name &#125;&#125; in the template</span><br/>
                &nbsp;&nbsp;<span class="hi">platform</span> = <span class="st">''</span>;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// → set to 'Server' or 'Browser'</span><br/>
                <br/>
                &nbsp;&nbsp;<span class="ky">constructor</span>(<span class="ky">private</span> <span class="hi">platformId</span> = <span class="fn">inject</span>(<span class="hi">PLATFORM_ID</span>)) &#123;&#125;<br/>
                <br/>
                &nbsp;&nbsp;<span class="cm">// 🧩 Lifecycle hook — runs when the component object is created:</span><br/>
                &nbsp;&nbsp;<span class="fn">ngOnInit</span>() &#123;<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">this</span>.<span class="hi">platform</span> = <span class="fn">isPlatformBrowser</span>(<span class="hi">this</span>.<span class="hi">platformId</span>)<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;? <span class="st">'Browser'</span>&nbsp;&nbsp;<span class="cm">// ← browser component object runs THIS branch</span><br/>
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: <span class="st">'Server'</span>;&nbsp;&nbsp;<span class="cm">// ← server component object runs THIS branch</span><br/>
                &nbsp;&nbsp;&#125;<br/>
                &#125;
              </div>
            </div>

            <!-- ── Part C: Three-Phase Lifecycle ── -->
            <div style="margin-bottom:2rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">The Three-Phase Journey</p>
              <div style="display:flex;flex-direction:column;gap:1rem;">

                <!-- Phase 1 -->
                <div style="background:var(--dark-2);border:1px solid #2a2b3d;border-left:3px solid var(--orange);border-radius:.75rem;overflow:hidden;">
                  <div style="padding:1rem 1.25rem 0.2rem;background:var(--surface);">
                    <div style="display:flex;align-items:center;gap:.65rem;margin-bottom:.85rem;">
                      <span style="background:var(--orange);color:white;font-size:.62rem;font-weight:900;padding:.2rem .6rem;border-radius:99px;letter-spacing:.06em;white-space:nowrap;">PHASE 1</span>
                      <span style="font-size:.85rem;">🖥️</span>
                      <p style="font-size:.78rem;font-weight:800;color:var(--ink-1);">Server — Component Object born, HTML String produced</p>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem;">
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(249,115,22,.15);border:1px solid rgba(249,115,22,.4);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:#ea580c;flex-shrink:0;margin-top:.05rem;">1</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;">Angular calls <code style="color:#9a3412;font-size:.67rem;font-family:monospace;background:rgba(234,88,12,.08);padding:.1rem .3rem;border-radius:.25rem;">new HelloComponent()</code> on the server — a <strong style="color:var(--ink-1);">Component Object</strong> is created in Node.js heap memory</p>
                      </div>
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(249,115,22,.15);border:1px solid rgba(249,115,22,.4);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:#ea580c;flex-shrink:0;margin-top:.05rem;">2</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;"><code style="color:#9a3412;font-size:.67rem;font-family:monospace;background:rgba(234,88,12,.08);padding:.1rem .3rem;border-radius:.25rem;">ngOnInit()</code> runs on the component object — sets <code style="color:#9a3412;font-size:.67rem;font-family:monospace;background:rgba(234,88,12,.08);padding:.1rem .3rem;border-radius:.25rem;">platform = "Server"</code></p>
                      </div>
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(37,99,235,.12);border:1px solid rgba(37,99,235,.3);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:var(--blue);flex-shrink:0;margin-top:.05rem;">3</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;">Angular evaluates the template: <code style="color:#1e40af;font-size:.67rem;font-family:monospace;background:rgba(37,99,235,.08);padding:.1rem .3rem;border-radius:.25rem;">&#123;&#123; name &#125;&#125;</code> → <code style="color:#1e40af;font-size:.67rem;font-family:monospace;background:rgba(37,99,235,.08);padding:.1rem .3rem;border-radius:.25rem;">"World"</code>, <code style="color:#1e40af;font-size:.67rem;font-family:monospace;background:rgba(37,99,235,.08);padding:.1rem .3rem;border-radius:.25rem;">&#123;&#123; platform &#125;&#125;</code> → <code style="color:#1e40af;font-size:.67rem;font-family:monospace;background:rgba(37,99,235,.08);padding:.1rem .3rem;border-radius:.25rem;">"Server"</code></p>
                      </div>
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(37,99,235,.12);border:1px solid rgba(37,99,235,.3);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:var(--blue);flex-shrink:0;margin-top:.05rem;">4</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;">Template result is serialised into an <strong style="color:var(--ink-1);">HTML String</strong> and sent to the browser inside the HTTP response body</p>
                      </div>
                    </div>
                  </div>
                  <div class="code-header" style="border-radius:0;border-left:none;border-right:none;">
                    <div class="code-dots">
                      <div class="code-dot" style="background:#ff5f57;"></div>
                      <div class="code-dot" style="background:#febc2e;"></div>
                      <div class="code-dot" style="background:#28c840;"></div>
                    </div>
                    <span class="code-filename">HTTP response body — what the server sends</span>
                  </div>
                  <div class="code-block" style="border-radius:0 0 .75rem .75rem;font-size:.68rem;border-top:none;">
                    <span class="cm">// Angular ran HelloComponent on the server and produced this HTML string:</span><br/>
                    <span class="ok">&lt;<span class="ky">app-hello</span>&gt;</span><br/>
                    &nbsp;&nbsp;<span class="ok">&lt;<span class="ky">h1</span>&gt;</span><span class="st">Hello, World!</span><span class="ok">&lt;/<span class="ky">h1</span>&gt;</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// ← HTML string, just text</span><br/>
                    &nbsp;&nbsp;<span class="ok">&lt;<span class="ky">p</span>&gt;</span><span class="st">Running on: Server</span><span class="ok">&lt;/<span class="ky">p</span>&gt;</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// ← HTML string, just text</span><br/>
                    <span class="ok">&lt;/<span class="ky">app-hello</span>&gt;</span><br/>
                    <span class="ok">&lt;<span class="ky">script</span> id=<span class="st">"ng-state"</span>&gt;</span>&#123;<span class="st">"node:0"</span>:<span class="st">"HelloComponent"</span>&#125;<span class="ok">&lt;/<span class="ky">script</span>&gt;</span>&nbsp;<span class="cm">// ← simplified: real ng-state stores Transfer Cache data</span>
                  </div>
                </div>

                <!-- Phase 2 -->
                <div style="background:var(--surface);border:1px solid rgba(37,99,235,.2);border-left:3px solid var(--blue);border-radius:.75rem;overflow:hidden;">
                  <div style="padding:1rem 1.25rem 0;">
                    <div style="display:flex;align-items:center;gap:.65rem;margin-bottom:.85rem;">
                      <span style="background:var(--blue);color:white;font-size:.62rem;font-weight:900;padding:.2rem .6rem;border-radius:99px;letter-spacing:.06em;white-space:nowrap;">PHASE 2</span>
                      <span style="font-size:.85rem;">🌐</span>
                      <p style="font-size:.78rem;font-weight:800;color:var(--ink-1);">Browser — HTML String parsed into DOM Nodes</p>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem;">
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(37,99,235,.12);border:1px solid rgba(37,99,235,.3);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:var(--blue);flex-shrink:0;margin-top:.05rem;">1</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;">Browser receives the raw HTML String from the server — it is <strong style="color:var(--ink-1);">just text bytes</strong>, no Angular logic inside</p>
                      </div>
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(37,99,235,.12);border:1px solid rgba(37,99,235,.3);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:var(--blue);flex-shrink:0;margin-top:.05rem;">2</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;">The browser HTML parser reads the string character-by-character and builds a tree of <strong style="color:var(--ink-1);">DOM Nodes</strong> in memory — one live object per element</p>
                      </div>
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(251,191,36,.15);border:1px solid rgba(251,191,36,.4);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:#d97706;flex-shrink:0;margin-top:.05rem;">3</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;"><strong style="color:var(--ink-1);">Content is immediately visible on screen</strong> — but Angular hasn't started yet. Zero event listeners. Zero change detection. A beautiful, completely static snapshot.</p>
                      </div>
                    </div>
                  </div>
                  <div class="code-header" style="border-radius:0;border-left:none;border-right:none;">
                    <div class="code-dots">
                      <div class="code-dot" style="background:#ff5f57;"></div>
                      <div class="code-dot" style="background:#febc2e;"></div>
                      <div class="code-dot" style="background:#28c840;"></div>
                    </div>
                    <span class="code-filename">What exists in the browser at this moment (DevTools console)</span>
                  </div>
                  <div class="code-block" style="border-radius:0 0 .75rem .75rem;font-size:.68rem;border-top:none;">
                    <span class="cm">// HTML String → DOM Node objects created by the browser parser:</span><br/>
                    <span class="fn">document</span>.<span class="hi">querySelector</span>(<span class="st">'h1'</span>).<span class="hi">textContent</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// → "Hello, World!"   ✅ visible on screen</span><br/>
                    <span class="fn">document</span>.<span class="hi">querySelector</span>(<span class="st">'h1'</span>).<span class="hi">onclick</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// → null              ❌ no Angular yet</span><br/>
                    <span class="fn">document</span>.<span class="hi">querySelector</span>(<span class="st">'h1'</span>).<span class="hi">__ngContext__</span>&nbsp;&nbsp;&nbsp;<span class="cm">// → undefined         ❌ no Angular yet</span>
                  </div>
                </div>

                <!-- Phase 3 -->
                <div style="background:rgba(13,148,136,.04);border:1px solid rgba(13,148,136,.25);border-left:3px solid var(--teal);border-radius:.75rem;overflow:hidden;">
                  <div style="padding:1rem 1.25rem 0;">
                    <div style="display:flex;align-items:center;gap:.65rem;margin-bottom:.85rem;">
                      <span style="background:var(--teal);color:white;font-size:.62rem;font-weight:900;padding:.2rem .6rem;border-radius:99px;letter-spacing:.06em;white-space:nowrap;">PHASE 3</span>
                      <span style="font-size:.85rem;">⚡</span>
                      <p style="font-size:.78rem;font-weight:800;color:var(--ink-1);">Angular Boots — Component Object meets DOM Node</p>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem;">
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(13,148,136,.12);border:1px solid rgba(13,148,136,.3);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:var(--teal);flex-shrink:0;margin-top:.05rem;">1</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;">Angular's JavaScript bundle finishes downloading and starts executing in the browser</p>
                      </div>
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(234,88,12,.12);border:1px solid rgba(234,88,12,.3);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:var(--orange);flex-shrink:0;margin-top:.05rem;">2</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;">Angular creates a <strong style="color:var(--ink-1);">new HelloComponent instance</strong> — a brand new Component Object, this time in browser heap memory</p>
                      </div>
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(234,88,12,.12);border:1px solid rgba(234,88,12,.3);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:var(--orange);flex-shrink:0;margin-top:.05rem;">3</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;"><code style="font-size:.67rem;font-family:monospace;background:rgba(0,0,0,.05);padding:.1rem .3rem;border-radius:.25rem;">ngOnInit()</code> runs again — now in the browser, so <code style="font-size:.67rem;font-family:monospace;background:rgba(0,0,0,.05);padding:.1rem .3rem;border-radius:.25rem;">platform = "Browser"</code> is set</p>
                      </div>
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(13,148,136,.12);border:1px solid rgba(13,148,136,.3);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:var(--teal);flex-shrink:0;margin-top:.05rem;">4</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;">Hydration: Angular reads the <code style="font-size:.67rem;font-family:monospace;background:rgba(0,0,0,.05);padding:.1rem .3rem;border-radius:.25rem;">ng-state</code> map and <strong style="color:var(--ink-1);">connects</strong> the Component Object to the existing <code style="font-size:.67rem;font-family:monospace;background:rgba(0,0,0,.05);padding:.1rem .3rem;border-radius:.25rem;">&lt;h1&gt;</code> DOM Node — no DOM recreation, no flicker</p>
                      </div>
                      <div style="display:flex;gap:.6rem;align-items:flex-start;">
                        <span style="min-width:1.3rem;height:1.3rem;border-radius:50%;background:rgba(22,163,74,.12);border:1px solid rgba(22,163,74,.3);display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:900;color:var(--green);flex-shrink:0;margin-top:.05rem;">5</span>
                        <p style="font-size:.71rem;color:var(--ink-2);line-height:1.65;">Event handlers are attached to the DOM Nodes. Change detection is wired up. The static page is now a <strong style="color:var(--ink-1);">live Angular app</strong></p>
                      </div>
                    </div>
                  </div>
                  <div class="code-header" style="border-radius:0;border-left:none;border-right:none;">
                    <div class="code-dots">
                      <div class="code-dot" style="background:#ff5f57;"></div>
                      <div class="code-dot" style="background:#febc2e;"></div>
                      <div class="code-dot" style="background:#28c840;"></div>
                    </div>
                    <span class="code-filename">After hydration completes (DevTools console)</span>
                  </div>
                  <div class="code-block" style="border-radius:0 0 .75rem .75rem;font-size:.68rem;border-top:none;">
                    <span class="cm">// Same DOM Node — not recreated, no flicker:</span><br/>
                    <span class="fn">document</span>.<span class="hi">querySelector</span>(<span class="st">'h1'</span>).<span class="hi">textContent</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// → "Hello, World!"   ✅ still visible</span><br/>
                    <span class="fn">document</span>.<span class="hi">querySelector</span>(<span class="st">'h1'</span>).<span class="hi">onclick</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// → [handler]         ✅ Angular wired it</span><br/>
                    <span class="fn">document</span>.<span class="hi">querySelector</span>(<span class="st">'h1'</span>).<span class="hi">__ngContext__</span>&nbsp;&nbsp;&nbsp;<span class="cm">// → HelloComponent     ✅ component attached</span><br/>
                    <br/>
                    <span class="cm">// Component Object is a separate thing in Angular's memory:</span><br/>
                    <span class="cm">// comp.name     → "World"    (property on the class instance)</span><br/>
                    <span class="cm">// comp.platform → "Browser"  (ngOnInit ran again, this time in the browser)</span><br/>
                    <br/>
                    <span class="cm">// Change detection is live. Mutate the property → DOM updates instantly:</span><br/>
                    <span class="hi">comp</span>.name = <span class="st">'Angular'</span>;&nbsp;&nbsp;&nbsp;<span class="cm">// → &lt;h1&gt; DOM Node updates: "Hello, Angular!" ✅</span>
                  </div>
                </div>

              </div>
            </div>

            <!-- ── Part D: Full Pipeline ── -->
            <div style="margin-bottom:1.5rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">The Full Journey — One Component, Three Transformations</p>
              <div style="background:var(--dark);border:1px solid #2a2b3d;border-radius:.85rem;padding:1.5rem 1.25rem;overflow-x:auto;">
                <div style="display:flex;align-items:stretch;min-width:38rem;">

                  <div style="display:flex;flex-direction:column;align-items:center;flex:1;text-align:center;">
                    <div style="background:rgba(234,88,12,.15);border:1px solid rgba(234,88,12,.4);border-radius:.6rem;padding:.75rem .5rem;width:100%;margin-bottom:.4rem;">
                      <div style="font-size:1rem;margin-bottom:.3rem;">📝</div>
                      <p style="font-size:.62rem;font-weight:800;color:#fdba74;margin-bottom:.2rem;">TS Class</p>
                      <p style="font-size:.55rem;color:rgba(255,255,255,.45);line-height:1.4;">HelloComponent<br/>class definition</p>
                    </div>
                    <p style="font-size:.55rem;color:rgba(255,255,255,.3);">The blueprint</p>
                  </div>

                  <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 .5rem;flex-shrink:0;padding-bottom:1.2rem;">
                    <p style="font-size:.52rem;color:rgba(255,255,255,.3);margin-bottom:.15rem;">Server</p>
                    <p style="font-size:1.2rem;color:var(--orange);line-height:1;">→</p>
                    <p style="font-size:.52rem;color:rgba(255,255,255,.3);margin-top:.15rem;">instantiates</p>
                  </div>

                  <div style="display:flex;flex-direction:column;align-items:center;flex:1;text-align:center;">
                    <div style="background:rgba(234,88,12,.15);border:1px solid rgba(234,88,12,.4);border-radius:.6rem;padding:.75rem .5rem;width:100%;margin-bottom:.4rem;">
                      <div style="font-size:1rem;margin-bottom:.3rem;">🧩</div>
                      <p style="font-size:.62rem;font-weight:800;color:#fdba74;margin-bottom:.2rem;">Comp Object</p>
                      <p style="font-size:.55rem;color:rgba(255,255,255,.45);line-height:1.4;">name="World"<br/>platform="Server"</p>
                    </div>
                    <p style="font-size:.55rem;color:rgba(255,255,255,.3);">Server memory</p>
                  </div>

                  <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 .5rem;flex-shrink:0;padding-bottom:1.2rem;">
                    <p style="font-size:.52rem;color:rgba(255,255,255,.3);margin-bottom:.15rem;">template</p>
                    <p style="font-size:1.2rem;color:var(--blue);line-height:1;">→</p>
                    <p style="font-size:.52rem;color:rgba(255,255,255,.3);margin-top:.15rem;">evaluated</p>
                  </div>

                  <div style="display:flex;flex-direction:column;align-items:center;flex:1;text-align:center;">
                    <div style="background:rgba(37,99,235,.15);border:1px solid rgba(37,99,235,.4);border-radius:.6rem;padding:.75rem .5rem;width:100%;margin-bottom:.4rem;">
                      <div style="font-size:1rem;margin-bottom:.3rem;">📄</div>
                      <p style="font-size:.62rem;font-weight:800;color:#93c5fd;margin-bottom:.2rem;">HTML String</p>
                      <p style="font-size:.55rem;color:rgba(255,255,255,.45);line-height:1.4;">&lt;h1&gt;Hello!&lt;/h1&gt;<br/>(text bytes)</p>
                    </div>
                    <p style="font-size:.55rem;color:rgba(255,255,255,.3);">HTTP response</p>
                  </div>

                  <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 .5rem;flex-shrink:0;padding-bottom:1.2rem;">
                    <p style="font-size:.52rem;color:rgba(255,255,255,.3);margin-bottom:.15rem;">browser</p>
                    <p style="font-size:1.2rem;color:var(--blue);line-height:1;">→</p>
                    <p style="font-size:.52rem;color:rgba(255,255,255,.3);margin-top:.15rem;">parses</p>
                  </div>

                  <div style="display:flex;flex-direction:column;align-items:center;flex:1;text-align:center;">
                    <div style="background:rgba(22,163,74,.15);border:1px solid rgba(22,163,74,.4);border-radius:.6rem;padding:.75rem .5rem;width:100%;margin-bottom:.4rem;">
                      <div style="font-size:1rem;margin-bottom:.3rem;">🌳</div>
                      <p style="font-size:.62rem;font-weight:800;color:#86efac;margin-bottom:.2rem;">DOM Nodes</p>
                      <p style="font-size:.55rem;color:rgba(255,255,255,.45);line-height:1.4;">HTMLHeadingElement<br/>(visible, static)</p>
                    </div>
                    <p style="font-size:.55rem;color:rgba(255,255,255,.3);">Visible, no Angular</p>
                  </div>

                  <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 .5rem;flex-shrink:0;padding-bottom:1.2rem;">
                    <p style="font-size:.52rem;color:rgba(255,255,255,.3);margin-bottom:.15rem;">Angular</p>
                    <p style="font-size:1.2rem;color:#5eead4;line-height:1;">→</p>
                    <p style="font-size:.52rem;color:rgba(255,255,255,.3);margin-top:.15rem;">hydrates</p>
                  </div>

                  <div style="display:flex;flex-direction:column;align-items:center;flex:1.2;text-align:center;">
                    <div style="background:rgba(13,148,136,.2);border:2px solid rgba(13,148,136,.55);border-radius:.6rem;padding:.75rem .5rem;width:100%;margin-bottom:.4rem;">
                      <div style="font-size:1rem;margin-bottom:.3rem;">⚡</div>
                      <p style="font-size:.62rem;font-weight:800;color:#5eead4;margin-bottom:.2rem;">Wired Up</p>
                      <p style="font-size:.55rem;color:rgba(255,255,255,.55);line-height:1.4;">Comp Object +<br/>DOM Node linked</p>
                    </div>
                    <p style="font-size:.55rem;color:#5eead4;font-weight:700;">Visible + Interactive</p>
                  </div>

                </div>
              </div>
            </div>

            <!-- ── Closing callout ── -->
            <div class="callout callout-teal">
              <p class="callout-title" style="color:#0f766e;">The key insight: Component Object and DOM Node are always two separate things</p>
              <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;">
                Angular always maintains two separate things: a <strong style="color:var(--ink-1);">component object</strong> in JavaScript memory
                (your <code>HelloComponent</code> instance with <code>name</code> and <code>ngOnInit</code>)
                and a <strong style="color:var(--ink-1);">DOM node</strong> in the browser's tree
                (the actual <code>&lt;h1&gt;</code> element the user sees).
                <strong style="color:var(--ink-1);">Hydration is the act of connecting those two things</strong> —
                so that when the component object's property changes, the DOM node updates.
                Without that connection, you have a class instance that does nothing, and a DOM node that never changes.
              </p>
            </div>
          </section>

          <hr class="divider" />

          <!-- ── 07 Server Routing ── -->
          <section id="server-routing" class="section reveal">
            <p class="eyebrow">07 · Server Routing</p>
            <h2 class="sec-title">The Problem with Treating Every Route the Same</h2>
            <p class="sec-lead">
              When Angular SSR is on, the server runs Angular and builds HTML for every request —
              no matter which page is being asked for. That sounds fine until you realise
              your app has pages that are fundamentally different from each other.
            </p>

            <!-- ── THE PROBLEM — Restaurant analogy ── -->
            <div style="margin-bottom:1.75rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">
                The Problem — A Restaurant Analogy
              </p>

              <div class="card card-warn" style="margin-bottom:1rem;">
                <p style="font-size:.8rem;font-weight:800;color:var(--ink-1);margin-bottom:.75rem;">🍽️ Imagine your restaurant has 3 items on the menu</p>
                <div style="display:flex;flex-direction:column;gap:.6rem;">
                  <div style="display:flex;gap:.75rem;align-items:flex-start;">
                    <span style="font-size:.8rem;flex-shrink:0;">💧</span>
                    <p style="font-size:.75rem;color:var(--ink-2);line-height:1.65;">
                      <strong style="color:var(--ink-1);">Packaged water</strong> — same for every customer, never changes.
                      You can stock 1000 bottles in the morning and hand them out all day.
                      There is zero reason to "prepare" a new bottle for each customer.
                    </p>
                  </div>
                  <div style="display:flex;gap:.75rem;align-items:flex-start;">
                    <span style="font-size:.8rem;flex-shrink:0;">🍲</span>
                    <p style="font-size:.75rem;color:var(--ink-2);line-height:1.65;">
                      <strong style="color:var(--ink-1);">Today's special</strong> — same for all customers today, but changes daily.
                      Cook a big batch in the morning, keep it warm, serve all day. Throw away at night.
                    </p>
                  </div>
                  <div style="display:flex;gap:.75rem;align-items:flex-start;">
                    <span style="font-size:.8rem;flex-shrink:0;">🎂</span>
                    <p style="font-size:.75rem;color:var(--ink-2);line-height:1.65;">
                      <strong style="color:var(--ink-1);">Custom birthday cake</strong> — completely unique per customer, made fresh only when ordered.
                      You cannot prepare this in advance. It must be made on-demand.
                    </p>
                  </div>
                </div>
              </div>

              <div class="callout callout-red" style="margin-bottom:1rem;">
                <p class="callout-title" style="color:#9b1c1c;">Now imagine your kitchen has ONE rule for everything:</p>
                <p style="font-size:.78rem;color:var(--ink-2);line-height:1.7;">
                  <strong style="color:var(--ink-1);">"Cook everything fresh, to order, for every customer, every time."</strong><br/>
                  The water? You open a new bottle for every person — wasted effort.
                  The special? You cook it fresh each time — also wasted.
                  The cake? Correct — but only by accident.
                  <strong style="color:var(--red);">One kitchen rule applied to everything = two out of three are wrong.</strong>
                </p>
              </div>

              <div class="callout callout-teal">
                <p class="callout-title" style="color:#0f766e;">This is exactly what Angular SSR does by default</p>
                <p style="font-size:.78rem;color:var(--ink-2);line-height:1.7;">
                  <strong style="color:var(--ink-1);">/home</strong> = packaged water. Same HTML for every user. But SSR rebuilds it fresh on every request anyway — wasted.<br/>
                  <strong style="color:var(--ink-1);">/products/123</strong> = today's special. Changes daily but same for all users. Could be cached, but SSR rebuilds it every time.<br/>
                  <strong style="color:var(--ink-1);">/dashboard</strong> = birthday cake. Unique per user. Must be fresh. SSR handles this correctly — but only by accident.
                </p>
              </div>
            </div>

            <!-- ── WHAT IS SERVER ROUTING ── -->
            <div style="margin-bottom:1.75rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">
                The Solution — Give Each Route Its Own Rule
              </p>

              <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem;">

                <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                  <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#fef2f2;border:1px solid #fecaca;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--red);flex-shrink:0;">1</div>
                  <div>
                    <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;">Before SSR — the server was completely blind to routes</p>
                    <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">
                      In a normal Angular app there is no real server. Every URL — <code>/home</code>, <code>/dashboard</code>,
                      <code>/products/123</code> — returns the exact same empty <code>index.html</code> + JS bundle.
                      Angular boots in the browser and figures out which page to show.
                      The server has no idea what route was requested.
                    </p>
                  </div>
                </div>

                <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                  <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#fff7ed;border:1px solid #fed7aa;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--orange);flex-shrink:0;">2</div>
                  <div>
                    <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;">With SSR — the server finally understands which route is being requested</p>
                    <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">
                      Now Angular runs on the server. The server knows whether you hit <code>/home</code>
                      or <code>/dashboard</code>. It runs the right component, fetches the right data,
                      and sends back a fully-built HTML page. But by default, it does this the same way
                      for every route — fresh render, every time, no exceptions.
                    </p>
                  </div>
                </div>

                <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                  <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#f0fdf8;border:1px solid #bbf7d0;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--green);flex-shrink:0;">3</div>
                  <div>
                    <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;">Server Routing — a new file where you write per-route instructions</p>
                    <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">
                      Angular 17+ introduced <code>app.routes.server.ts</code> — a separate file that sits
                      alongside your existing <code>app.routes.ts</code>.
                      Your existing routes are untouched. This file only adds server-side behaviour on top:
                      <em>"for <code>/home</code>, build it once at deploy — never touch it again."</em>
                      <em>"for <code>/dashboard</code>, render fresh every time, never cache."</em>
                      <em>"for <code>/old-page</code>, send a 301 redirect."</em>
                    </p>
                  </div>
                </div>

              </div>
            </div>

            <!-- ── 3 Route Types ── -->
            <div style="margin-bottom:1.75rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">
                Your App's Routes Fall Into 3 Types
              </p>
              <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.85rem;margin-bottom:1rem;">
                <div style="background:var(--surface);border:1px solid var(--grid);border-left:3px solid var(--green);border-radius:.75rem;padding:1.1rem;">
                  <div style="font-size:1.4rem;margin-bottom:.45rem;">💧</div>
                  <p style="font-size:.78rem;font-weight:800;color:var(--ink-1);margin-bottom:.2rem;">/home, /about</p>
                  <p style="font-size:.65rem;font-weight:700;color:var(--green);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.4rem;">Prerender — build once</p>
                  <p style="font-size:.72rem;color:var(--ink-2);line-height:1.65;">
                    Never changes. Same HTML for every user. Build at deploy time, serve as a static file forever. Zero server cost per request.
                  </p>
                </div>
                <div style="background:var(--surface);border:1px solid var(--grid);border-left:3px solid var(--blue);border-radius:.75rem;padding:1.1rem;">
                  <div style="font-size:1.4rem;margin-bottom:.45rem;">🛍️</div>
                  <p style="font-size:.78rem;font-weight:800;color:var(--ink-1);margin-bottom:.2rem;">/products/:id</p>
                  <p style="font-size:.65rem;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.4rem;">Server + Cache</p>
                  <p style="font-size:.72rem;color:var(--ink-2);line-height:1.65;">
                    Changes when stock or price changes — same for all users. Server-render once, cache for an hour, serve many users from that cache.
                  </p>
                </div>
                <div style="background:var(--surface);border:1px solid var(--grid);border-left:3px solid var(--red);border-radius:.75rem;padding:1.1rem;">
                  <div style="font-size:1.4rem;margin-bottom:.45rem;">👤</div>
                  <p style="font-size:.78rem;font-weight:800;color:var(--ink-1);margin-bottom:.2rem;">/dashboard</p>
                  <p style="font-size:.65rem;font-weight:700;color:var(--red);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.4rem;">Server — never cache</p>
                  <p style="font-size:.72rem;color:var(--ink-2);line-height:1.65;">
                    Unique per user, changes in real time. Must render fresh on the server for every single request. Caching would show User A's data to User B.
                  </p>
                </div>
              </div>
            </div>

            <!-- ── Prerender vs Server+Cache ── -->
            <div style="margin-bottom:1.75rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">
                Prerender vs Server + Cache — What Actually Happens
              </p>

              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">

                <div style="background:var(--surface);border:1px solid var(--grid);border-left:3px solid var(--green);border-radius:.75rem;padding:1.1rem;">
                  <p style="font-size:.72rem;font-weight:800;color:var(--green);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.6rem;">💧 Prerender — /home, /about</p>
                  <div style="display:flex;flex-direction:column;gap:.4rem;">
                    <div style="display:flex;gap:.5rem;font-size:.72rem;color:var(--ink-2);line-height:1.5;">
                      <span style="color:var(--green);font-weight:700;flex-shrink:0;">①</span>
                      <span>At <strong style="color:var(--ink-1);">deploy time</strong>, Angular builds the HTML once for this page</span>
                    </div>
                    <div style="display:flex;gap:.5rem;font-size:.72rem;color:var(--ink-2);line-height:1.5;">
                      <span style="color:var(--green);font-weight:700;flex-shrink:0;">②</span>
                      <span>That HTML is saved as a <strong style="color:var(--ink-1);">static file</strong> on the server</span>
                    </div>
                    <div style="display:flex;gap:.5rem;font-size:.72rem;color:var(--ink-2);line-height:1.5;">
                      <span style="color:var(--green);font-weight:700;flex-shrink:0;">③</span>
                      <span>User 1, User 50, User 100 — all get <strong style="color:var(--ink-1);">that exact same file</strong>. Server never runs Angular again</span>
                    </div>
                    <div style="display:flex;gap:.5rem;font-size:.72rem;color:var(--ink-2);line-height:1.5;">
                      <span style="color:var(--green);font-weight:700;flex-shrink:0;">④</span>
                      <span>Page only changes when you <strong style="color:var(--ink-1);">deploy again</strong></span>
                    </div>
                  </div>
                </div>

                <div style="background:var(--surface);border:1px solid var(--grid);border-left:3px solid var(--blue);border-radius:.75rem;padding:1.1rem;">
                  <p style="font-size:.72rem;font-weight:800;color:var(--blue);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.6rem;">🛍️ Server + Cache — /products/:id</p>
                  <div style="display:flex;flex-direction:column;gap:.4rem;">
                    <div style="display:flex;gap:.5rem;font-size:.72rem;color:var(--ink-2);line-height:1.5;">
                      <span style="color:var(--blue);font-weight:700;flex-shrink:0;">①</span>
                      <span><strong style="color:var(--ink-1);">User 1</strong> requests the page → server runs Angular, fetches data, builds HTML, sends it</span>
                    </div>
                    <div style="display:flex;gap:.5rem;font-size:.72rem;color:var(--ink-2);line-height:1.5;">
                      <span style="color:var(--blue);font-weight:700;flex-shrink:0;">②</span>
                      <span>Server also tells the browser/CDN: <strong style="color:var(--ink-1);">"keep this for 1 hour"</strong> (via <code>Cache-Control</code>)</span>
                    </div>
                    <div style="display:flex;gap:.5rem;font-size:.72rem;color:var(--ink-2);line-height:1.5;">
                      <span style="color:var(--blue);font-weight:700;flex-shrink:0;">③</span>
                      <span><strong style="color:var(--ink-1);">Users 2–100</strong> within that hour → get the cached copy. Server is never touched</span>
                    </div>
                    <div style="display:flex;gap:.5rem;font-size:.72rem;color:var(--ink-2);line-height:1.5;">
                      <span style="color:var(--blue);font-weight:700;flex-shrink:0;">④</span>
                      <span>After 1 hour, cache expires → <strong style="color:var(--ink-1);">next request triggers a fresh build</strong> and the cycle repeats</span>
                    </div>
                  </div>
                </div>

              </div>

              <div class="callout callout-blue">
                <p class="callout-title" style="color:#1e40af;">The key difference</p>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.7;">
                  <strong style="color:var(--ink-1);">Prerender</strong> is built at deploy time — never rebuilds unless you redeploy. Perfect for pages that never change.<br/>
                  <strong style="color:var(--ink-1);">Server + Cache</strong> is built on the first request after the cache expires — perfect for pages that change (stock, price)
                  but are the same for all users within that window.
                </p>
              </div>
            </div>

            <!-- ── The File ── -->
            <div style="margin-bottom:1.75rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">
                The File: <code style="font-size:.7rem;text-transform:none;">app.routes.server.ts</code>
              </p>
              <div class="code-header">
