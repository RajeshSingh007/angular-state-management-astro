---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<MainLayout
  title="Angular SSR & Hybrid Rendering — Angular State Management Visualizer"
  description="Learn Angular SSR, CSR, SSG and Hybrid Rendering in plain English with real-world analogies, diagrams and code examples.">
  <Navbar active="/ssr" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    /* ── Tokens ── */
    :root {
      --red:        #dd0031;
      --red-dim:    #b8002a;
      --red-tint:   #fff0f3;
      --red-border: #ffc9d3;
      --ink-1:      #0b0b0f;
      --ink-2:      #4a4a5a;
      --ink-3:      #8a8a9a;
      --surface:    #ffffff;
      --page:       #f8f8fb;
      --grid:       #e8e8f0;
      --blue:       #2563eb;
      --teal:       #0d9488;
      --orange:     #ea580c;
      --green:      #16a34a;
      --warn:       #d97706;
      --dark:       #0d0e14;
      --dark-2:     #161720;
      --dark-3:     #1e1f2e;
    }

    * { box-sizing: border-box; }
    body { background: var(--page); font-family: 'Sora', system-ui, sans-serif; }

    /* ── Hero ── */
    .hero {
      background: var(--dark);
      background-image: radial-gradient(circle, rgba(255,255,255,.07) 1px, transparent 1px);
      background-size: 24px 24px;
      padding: 5rem 1.5rem 4rem;
      border-bottom: 1px solid #2a2b3d;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(221,0,49,.12) 0%, transparent 60%);
      pointer-events: none;
    }
    .hero-inner { max-width: 52rem; margin: 0 auto; position: relative; z-index: 1; }
    .hero-badge {
      display: inline-flex; align-items: center; gap: .4rem;
      background: rgba(221,0,49,.15); border: 1px solid rgba(221,0,49,.35);
      color: #ff6b8a; font-size: .65rem; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase;
      padding: .3rem .85rem; border-radius: 99px; margin-bottom: 1.25rem;
    }
    .hero h1 {
      font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 800;
      color: #ffffff; line-height: 1.1; margin-bottom: 1.1rem;
      letter-spacing: -.02em;
    }
    .hero h1 span { color: var(--red); }
    .hero-lead {
      font-size: .95rem; color: #a0a0b8; line-height: 1.75;
      max-width: 46ch; margin-bottom: 2rem;
    }
    .hero-pills { display: flex; flex-wrap: wrap; gap: .6rem; }
    .hero-pill {
      display: inline-flex; align-items: center; gap: .35rem;
      background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);
      color: #c0c0d8; font-size: .7rem; font-weight: 600;
      padding: .35rem .85rem; border-radius: 99px;
    }

    /* ── 3-col shell ── */
    .page-shell   { max-width: 90rem; margin: 0 auto; padding: 2.5rem 1.5rem; }
    .page-cols    { display: grid; grid-template-columns: 14rem 1fr; gap: 2.5rem; align-items: flex-start; }
    @media (max-width: 1024px) { .page-cols { grid-template-columns: 1fr; } .left-nav { display: none; } }

    /* ── Left nav ── */
    .left-nav { position: sticky; top: 5.5rem; }
    .left-nav-head {
      font-size: .6rem; font-weight: 700; letter-spacing: .14em;
      text-transform: uppercase; color: var(--red);
      padding-bottom: .6rem; margin-bottom: .75rem;
      border-bottom: 1px solid var(--grid);
    }
    .left-nav-section { margin-bottom: 1.25rem; }
    .left-nav-section-label {
      font-size: .58rem; font-weight: 700; letter-spacing: .1em;
      text-transform: uppercase; color: var(--ink-3);
      padding: 0 .6rem; margin-bottom: .3rem;
    }
    .left-nav-item {
      display: flex; align-items: center; gap: .55rem;
      padding: .38rem .6rem; border-radius: .45rem;
      font-size: .72rem; color: var(--ink-2);
      text-decoration: none; transition: all .15s; line-height: 1.3;
    }
    .left-nav-item:hover { background: var(--grid); color: var(--ink-1); }
    .left-nav-item.active { background: var(--red-tint); color: var(--red); font-weight: 700; }
    .left-nav-dot { width: .45rem; height: .45rem; border-radius: 50%; background: currentColor; flex-shrink: 0; }
    .left-nav-num { font-size: .58rem; font-weight: 700; color: var(--ink-3); width: 1rem; text-align: right; flex-shrink: 0; }


    /* ── Section ── */
    .section { margin-bottom: 3.5rem; scroll-margin-top: 5.5rem; }
    .eyebrow {
      font-size: .6rem; font-weight: 700; letter-spacing: .14em;
      text-transform: uppercase; color: var(--red); margin-bottom: .4rem;
    }
    .sec-title {
      font-size: 1.45rem; font-weight: 800; color: var(--ink-1);
      line-height: 1.2; margin-bottom: .9rem; letter-spacing: -.02em;
    }
    .sec-lead {
      font-size: .875rem; color: var(--ink-2); line-height: 1.75;
      max-width: 62ch; margin-bottom: 1.5rem;
    }
    .divider { border: none; border-top: 1px solid var(--grid); margin: 3rem 0; }

    /* ── Cards ── */
    .card {
      background: var(--surface); border: 1px solid var(--grid);
      border-radius: .75rem; padding: 1.25rem 1.5rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.04);
      transition: box-shadow .2s, transform .2s;
    }
    .card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.08); }
    .card-red   { border-left: 3px solid var(--red); }
    .card-blue  { border-left: 3px solid var(--blue); }
    .card-teal  { border-left: 3px solid var(--teal); }
    .card-green { border-left: 3px solid var(--green); }
    .card-warn  { border-left: 3px solid var(--warn); }
    .card-orange{ border-left: 3px solid var(--orange); }

    /* ── Rendering Matrix ── */
    .matrix {
      border: 1px solid var(--grid); border-radius: .75rem;
      overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.05);
    }
    .matrix-header {
      display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr;
      background: var(--dark); padding: .75rem 1rem; gap: .5rem;
    }
    .matrix-header-cell { font-size: .72rem; font-weight: 700; color: #9090aa; }
    .matrix-header-cell.mode { text-align: center; }
    .matrix-row {
      display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr;
      padding: .7rem 1rem; gap: .5rem; border-top: 1px solid var(--grid);
      align-items: center; transition: background .15s;
    }
    .matrix-row:hover { background: #f5f5fb; }
    .matrix-row:nth-child(even) { background: var(--page); }
    .matrix-row:nth-child(even):hover { background: #f0f0f8; }
    .matrix-aspect { font-size: .75rem; font-weight: 600; color: var(--ink-1); }
    .matrix-cell { text-align: center; font-size: .72rem; color: var(--ink-2); line-height: 1.45; }
    .mtag {
      display: inline-flex; align-items: center; gap: .3rem;
      font-size: .65rem; font-weight: 700; letter-spacing: .05em;
      padding: .2rem .6rem; border-radius: 99px;
    }
    .mtag-csr  { background: #fff3e8; color: #9a3412; border: 1px solid #fed7aa; }
    .mtag-ssr  { background: #eff5ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .mtag-ssg  { background: #f0fdf8; color: #065f46; border: 1px solid #99f6e4; }
    .mode-icon { font-size: 1.1rem; margin-bottom: .25rem; display: block; }
    .matrix-mode-head {
      text-align: center; display: flex; flex-direction: column; align-items: center; gap: .2rem;
    }
    .perf-tag {
      display: inline-block; font-size: .6rem; font-weight: 700;
      padding: .1rem .45rem; border-radius: 99px; margin-top: .15rem;
    }
    .perf-slow   { background: #fef2f2; color: var(--red); }
    .perf-fast   { background: #eff5ff; color: var(--blue); }
    .perf-instant{ background: #f0fdf8; color: var(--teal); }
    .check { color: var(--green); font-weight: 700; }
    .cross { color: var(--red); }

    /* ── Mode cards (3-col) ── */
    .g3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
    .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 720px) { .g3 { grid-template-columns: 1fr; } }
    @media (max-width: 560px) { .g2 { grid-template-columns: 1fr; } }

    .mode-card {
      background: var(--surface); border: 1px solid var(--grid);
      border-radius: .75rem; padding: 1.35rem;
      display: flex; flex-direction: column; gap: .6rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.04);
      transition: box-shadow .2s, transform .2s;
    }
    .mode-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,.1); transform: translateY(-2px); }
    .mode-badge {
      display: inline-block; font-size: .6rem; font-weight: 700;
      letter-spacing: .08em; text-transform: uppercase;
      padding: .15rem .6rem; border-radius: 99px;
    }
    .mode-title { font-size: 1rem; font-weight: 800; color: var(--ink-1); letter-spacing: -.01em; }
    .mode-desc  { font-size: .77rem; color: var(--ink-2); line-height: 1.65; }
    .mode-pros-cons { font-size: .72rem; line-height: 1.65; display: flex; flex-direction: column; gap: .2rem; }
    .pro { color: var(--green); }
    .con { color: var(--red); }
    .mode-code {
      background: var(--dark); border-radius: .4rem; padding: .45rem .75rem;
      font-size: .68rem; font-family: 'JetBrains Mono','Fira Code',monospace;
      color: #6ee7b7; margin-top: auto; letter-spacing: .02em;
    }

    /* ── Glassmorphism analogy cards ── */
    .analogy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.5rem; }
    @media (max-width: 600px) { .analogy-grid { grid-template-columns: 1fr; } }
    .analogy-card {
      border-radius: .9rem; padding: 1.5rem;
      position: relative; overflow: hidden;
    }
    .analogy-card-restaurant {
      background: linear-gradient(135deg, #1e0a2e 0%, #2d1040 100%);
      border: 1px solid rgba(255,100,150,.25);
      box-shadow: 0 8px 32px rgba(200,0,80,.15), inset 0 1px 0 rgba(255,255,255,.08);
    }
    .analogy-card-apartment {
      background: linear-gradient(135deg, #0a1a2e 0%, #0d2240 100%);
      border: 1px solid rgba(80,160,255,.25);
      box-shadow: 0 8px 32px rgba(0,80,200,.15), inset 0 1px 0 rgba(255,255,255,.08);
    }
    .analogy-card::before {
      content: ''; position: absolute;
      top: -40px; right: -40px;
      width: 140px; height: 140px;
      border-radius: 50%;
      filter: blur(48px); opacity: .35;
      pointer-events: none;
    }
    .analogy-card-restaurant::before { background: #dd0031; }
    .analogy-card-apartment::before  { background: #2563eb; }
    .analogy-tag {
      display: inline-flex; align-items: center; gap: .35rem;
      font-size: .62rem; font-weight: 700; letter-spacing: .1em;
      text-transform: uppercase; margin-bottom: .9rem;
      padding: .25rem .7rem; border-radius: 99px;
    }
    .analogy-card-restaurant .analogy-tag { background: rgba(221,0,49,.2); color: #ff8fab; border: 1px solid rgba(221,0,49,.3); }
    .analogy-card-apartment  .analogy-tag { background: rgba(37,99,235,.2); color: #93c5fd; border: 1px solid rgba(37,99,235,.3); }
    .analogy-icon { font-size: 2rem; line-height: 1; margin-bottom: .6rem; display: block; }
    .analogy-title { font-size: 1rem; font-weight: 800; color: #fff; margin-bottom: .5rem; letter-spacing: -.01em; }
    .analogy-body { font-size: .78rem; color: rgba(255,255,255,.7); line-height: 1.7; }
    .analogy-highlight {
      display: flex; align-items: flex-start; gap: .6rem;
      background: rgba(255,255,255,.06); border-radius: .5rem;
      padding: .75rem; margin-top: .85rem; font-size: .72rem;
      color: rgba(255,255,255,.85); line-height: 1.6;
      border: 1px solid rgba(255,255,255,.08);
      backdrop-filter: blur(8px);
    }

    /* ── Execution timeline ── */
    .timeline { display: flex; align-items: flex-start; gap: 0; margin-bottom: 1.25rem; overflow-x: auto; padding-bottom: .5rem; }
    .timeline-step {
      display: flex; flex-direction: column; align-items: center;
      flex: 1; min-width: 7.5rem; position: relative;
    }
    .timeline-step + .timeline-step::before {
      content: ''; position: absolute;
      top: 1.1rem; right: 50%; left: -50%;
      height: 2px; background: var(--grid); z-index: 0;
    }
    .timeline-step.csr + .timeline-step.csr::before { background: linear-gradient(90deg, #fca5a5, #fca5a5); }
    .tl-dot {
      width: 2.2rem; height: 2.2rem; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: .8rem; font-weight: 800; z-index: 1; flex-shrink: 0;
      border: 2px solid transparent; position: relative;
    }
    .tl-dot-red  { background: #fef2f2; color: var(--red); border-color: #fecaca; }
    .tl-dot-blue { background: #eff5ff; color: var(--blue); border-color: #bfdbfe; }
    .tl-label { font-size: .7rem; font-weight: 700; color: var(--ink-1); text-align: center; margin-top: .5rem; line-height: 1.35; max-width: 6.5rem; }
    .tl-sub   { font-size: .62rem; color: var(--ink-3); text-align: center; margin-top: .15rem; line-height: 1.4; max-width: 6.5rem; }
    .tl-time  { font-size: .6rem; font-weight: 700; padding: .1rem .4rem; border-radius: 99px; margin-top: .35rem; }
    .tl-time-slow { background: #fef2f2; color: var(--red); }
    .tl-time-ok   { background: #f0fdf8; color: var(--teal); }

    /* ── Code blocks ── */
    .code-block {
      background: var(--dark); border: 1px solid #252635;
      border-radius: .65rem; padding: 1rem 1.25rem;
      font-family: 'JetBrains Mono','Fira Code',monospace;
      font-size: .72rem; line-height: 1.85; overflow-x: auto;
      color: #d4d4d4;
    }
    .code-block .cm { color: #6b7280; font-style: italic; }
    .code-block .ky { color: #93c5fd; }
    .code-block .fn { color: #fde68a; }
    .code-block .st { color: #fb923c; }
    .code-block .vl { color: #c084fc; }
    .code-block .ok { color: #6ee7b7; }
    .code-block .hi { color: #fff; font-weight: 700; }
    .code-block .rd { color: #f87171; }
    .code-header {
      display: flex; align-items: center; justify-content: space-between;
      background: var(--dark-2); border: 1px solid #252635;
      border-bottom: none; border-radius: .65rem .65rem 0 0;
      padding: .55rem 1.1rem;
    }
    .code-header + .code-block { border-top-left-radius: 0; border-top-right-radius: 0; }
    .code-dots { display: flex; gap: .35rem; }
    .code-dot  { width: .55rem; height: .55rem; border-radius: 50%; }
    .code-filename { font-size: .65rem; font-weight: 700; color: #6060a0; font-family: monospace; }

    /* ── Callout ── */
    .callout { border-radius: .6rem; padding: 1rem 1.25rem; font-size: .8rem; line-height: 1.65; }
    .callout-blue   { background: #eff5ff; border: 1px solid #bfdbfe; }
    .callout-amber  { background: #fffbeb; border: 1px solid #fde68a; }
    .callout-red    { background: #fff0f3; border: 1px solid var(--red-border); }
    .callout-green  { background: #f0fdf8; border: 1px solid #99f6e4; }
    .callout-teal   { background: #f0fdfa; border: 1px solid #99f6e4; }
    .callout-title  { font-weight: 700; font-size: .8rem; margin-bottom: .4rem; }

    /* ── Before/After ── */
    .ba-grid  { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 600px) { .ba-grid { grid-template-columns: 1fr; } }
    .ba-panel { border-radius: .7rem; overflow: hidden; border: 1px solid var(--grid); }
    .ba-head  { padding: .55rem 1rem; font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
    .ba-head-red { background: #fef2f2; color: var(--red); border-bottom: 1px solid #fecaca; }
    .ba-head-grn { background: #f0fdf8; color: var(--green); border-bottom: 1px solid #bbf7d0; }
    .ba-body     { background: var(--surface); padding: .9rem 1rem; font-size: .75rem; color: var(--ink-2); line-height: 1.75; }
    .ba-bad  { color: var(--red); font-weight: 600; }
    .ba-good { color: var(--green); font-weight: 600; }

    /* ── Steps ── */
    .steps    { display: flex; flex-direction: column; gap: .5rem; }
    .step-row { display: flex; gap: .75rem; align-items: flex-start; font-size: .78rem; }
    .step-num { width: 1.4rem; height: 1.4rem; border-radius: 50%; font-size: .62rem; font-weight: 700; flex-shrink: 0; display: flex; align-items: center; justify-content: center; margin-top: .05rem; }
    .step-gray{ background: #f1f0ec; color: var(--ink-3); }
    .step-red { background: #fef2f2; color: var(--red); }
    .step-grn { background: #f0fdf8; color: var(--green); }

    /* ── Flow ── */
    .flow      { display: flex; flex-direction: column; gap: 0; }
    .flow-step { display: flex; align-items: stretch; }
    .flow-line { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; width: 2rem; }
    .flow-dot  { width: .7rem; height: .7rem; border-radius: 50%; flex-shrink: 0; margin-top: .65rem; }
    .flow-vln  { flex: 1; width: 2px; background: var(--grid); min-height: .6rem; }
    .flow-cnt  { flex: 1; padding: .4rem 0 .4rem .75rem; }
    .flow-lbl  { font-size: .78rem; font-weight: 600; color: var(--ink-1); }
    .flow-sub  { font-size: .7rem; color: var(--ink-3); margin-top: .1rem; }

    /* ── Route chips ── */
    .route-card { background: var(--surface); border: 1px solid var(--grid); border-radius: .6rem; padding: .75rem 1rem; display: flex; flex-direction: column; gap: .3rem; transition: box-shadow .15s; }
    .route-card:hover { box-shadow: 0 2px 10px rgba(0,0,0,.07); }
    .route-path { font-family: monospace; font-size: .72rem; font-weight: 700; color: var(--ink-1); }
    .route-mode { font-size: .58rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; padding: .15rem .5rem; border-radius: 99px; }
    .mode-pre  { background: #f0fdf8; color: #065f46; border: 1px solid #99f6e4; }
    .mode-srv  { background: #eff5ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .mode-csr  { background: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; }
    .route-desc{ font-size: .7rem; color: var(--ink-2); line-height: 1.5; }

    /* ── File list ── */
    .file-row  { display: flex; align-items: flex-start; gap: .75rem; padding: .6rem 0; border-bottom: 1px solid var(--grid); }
    .file-row:last-child { border-bottom: none; }
    .file-chip { background: var(--page); border: 1px solid var(--grid); border-radius: .3rem; padding: .15rem .5rem; font-family: monospace; font-size: .67rem; font-weight: 700; color: var(--blue); flex-shrink: 0; white-space: nowrap; }
    .file-desc { font-size: .75rem; color: var(--ink-2); line-height: 1.55; padding-top: .1rem; }

    /* ── Verdict ── */
    .verdict { background: var(--dark); border-radius: .65rem; padding: 1.1rem 1.5rem; text-align: center; }
    .verdict p { font-size: .85rem; font-weight: 700; color: #f1f5f9; line-height: 1.7; margin: 0; }
    .vbad  { color: #f87171; }
    .vgood { color: #6ee7b7; }

    /* ── Takeaway ── */
    .tk-item { display: flex; gap: .75rem; align-items: flex-start; padding: .75rem 0; border-bottom: 1px solid var(--grid); }
    .tk-item:last-child { border-bottom: none; }
    .tk-dot  { width: .45rem; height: .45rem; border-radius: 50%; background: var(--red); flex-shrink: 0; margin-top: .45rem; }
    .tk-text { font-size: .8rem; color: var(--ink-2); line-height: 1.65; }
    .tk-text strong { color: var(--ink-1); }

    /* ── What you'll learn ── */
    .learn-list { list-style: none; padding: 0; margin: 0; }
    .learn-list li { display: flex; align-items: flex-start; gap: .75rem; padding: .55rem 0; border-bottom: 1px solid var(--grid); font-size: .82rem; color: var(--ink-2); line-height: 1.6; }
    .learn-list li:last-child { border-bottom: none; }
    .learn-num { width: 1.25rem; height: 1.25rem; background: var(--red); color: white; border-radius: 50%; font-size: .6rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: .1rem; }

    /* ── Section story cards ── */
    .story-card { display: flex; gap: 1rem; align-items: flex-start; background: var(--surface); border: 1px solid var(--grid); border-radius: .75rem; padding: 1.1rem 1.25rem; transition: box-shadow .2s; }
    .story-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.07); }
    .story-icon { width: 2.25rem; height: 2.25rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }

    /* ── Micro-interactions ── */
    a { transition: color .15s, opacity .15s; }
    button { transition: all .15s; cursor: pointer; }

    @media (max-width: 1024px) { .left-nav { display: none; } }
  </style>

  <main id="main-content">
  <div class="pt-14">

