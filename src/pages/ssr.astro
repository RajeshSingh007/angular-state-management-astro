                    &nbsp;&nbsp;&#125;,<br/>
                    &nbsp;&nbsp;&#123;<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="st">path</span>: <span class="vl">&#39;products/:id&#39;</span>,<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="st">renderMode</span>: RenderMode.<span class="ok">Server</span>,<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="st">headers</span>: &#123; <span class="vl">&#39;Cache-Control&#39;</span>: <span class="vl">&#39;max-age=3600&#39;</span> &#125;<br/>
                    &nbsp;&nbsp;&#125;,<br/>
                    &nbsp;&nbsp;&#123;<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="st">path</span>: <span class="vl">&#39;dashboard&#39;</span>,<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="st">renderMode</span>: RenderMode.<span class="ok">Server</span>,<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="st">headers</span>: &#123; <span class="vl">&#39;Cache-Control&#39;</span>: <span class="vl">&#39;no-store&#39;</span> &#125;<br/>
                    &nbsp;&nbsp;&#125;<br/>
                    ];
                  </div>
                </div>
              </div>

              <!-- What each file answers -->
              <div style="display:flex;flex-direction:column;gap:.45rem;margin-bottom:1rem;">
                <div style="display:flex;gap:.75rem;align-items:flex-start;font-size:.73rem;color:var(--ink-2);line-height:1.6;">
                  <span style="font-size:.8rem;flex-shrink:0;">📋</span>
                  <span><code>app.routes.ts</code> answers: <strong style="color:var(--ink-1);">"When the user visits <code>/products/123</code>, show <code>ProductDetailComponent</code>."</strong>
                  — This is pure Angular, runs in the browser.</span>
                </div>
                <div style="display:flex;gap:.75rem;align-items:flex-start;font-size:.73rem;color:var(--ink-2);line-height:1.6;">
                  <span style="font-size:.8rem;flex-shrink:0;">🖥️</span>
                  <span><code>app.routes.server.ts</code> answers: <strong style="color:var(--ink-1);">"When the server receives a request for <code>/products/123</code>, run Angular and cache the result for 1 hour."</strong>
                  — This is read only by the server, never by the browser.</span>
                </div>
                <div style="display:flex;gap:.75rem;align-items:flex-start;font-size:.73rem;color:var(--ink-2);line-height:1.6;">
                  <span style="font-size:.8rem;flex-shrink:0;">🔗</span>
                  <span>Angular matches them by <strong style="color:var(--ink-1);">the same path string</strong>. For <code>products/:id</code>: use <code>ProductDetailComponent</code> (from routes) AND render on server with cache (from server routes).</span>
                </div>
              </div>

              <div class="callout callout-amber">
                <p class="callout-title" style="color:#92400e;">Hotel analogy</p>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.7;">
                  <code>app.routes.ts</code> is the <strong style="color:var(--ink-1);">room directory</strong> — "Room 101 is a standard room, Room 201 is a suite."<br/>
                  <code>app.routes.server.ts</code> is the <strong style="color:var(--ink-1);">housekeeping schedule</strong> — "Standard rooms cleaned daily, suites every 12 hours."<br/>
                  Two separate lists about the same rooms. One answers <em>what</em> the room is. The other answers <em>how</em> to service it.
                </p>
              </div>
            </div>

            <!-- ── 3 Things You Can Control ── -->
            <div>
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">
                3 Things You Can Set Per Route
              </p>
              <div style="display:flex;flex-direction:column;gap:.5rem;">

                <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                  <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#fef2f2;border:1px solid #fecaca;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--red);flex-shrink:0;">1</div>
                  <div>
                    <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;"><code>renderMode</code> — how the HTML is produced</p>
                    <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">
                      <code>RenderMode.Prerender</code> — built once at deploy time, served as a static file. Zero server cost per visit.<br/>
                      <code>RenderMode.Server</code> — Angular runs on the server for every request and builds fresh HTML.<br/>
                      <code>RenderMode.Client</code> — no SSR, Angular boots entirely in the browser (same as default Angular).
                    </p>
                  </div>
                </div>

                <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                  <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#fff7ed;border:1px solid #fed7aa;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--orange);flex-shrink:0;">2</div>
                  <div>
                    <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;"><code>headers</code> — how long the browser and CDN should keep a copy</p>
                    <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">
                      <code>Cache-Control: max-age=3600</code> means "keep this response for 1 hour — don't ask the server again."
                      <code>no-store</code> means "throw it away immediately — always ask the server."
                      Without this, your dashboard could get cached by a CDN and served to the wrong user.
                    </p>
                  </div>
                </div>

                <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                  <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#eff5ff;border:1px solid #bfdbfe;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--blue);flex-shrink:0;">3</div>
                  <div>
                    <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;"><code>status</code> / <code>redirectTo</code> — real HTTP codes, not fake browser ones</p>
                    <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">
                      Without SSR, Angular handles 404s inside the browser — but the server still returns HTTP 200 to everyone.
                      Google sees a 200 for a page that doesn't exist and thinks it's fine.
                      With Server Routing, <code>status: 404</code> sends a genuine 404 HTTP response.
                      <code>redirectTo + status: 301</code> sends a permanent redirect that browsers and search engines both honour.
                    </p>
                  </div>
                </div>

              </div>
            </div>
          </section>

          <hr class="divider" />

          <!-- ── 08 HTTP Cache ── -->
          <section id="http-cache" class="section reveal">
            <p class="eyebrow">08 · HTTP Transfer Cache</p>
            <h2 class="sec-title">Why Your API Gets Called Twice — The Full Story</h2>
            <p class="sec-lead">
              To fully understand the double-fetch problem and what Transfer Cache actually solves,
              you need to first separate <strong>three things</strong> that live at completely different layers of Angular SSR.
              Most explanations skip this step — which is exactly why it stays confusing.
              Let's build this understanding from the ground up.
            </p>

            <!-- ── STEP 0: The 3 Concepts ── -->
            <div style="margin-bottom:2rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">
                First: Separate These 3 Things in Your Head
              </p>
              <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.85rem;">
                <div style="background:linear-gradient(135deg,rgba(6,182,212,.08),rgba(6,182,212,.02));border:1px solid rgba(6,182,212,.22);border-radius:.75rem;padding:1.1rem;">
                  <div style="font-size:1.5rem;margin-bottom:.5rem;">🧾</div>
                  <p style="font-size:.8rem;font-weight:800;color:#0e7490;margin-bottom:.4rem;">HTML String</p>
                  <p style="font-size:.74rem;color:var(--ink-2);line-height:1.7;">
                    Plain text characters — <code>&lt;div&gt;Shoes&lt;/div&gt;</code>.
                    Can be sent over HTTP. Stored in a file. Logged to console.
                    <strong style="color:var(--ink-1);">No memory. No logic. No behaviour.</strong>
                    Just characters.
                  </p>
                </div>
                <div style="background:linear-gradient(135deg,rgba(234,179,8,.08),rgba(234,179,8,.02));border:1px solid rgba(234,179,8,.22);border-radius:.75rem;padding:1.1rem;">
                  <div style="font-size:1.5rem;margin-bottom:.5rem;">🌳</div>
                  <p style="font-size:.8rem;font-weight:800;color:#854d0e;margin-bottom:.4rem;">DOM Nodes</p>
                  <p style="font-size:.74rem;color:var(--ink-2);line-height:1.7;">
                    Live objects the <strong style="color:var(--ink-1);">browser's rendering engine</strong> builds when it reads the HTML string.
                    Exist only inside the browser — you can click them, style them, observe them.
                    <strong style="color:var(--ink-1);">The server never has DOM nodes.</strong>
                  </p>
                </div>
                <div style="background:linear-gradient(135deg,rgba(221,0,49,.08),rgba(221,0,49,.02));border:1px solid rgba(221,0,49,.22);border-radius:.75rem;padding:1.1rem;">
                  <div style="font-size:1.5rem;margin-bottom:.5rem;">⚙️</div>
                  <p style="font-size:.8rem;font-weight:800;color:#991b1b;margin-bottom:.4rem;">Component Objects</p>
                  <p style="font-size:.74rem;color:var(--ink-2);line-height:1.7;">
                    Live JS class instances — <code>new ProductListComponent()</code> — sitting in RAM.
                    Hold your <code>ngOnInit</code>, click handlers, injected services.
                    <strong style="color:var(--ink-1);">Exist on both server and browser, but never cross between them.</strong>
                  </p>
                </div>
              </div>
            </div>

            <!-- ── PHASES ── -->
            <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:1rem;">
              Now Watch What Happens: The 3 Phases of Angular SSR
            </p>

            <!-- Phase 1 -->
            <div style="position:relative;padding-left:3rem;margin-bottom:1.5rem;">
              <div style="position:absolute;left:0;top:0;width:2rem;height:2rem;border-radius:50%;background:var(--red);display:flex;align-items:center;justify-content:center;font-size:.73rem;font-weight:900;color:#fff;flex-shrink:0;">1</div>
              <div style="position:absolute;left:.95rem;top:2rem;bottom:-1.5rem;width:1px;background:rgba(221,0,49,.18);"></div>
              <div class="card" style="margin-bottom:0;">
                <p style="font-size:.84rem;font-weight:800;color:var(--red);margin-bottom:.65rem;">🖥️ Phase 1 — On the Server (Node.js Process)</p>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;margin-bottom:.65rem;">
                  A browser requests your page. The SSR server boots Angular — exactly like a browser would —
                  and runs the full component tree. Your <code>ProductListComponent</code> is created —
                  <code>new ProductListComponent()</code>. This component object lives in the server's RAM (V8 heap).
                </p>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;margin-bottom:.65rem;">
                  Angular calls <code>ngOnInit()</code> automatically — it's part of Angular's component lifecycle
                  and fires every time a component is mounted. Inside it, your
                  <code>this.http.get(&#39;/api/products&#39;)</code> fires.
                  Data arrives from your backend. The component object now has <code>this.products = [...]</code> filled.
                </p>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;margin-bottom:.75rem;">
                  Angular reads the component object + its template and produces an
                  <strong style="color:var(--ink-1);">HTML string</strong> — a wall of text like
                  <code>&lt;li&gt;Shoes ₹1,299&lt;/li&gt;&lt;li&gt;Hat ₹799&lt;/li&gt;</code>.
                  This string is sent to the browser over HTTP.
                </p>
                <div class="callout callout-amber" style="font-size:.76rem;">
                  <p class="callout-title" style="color:#92400e;">🔥 Critical moment</p>
                  The component object's job is done. The server discards it from RAM.
                  <strong>The browser receives only the HTML string — not the component object. That object is gone forever.</strong>
                </div>
              </div>
            </div>

            <!-- Phase 2 -->
            <div style="position:relative;padding-left:3rem;margin-bottom:1.5rem;">
              <div style="position:absolute;left:0;top:0;width:2rem;height:2rem;border-radius:50%;background:#2563eb;display:flex;align-items:center;justify-content:center;font-size:.73rem;font-weight:900;color:#fff;flex-shrink:0;">2</div>
              <div style="position:absolute;left:.95rem;top:2rem;bottom:-1.5rem;width:1px;background:rgba(37,99,235,.18);"></div>
              <div class="card" style="margin-bottom:0;">
                <p style="font-size:.84rem;font-weight:800;color:#60a5fa;margin-bottom:.65rem;">🌐 Phase 2 — Browser Parses the HTML (The "Dead" Phase)</p>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;margin-bottom:.65rem;">
                  The browser receives the HTML string and parses it into real DOM nodes —
                  live objects in the browser's rendering engine. The product list appears on screen immediately.
                  Fast first paint. Looks great.
                </p>
                <div class="callout" style="background:rgba(37,99,235,.07);border:1px solid rgba(37,99,235,.2);font-size:.76rem;">
                  <p class="callout-title" style="color:#93c5fd;">But there's a catch</p>
                  These DOM nodes are <strong>DEAD</strong>. No Angular logic is wired to them yet.
                  If you click a "Buy" button right now — nothing happens. The data is visible
                  but the page has zero behaviour. Angular's JS bundle hasn't even loaded in the browser yet.
                </div>
              </div>
            </div>

            <!-- Phase 3 -->
            <div style="position:relative;padding-left:3rem;margin-bottom:2rem;">
              <div style="position:absolute;left:0;top:0;width:2rem;height:2rem;border-radius:50%;background:#059669;display:flex;align-items:center;justify-content:center;font-size:.73rem;font-weight:900;color:#fff;flex-shrink:0;">3</div>
              <div class="card" style="margin-bottom:0;">
                <p style="font-size:.84rem;font-weight:800;color:#34d399;margin-bottom:.65rem;">⚡ Phase 3 — Angular Boots in the Browser (Hydration)</p>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;margin-bottom:.65rem;">
                  Angular's JS bundle downloads and boots. Angular starts creating component objects
                  in the <strong style="color:var(--ink-1);">browser's</strong> RAM — completely fresh.
                  It has zero memory of what ran on the server. It does not know a
                  <code>ProductListComponent</code> was created 200ms ago on the server.
                  It creates a brand new one: <code>new ProductListComponent()</code>.
                </p>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;margin-bottom:.65rem;">
                  Then Angular <strong style="color:var(--ink-1);">wires</strong> these new component objects
                  to the existing DOM nodes (the ones the browser already rendered from the HTML string).
                  This wiring process is called <strong style="color:var(--ink-1);">hydration</strong> —
                  Angular doesn't re-create the DOM from scratch, it attaches its logic to what's already there,
                  making the dead HTML interactive.
                </p>
                <div class="callout" style="background:rgba(99,102,241,.07);border:1px solid rgba(99,102,241,.2);font-size:.76rem;margin-bottom:.75rem;">
                  <p class="callout-title" style="color:#818cf8;">💡 Same class — two completely separate objects</p>
                  The server created a <code>ProductListComponent</code> object and the browser just created another one.
                  Same class, but these are two strangers — they share no memory, no state, no data.
                  The server's object was destroyed the moment the HTML was sent. The browser's object is brand new, starting from zero.
                  It has no idea what happened on the server 200ms ago.
                </div>
                <div class="callout callout-red" style="font-size:.76rem;margin-bottom:.75rem;">
                  <p class="callout-title" style="color:#fca5a5;">💥 Here's where the double-fetch happens</p>
                  Creating a new component object means Angular's lifecycle runs — and that includes
                  <code>ngOnInit()</code>. Your <code>this.http.get(&#39;/api/products&#39;)</code> fires again.
                  A real network request goes to your backend — for the same data the server fetched 200ms ago,
                  data that is already rendered in the DOM right in front of the user.
                </div>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;">
                  This is <em>not a bug in your code</em>. Angular is doing exactly what it's designed to do.
                  The component lifecycle always runs <code>ngOnInit</code> when a component is mounted.
                  The problem is there's no built-in mechanism to say:
                  <em>"the server already fetched this — skip the network call in the browser."</em>
                  That is exactly what Transfer Cache adds.
                </p>
              </div>
            </div>

            <!-- ── WHY CAN'T OBJECTS TRAVEL ── -->
            <div style="margin-bottom:2rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">
                The Question You're Probably Asking: Why Can't the Server Just Send the Component Object?
              </p>
              <div class="card card-warn" style="margin-bottom:1rem;">
                <p style="font-size:.81rem;font-weight:700;color:var(--ink-1);margin-bottom:.75rem;">
                  If the server already has a fully-loaded component object (with the products filled in),
                  why not just send that object to the browser? Then Angular could reuse it,
                  skip creating it again, skip <code>ngOnInit</code>, skip the second http.get — problem solved.
                </p>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;margin-bottom:.9rem;">
                  It sounds perfect. Here's why it's impossible:
                  <strong style="color:var(--ink-1);">a component object is not just data — it's a living machine.</strong>
                  It contains things that are alive right now in a specific block of RAM,
                  and have no text form whatsoever.
                </p>

                <!-- CAN vs CANNOT table -->
                <div class="ba-grid" style="margin-bottom:1rem;">
                  <div class="ba-panel">
                    <div class="ba-head ba-head-grn">✅ CAN travel over HTTP — it's just data</div>
                    <div class="ba-body">
                      <p><code>this.products = [&#123;"name":"Shoes"&#125;]</code></p>
                      <p>Plain JS array — can be written as JSON text</p>
                      <p>Numbers, strings, booleans — all just text</p>
                      <p>Any value that JSON.stringify() can handle</p>
                    </div>
                  </div>
                  <div class="ba-panel">
                    <div class="ba-head ba-head-red">❌ CANNOT travel over HTTP — it's live RAM</div>
                    <div class="ba-body">
                      <p><code>ngOnInit() &#123; this.http.get(...) &#125;</code> — live executable instructions</p>
                      <p>Click handlers — live functions in a specific V8 memory address</p>
                      <p><code>HttpClient</code> instance — holds open connections, internal state</p>
                      <p>Injected services (<code>Router</code>, <code>Store</code>, custom providers)</p>
                    </div>
                  </div>
                </div>

                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;margin-bottom:.65rem;">
                  Functions like <code>ngOnInit</code> and <code>onClick</code> are not data — they are
                  <strong style="color:var(--ink-1);">live instructions executing inside a specific V8 engine,
                  at a specific memory address, right now</strong>.
                  When the server's Node.js process finishes its job, those instructions cease to exist.
                  There is no way to write a function as text and "resume" it inside
                  a completely different V8 engine (the browser's). The instruction set is gone the moment
                  the server moves on.
                </p>
                <p style="font-size:.77rem;color:var(--ink-2);line-height:1.75;margin-bottom:.9rem;">
                  The <code>HttpClient</code> instance is even harder — it holds open socket connections,
                  internal interceptor chains, pending observable subscriptions. None of that can be
                  described as text. You cannot freeze a live socket, write it to a string, and
                  unfreeze it in a different process on a different machine.
                </p>

                <!-- Chef analogy -->
                <div style="background:linear-gradient(135deg,rgba(120,53,15,.35),rgba(92,38,10,.2));border:1px solid rgba(217,119,6,.3);border-radius:.75rem;padding:1.05rem;">
                  <p style="font-size:.77rem;font-weight:800;color:var(--ink-1);margin-bottom:.5rem;">👨‍🍳 Chef Analogy — The Clearest Way to Think About This</p>
                  <p style="font-size:.75rem;color:var(--ink-2);line-height:1.75;margin-bottom:.5rem;">
                    The server is a chef who prepares a dish (builds the HTML) and sends it to your table.
                    You receive the finished dish — <strong style="color:var(--ink-1);">the HTML string</strong>.
                    You can also receive the ingredient list — <strong style="color:var(--ink-1);">the JSON data</strong>.
                    Both are things that can be written down and handed over.
                  </p>
                  <p style="font-size:.75rem;color:var(--ink-2);line-height:1.75;">
                    But you <em>cannot</em> receive the chef. The chef's muscle memory of flipping a pan.
                    The chef's knowledge of when the butter is about to burn. The chef's hands.
                    Those are <strong style="color:var(--ink-1);">live capabilities that exist only in the chef's body</strong> —
                    they have no text form. The browser must grow its own chef (component objects) from scratch.
                    That is why Angular boots fresh and creates component objects again in the browser.
                    There is no other way.
                  </p>
                </div>
              </div>
            </div>

            <!-- ── THE CODE ── -->
            <div style="margin-bottom:1.25rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.7rem;">
                The Component That Causes the Double-Fetch
              </p>
              <div class="code-header">
                <div class="code-dots">
                  <div class="code-dot" style="background:#ff5f57;"></div>
                  <div class="code-dot" style="background:#febc2e;"></div>
                  <div class="code-dot" style="background:#28c840;"></div>
                </div>
                <span class="code-filename">product-list.component.ts</span>
              </div>
              <div class="code-block" style="border-top-left-radius:0;border-top-right-radius:0;">
                <span class="ky">@Component</span>(&#123; <span class="st">selector</span>: <span class="vl">&#39;app-product-list&#39;</span> &#125;)<br/>
                <span class="ky">export class</span> <span class="fn">ProductListComponent</span> <span class="ky">implements</span> <span class="fn">OnInit</span> &#123;<br/>
                &nbsp;&nbsp;<span class="ky">constructor</span>(<span class="ky">private</span> http: <span class="fn">HttpClient</span>) &#123;&#125;<br/>
                <br/>
                &nbsp;&nbsp;<span class="cm">// Angular calls this when a component is mounted</span><br/>
                &nbsp;&nbsp;<span class="cm">// "mounted" happens TWICE: once on server (Phase 1), once in browser (Phase 3)</span><br/>
                &nbsp;&nbsp;<span class="fn">ngOnInit</span>() &#123;<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="ky">this</span>.http.<span class="fn">get</span>(<span class="st">&#39;/api/products&#39;</span>).<span class="fn">subscribe</span>(data =&gt; &#123;<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="ky">this</span>.products = data;&nbsp;&nbsp;<span class="cm">// ← fires on server ✓ AND fires again in browser ✓</span><br/>
                &nbsp;&nbsp;&nbsp;&nbsp;&#125;);<br/>
                &nbsp;&nbsp;&#125;<br/>
                &#125;
              </div>
            </div>

            <!-- ── BEFORE / AFTER ── -->
            <div class="ba-grid" style="margin-bottom:1.5rem;">
              <div class="ba-panel">
                <div class="ba-head ba-head-red">❌ Without Transfer Cache</div>
                <div class="ba-body">
                  <p>🖥️ Server: ngOnInit → GET /api/products → data arrives</p>
                  <p>⚙️ Server builds HTML string with products in it</p>
                  <p>📤 HTML string sent to browser</p>
                  <p>🌐 Browser renders DOM nodes — user sees the list</p>
                  <p>⬇️ Angular JS bundle downloads, boots, creates fresh component objects</p>
                  <p class="ba-bad">🔁 ngOnInit fires again in the browser (new component, new lifecycle)</p>
                  <p class="ba-bad">📡 GET /api/products — real network request, same data all over again</p>
                  <p class="ba-bad">⏳ UI flickers / shows spinner for data already in the DOM</p>
                </div>
              </div>
              <div class="ba-panel">
                <div class="ba-head ba-head-grn">✅ With Transfer Cache</div>
                <div class="ba-body">
                  <p>🖥️ Server: ngOnInit → GET /api/products → data arrives</p>
                  <p>⚙️ Server builds HTML + <strong>embeds JSON in a &lt;script&gt; tag</strong></p>
                  <p>📤 HTML string + embedded JSON sent together (one HTTP response)</p>
                  <p>🌐 Browser renders DOM nodes — user sees the list</p>
                  <p>⬇️ Angular JS bundle downloads, boots, creates fresh component objects</p>
                  <p class="ba-good">🔁 ngOnInit fires — http.get(&#39;/api/products&#39;) is called</p>
                  <p class="ba-good">📦 Transfer Cache intercepts: "I have this in the embedded &lt;script&gt;"</p>
                  <p class="ba-good">⚡ Returns cached JSON instantly — zero network request, zero flicker</p>
                </div>
              </div>
            </div>

            <!-- ── HOW TRANSFER CACHE WORKS ── -->
            <div style="margin-bottom:1.25rem;">
              <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">
                How Transfer Cache Solves It — Step by Step
              </p>

              <!-- step strip -->
              <div style="display:flex;flex-direction:column;gap:.5rem;">

                <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                  <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#fef2f2;border:1px solid #fecaca;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--red);flex-shrink:0;">1</div>
                  <div>
                    <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;">Server: <code>ngOnInit</code> runs and fetches data normally</p>
                    <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">
                      The component calls <code>http.get(&#39;/api/products&#39;)</code> on the server.
                      The API responds with the products list. The component gets its data and Angular builds the HTML.
                      Transfer Cache is watching in the background — it quietly makes a copy of that API response.
                      Your component is not affected. Everything works as normal.
                    </p>
                  </div>
                </div>

                <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                  <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#fff7ed;border:1px solid #fed7aa;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--orange);flex-shrink:0;">2</div>
                  <div style="flex:1;">
                    <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;">Server: that copy gets written into the HTML as text</p>
                    <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;margin-bottom:.75rem;">
                      Transfer Cache takes that copied products array and writes it out as plain text
                      and drops it into a <code>&lt;script&gt;</code> tag right inside the HTML.
                      So the HTML the browser receives contains both: your rendered product list <em>and</em>
                      the raw data that produced it, sitting side by side.
                    </p>
                    <div class="code-header">
                      <div class="code-dots">
                        <div class="code-dot" style="background:#ff5f57;"></div>
                        <div class="code-dot" style="background:#febc2e;"></div>
                        <div class="code-dot" style="background:#28c840;"></div>
                      </div>
                      <span class="code-filename">HTML sent to browser (simplified)</span>
                    </div>
                    <div class="code-block" style="border-top-left-radius:0;border-top-right-radius:0;font-size:.67rem;">
                      <span class="cm">&lt;!-- your rendered product list --&gt;</span><br/>
                      <span class="ky">&lt;ul&gt;</span><br/>
                      &nbsp;&nbsp;<span class="ky">&lt;li&gt;</span>Shoes — ₹1,299<span class="ky">&lt;/li&gt;</span><br/>
                      &nbsp;&nbsp;<span class="ky">&lt;li&gt;</span>Hat — ₹799<span class="ky">&lt;/li&gt;</span><br/>
                      <span class="ky">&lt;/ul&gt;</span><br/>
                      <br/>
                      <span class="cm">&lt;!-- Transfer Cache drops the raw data right here --&gt;</span><br/>
                      <span class="ky">&lt;script</span> <span class="st">type</span>=<span class="vl">"application/json"</span> <span class="st">id</span>=<span class="vl">"ng-transfer-state"</span><span class="ky">&gt;</span><br/>
                      &nbsp;&nbsp;&#123;<br/>
                      &nbsp;&nbsp;&nbsp;&nbsp;<span class="st">"ZnBhcGkvcHJvZHVjdHM="</span>: &#123;<br/>
                      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="st">"body"</span>: [<br/>
                      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#123; <span class="st">"name"</span>: <span class="vl">"Shoes"</span>, <span class="st">"price"</span>: <span class="vl">1299</span> &#125;,<br/>
                      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#123; <span class="st">"name"</span>: <span class="vl">"Hat"</span>,   <span class="st">"price"</span>: <span class="vl">799</span>  &#125;<br/>
                      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;],<br/>
                      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="st">"status"</span>: <span class="vl">200</span><br/>
                      &nbsp;&nbsp;&nbsp;&nbsp;&#125;<br/>
                      &nbsp;&nbsp;&#125;<br/>
                      <span class="ky">&lt;/script&gt;</span>
                    </div>
                  </div>
                </div>

                <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                  <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#eff5ff;border:1px solid #bfdbfe;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--blue);flex-shrink:0;">3</div>
                  <div>
                    <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;">One HTTP response carries both: HTML + data</p>
                    <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">
                      The browser receives a single response — the rendered HTML and the embedded JSON travel together.
                      No extra round-trip. The data is already there before Angular even boots.
                    </p>
                  </div>
                </div>

                <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                  <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#f0fdf8;border:1px solid #bbf7d0;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--green);flex-shrink:0;">4</div>
                  <div>
                    <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;">Browser: <code>ngOnInit</code> fires again — intercepted instantly</p>
                    <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">
                      Angular boots, creates the component object, <code>ngOnInit</code> calls
                      <code>http.get(&#39;/api/products&#39;)</code> — Transfer Cache intercepts it,
                      reads the JSON from the <code>&lt;script&gt;</code> tag, and returns it instantly.
                      <strong style="color:var(--ink-1);">Zero network request. Zero spinner. Zero flicker.</strong>
                    </p>
                  </div>
                </div>

              </div>
            </div>

            <!-- Config -->
            <div class="code-header">
              <div class="code-dots">
                <div class="code-dot" style="background:#ff5f57;"></div>
                <div class="code-dot" style="background:#febc2e;"></div>
                <div class="code-dot" style="background:#28c840;"></div>
              </div>
              <span class="code-filename">app.config.ts — enable Transfer Cache</span>
            </div>
            <div class="code-block" style="margin-bottom:1rem;">
              <span class="fn">provideHttpClient</span>(<span class="fn">withHttpTransferCache</span>(&#123;<br/>
              &nbsp;&nbsp;includePostRequests: <span class="vl">false</span>,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// only GET by default — safe for idempotent reads</span><br/>
              &nbsp;&nbsp;includeRequestsWithAuthHeaders: <span class="vl">false</span>,&nbsp;<span class="cm">// never cache user-specific authenticated calls</span><br/>
              &#125;))
            </div>

            <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:.65rem;padding:.75rem 1rem;margin-bottom:1.5rem;font-size:.71rem;color:#78350f;line-height:1.7;">
              <strong style="color:#92400e;">⚡ Angular 18+ note:</strong> <code style="font-size:.67rem;background:rgba(0,0,0,.07);padding:.1rem .3rem;border-radius:.25rem;">withHttpTransferCache()</code> is the Angular 17 API. From Angular 18 onward, switching to <code style="font-size:.67rem;background:rgba(0,0,0,.07);padding:.1rem .3rem;border-radius:.25rem;">withFetch()</code> automatically enables Transfer Cache — no extra configuration needed: <code style="font-size:.67rem;background:rgba(0,0,0,.07);padding:.1rem .3rem;border-radius:.25rem;">provideHttpClient(withFetch())</code>. Both approaches work; <code style="font-size:.67rem;background:rgba(0,0,0,.07);padding:.1rem .3rem;border-radius:.25rem;">withFetch()</code> is the current recommended default.
            </div>

          </section>

          <hr class="divider" />

          <!-- ── 09 Server-Safe ── -->
          <section id="server-compat" class="section reveal">
            <p class="eyebrow">09 · Server-Safe Code</p>
            <h2 class="sec-title">Why Does My Code Crash When SSR Is On?</h2>
            <p class="sec-lead">When SSR is enabled, your component runs in two places — the browser <em>and</em> a Node.js server. <code style="background:var(--page);padding:.1rem .4rem;border-radius:.25rem;">window</code>, <code style="background:var(--page);padding:.1rem .4rem;border-radius:.25rem;">document</code>, and <code style="background:var(--page);padding:.1rem .4rem;border-radius:.25rem;">localStorage</code> are browser inventions. Node.js has never heard of them — calling them server-side crashes the entire request.</p>

            <!-- PART A: Two environments -->
            <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">Part A — Two Environments, Two Completely Different API Surfaces</p>

            <div class="g2" style="margin-bottom:1.5rem;">
              <div class="card" style="border-top:3px solid #22c55e;padding:1rem;">
                <p style="font-size:.72rem;font-weight:800;color:#166534;margin-bottom:.7rem;letter-spacing:.05em;">🌐 Browser (Chrome / Firefox / Safari)</p>
                <div style="font-size:.72rem;display:flex;flex-direction:column;">
                  <div style="display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;border-bottom:1px solid var(--grid);gap:.75rem;">
                    <code style="color:#166534;font-weight:700;white-space:nowrap;">window</code>
                    <span style="color:var(--ink-2);text-align:right;">global scope, scroll, history, location</span>
                  </div>
                  <div style="display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;border-bottom:1px solid var(--grid);gap:.75rem;">
                    <code style="color:#166534;font-weight:700;white-space:nowrap;">document</code>
                    <span style="color:var(--ink-2);text-align:right;">DOM tree, querySelector, title</span>
                  </div>
                  <div style="display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;border-bottom:1px solid var(--grid);gap:.75rem;">
                    <code style="color:#166534;font-weight:700;white-space:nowrap;">localStorage</code>
                    <span style="color:var(--ink-2);text-align:right;">client-side key/value storage</span>
                  </div>
                  <div style="display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;border-bottom:1px solid var(--grid);gap:.75rem;">
                    <code style="color:#166534;font-weight:700;white-space:nowrap;">navigator</code>
                    <span style="color:var(--ink-2);text-align:right;">user agent, geolocation, clipboard</span>
                  </div>
                  <div style="display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;gap:.75rem;">
                    <code style="color:#166534;font-weight:700;white-space:nowrap;">sessionStorage</code>
                    <span style="color:var(--ink-2);text-align:right;">tab-scoped key/value storage</span>
                  </div>
                </div>
                <p style="font-size:.68rem;margin-top:.65rem;color:#166534;font-weight:700;padding-top:.5rem;border-top:1px solid var(--grid);">✅ All of these exist in every browser</p>
              </div>

              <div class="card" style="border-top:3px solid #ef4444;padding:1rem;">
                <p style="font-size:.72rem;font-weight:800;color:#991b1b;margin-bottom:.7rem;letter-spacing:.05em;">🖥️ Node.js Server (where SSR runs)</p>
                <div style="font-size:.72rem;display:flex;flex-direction:column;">
                  <div style="display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;border-bottom:1px solid var(--grid);gap:.75rem;">
                    <code style="color:#1e40af;font-weight:700;white-space:nowrap;">process</code>
                    <span style="color:var(--ink-2);text-align:right;">env variables, exit, pid</span>
                  </div>
                  <div style="display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;border-bottom:1px solid var(--grid);gap:.75rem;">
                    <code style="color:#1e40af;font-weight:700;white-space:nowrap;">fs / path</code>
                    <span style="color:var(--ink-2);text-align:right;">file system, path utilities</span>
                  </div>
                  <div style="display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;border-bottom:1px solid var(--grid);gap:.75rem;">
                    <code style="color:#dc2626;font-weight:700;white-space:nowrap;">❌ window</code>
                    <span style="color:#dc2626;font-weight:600;text-align:right;">undefined — throws ReferenceError</span>
                  </div>
                  <div style="display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;border-bottom:1px solid var(--grid);gap:.75rem;">
                    <code style="color:#dc2626;font-weight:700;white-space:nowrap;">❌ document</code>
                    <span style="color:#dc2626;font-weight:600;text-align:right;">undefined — throws ReferenceError</span>
                  </div>
                  <div style="display:flex;justify-content:space-between;align-items:baseline;padding:.3rem 0;gap:.75rem;">
                    <code style="color:#dc2626;font-weight:700;white-space:nowrap;">❌ localStorage</code>
                    <span style="color:#dc2626;font-weight:600;text-align:right;">undefined — throws ReferenceError</span>
                  </div>
                </div>
                <p style="font-size:.68rem;margin-top:.65rem;color:#991b1b;font-weight:700;padding-top:.5rem;border-top:1px solid var(--grid);">❌ Node.js has never had browser globals — they simply do not exist</p>
              </div>
            </div>

            <!-- PART B: Crash sequence -->
            <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">Part B — What Actually Happens When Your Component Calls <code style="text-transform:none;letter-spacing:0;font-size:.72rem;">window</code> on the Server</p>

            <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.5rem;">

              <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#eff6ff;border:1px solid #bfdbfe;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:#1d4ed8;flex-shrink:0;">1</div>
                <div>
                  <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;">You enable SSR — Angular now runs your component on the Node.js server</p>
                  <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">Every time a user hits your URL, Node.js boots an Angular component, calls its lifecycle hooks (including <code>ngOnInit</code>), builds the HTML string, and sends it to the browser. Your component code now runs server-side on every request.</p>
                </div>
              </div>

              <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#fff7ed;border:1px solid #fed7aa;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--orange);flex-shrink:0;">2</div>
                <div>
                  <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;"><code>ngOnInit</code> fires on the server — and calls <code>window.scrollTo(0, 0)</code></p>
                  <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;">Your component's <code>ngOnInit</code> runs normally. It executes <code>window.scrollTo(0, 0)</code>. Node.js starts looking up <code>window</code> in the JavaScript scope chain — global scope, module scope, function scope...</p>
                </div>
              </div>

              <div style="display:flex;gap:1rem;align-items:flex-start;background:#fef2f2;border:1px solid #fecaca;border-radius:.65rem;padding:.85rem 1rem;">
                <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#fee2e2;border:1px solid #fca5a5;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--red);flex-shrink:0;">3</div>
                <div>
                  <p style="font-size:.76rem;font-weight:700;color:#991b1b;margin-bottom:.2rem;"><code>window</code> is not in any scope — Node.js throws <code>ReferenceError: window is not defined</code></p>
                  <p style="font-size:.73rem;color:#7f1d1d;line-height:1.65;">Node.js can't find <code>window</code> anywhere. JavaScript throws immediately — this happens at the JS engine level, before Angular can react. Angular never gets a chance to catch it or skip it. It's the same as calling any variable that was never declared.</p>
                </div>
              </div>

              <div style="display:flex;gap:1rem;align-items:flex-start;background:#fef2f2;border:1px solid #fecaca;border-radius:.65rem;padding:.85rem 1rem;">
                <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#fee2e2;border:1px solid #fca5a5;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:var(--red);flex-shrink:0;">4</div>
                <div>
                  <p style="font-size:.76rem;font-weight:700;color:#991b1b;margin-bottom:.2rem;">The entire HTTP request crashes — the user gets a blank page or 500 error</p>
                  <p style="font-size:.73rem;color:#7f1d1d;line-height:1.65;">The unhandled error bubbles up through Angular's server renderer, through the Express/Node HTTP server, and kills the request. The browser never receives any HTML. The user sees a blank page or a generic server error — with no indication of what went wrong.</p>
                </div>
              </div>

            </div>

            <!-- PART C: Why can't Angular just skip it? -->
            <div class="callout" style="margin-bottom:1.5rem;">
              <p style="font-size:.76rem;font-weight:800;color:var(--ink-1);margin-bottom:.5rem;">The question you're probably asking: "Why can't Angular just skip browser API calls when running on the server?"</p>
              <p style="font-size:.73rem;color:var(--ink-2);line-height:1.7;margin-bottom:.6rem;">Angular doesn't inspect or intercept your code before running it — it just calls your function. When JavaScript hits <code>window.scrollTo(0, 0)</code>, it looks up <code>window</code> in scope. That lookup fails at the JS engine level, before Angular can do anything. It's not a runtime logic error Angular can catch — it's a missing variable, same as calling <code>foo()</code> when <code>foo</code> was never declared.</p>
              <p style="font-size:.73rem;color:var(--ink-2);line-height:1.7;"><strong style="color:var(--ink-1);">Think of it like a recipe:</strong> You write a recipe that says "microwave for 2 minutes." That recipe works perfectly at home (browser). When a catering team tries to cook it in a kitchen with no microwave (Node.js server), the entire preparation halts — you can't skip a required step, you can only rewrite the recipe. The fix is to add: "skip this step if there is no microwave." That's exactly what <code>afterNextRender()</code> does.</p>
            </div>

            <!-- PART D: Three solutions -->
            <p style="font-size:.72rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">Part C — Three Ways to Write Server-Safe Code</p>

            <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.5rem;">

              <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#f0fdf4;border:1px solid #bbf7d0;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:#166534;flex-shrink:0;">1</div>
                <div style="flex:1;">
                  <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;"><code>afterNextRender()</code> — Angular's "browser only" hook <span style="font-weight:400;color:var(--ink-2);">(Angular 16+, simplest)</span></p>
                  <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;margin-bottom:.6rem;">Register browser-only code inside this callback. Angular guarantees it will <strong>only ever fire in the browser</strong>, after the first DOM render. The server never calls it. Use this for scroll position, animations, and any third-party library that needs the DOM.</p>
                  <div class="code-block" style="font-size:.68rem;">
                    <span class="ky">constructor</span>() &#123;<br/>
                    &nbsp;&nbsp;<span class="fn">afterNextRender</span>(() =&gt; &#123;<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="ok">window</span>.scrollTo(<span class="vl">0</span>, <span class="vl">0</span>);&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="cm">// ✅ browser only</span><br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="ok">localStorage</span>.setItem(<span class="st">'k'</span>, <span class="st">'v'</span>);<span class="cm">// ✅ browser only</span><br/>
                    &nbsp;&nbsp;&#125;);<br/>
                    &#125;
                  </div>
                </div>
              </div>

              <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#eff6ff;border:1px solid #bfdbfe;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:#1d4ed8;flex-shrink:0;">2</div>
                <div style="flex:1;">
                  <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;"><code>isPlatformBrowser(PLATFORM_ID)</code> — check which environment you're in at runtime</p>
                  <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;margin-bottom:.6rem;">Ask Angular which environment you're in — browser or server. Wrap browser-only code in an <code>if</code> block: the server always gets <code>false</code> and skips it, the browser gets <code>true</code> and runs it. Use this when you need completely different logic on each side.</p>
                  <div class="code-block" style="font-size:.68rem;">
                    <span class="ky">private</span> platformId = <span class="fn">inject</span>(<span class="fn">PLATFORM_ID</span>);<br/>
                    <br/>
                    <span class="fn">ngOnInit</span>() &#123;<br/>
                    &nbsp;&nbsp;<span class="ky">if</span> (<span class="fn">isPlatformBrowser</span>(<span class="ky">this</span>.platformId)) &#123;<br/>
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="ok">window</span>.scrollTo(<span class="vl">0</span>, <span class="vl">0</span>);&nbsp;<span class="cm">// ✅ server skips this entire block</span><br/>
                    &nbsp;&nbsp;&#125;<br/>
                    &#125;
                  </div>
                </div>
              </div>

              <div style="display:flex;gap:1rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.85rem 1rem;">
                <div style="min-width:1.7rem;height:1.7rem;border-radius:50%;background:#fdf4ff;border:1px solid #e9d5ff;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:900;color:#7e22ce;flex-shrink:0;">3</div>
                <div style="flex:1;">
                  <p style="font-size:.76rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;"><code>inject(DOCUMENT)</code> — Angular's safe document token</p>
                  <p style="font-size:.73rem;color:var(--ink-2);line-height:1.65;margin-bottom:.6rem;">Instead of calling <code>document</code> directly (which crashes on the server), ask Angular for it using <code>inject(DOCUMENT)</code>. In the browser Angular gives you the real <code>document</code>. On the server it gives you a safe dummy version (a placeholder that silently does nothing instead of crashing). Use this for <code>document.title</code>, <code>document.cookie</code>, or setting page title and description tags that search engines read.</p>
                  <div class="code-block" style="font-size:.68rem;">
                    <span class="ky">private</span> doc = <span class="fn">inject</span>(<span class="fn">DOCUMENT</span>);<br/>
                    <br/>
                    <span class="fn">ngOnInit</span>() &#123;<br/>
                    &nbsp;&nbsp;<span class="ky">this</span>.doc.title = <span class="st">'My Page'</span>;&nbsp;<span class="cm">// ✅ safe on server AND browser</span><br/>
                    &#125;
                  </div>
                </div>
              </div>

            </div>

            <!-- Before / After -->
            <div class="ba-grid">
              <div class="ba-panel">
                <div class="ba-head ba-head-red">❌ Crashes on the server</div>
                <div class="code-block" style="border-radius:0;border:none;border-top:1px solid #252635;font-size:.7rem;">
                  <span class="cm">// ngOnInit runs on SERVER too — no browser!</span><br/>
                  <span class="ok">ngOnInit</span>() &#123;<br/>
                  &nbsp;&nbsp;<span class="rd">window</span>.scrollTo(<span class="vl">0</span>, <span class="vl">0</span>);&nbsp;<span class="cm">// 💥 ReferenceError</span><br/>
                  &nbsp;&nbsp;<span class="rd">localStorage</span>.getItem(<span class="st">'x'</span>);&nbsp;<span class="cm">// 💥 ReferenceError</span><br/>
                  &nbsp;&nbsp;<span class="rd">document</span>.title = <span class="st">'X'</span>;&nbsp;<span class="cm">// 💥 ReferenceError</span><br/>
                  &#125;
                </div>
              </div>
              <div class="ba-panel">
                <div class="ba-head ba-head-grn">✅ Safe — runs only in browser</div>
                <div class="code-block" style="border-radius:0;border:none;border-top:1px solid #252635;font-size:.7rem;">
                  <span class="cm">// afterNextRender = browser only, guaranteed</span><br/>
                  <span class="fn">afterNextRender</span>(() =&gt; &#123;<br/>
                  &nbsp;&nbsp;<span class="ok">window</span>.scrollTo(<span class="vl">0</span>, <span class="vl">0</span>);&nbsp;<span class="cm">// ✅ browser only</span><br/>
                  &nbsp;&nbsp;<span class="ok">localStorage</span>.getItem(<span class="st">'x'</span>);&nbsp;<span class="cm">// ✅ browser only</span><br/>
                  &nbsp;&nbsp;<span class="ok">document</span>.title = <span class="st">'X'</span>;&nbsp;<span class="cm">// ✅ browser only</span><br/>
                  &#125;);
                </div>
              </div>
            </div>
          </section>

          <hr class="divider" />

          <!-- ── 10 Setup ── -->
          <section id="setup" class="section reveal">
            <p class="eyebrow">10 · Setup</p>
            <h2 class="sec-title">How to Add SSR to an Angular App</h2>
            <p class="sec-lead">
              Angular SSR is one command away — but understanding what each generated file does
              stops you being confused the first time something doesn't work.
            </p>

            <p style="font-size:.7rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">Two commands — choose one</p>

            <div class="g2" style="margin-bottom:1.5rem;">
              <div class="code-block" style="display:flex;flex-direction:column;gap:.5rem;">
                <span class="cm">// New project with SSR from scratch</span>
                <span><span style="color:#898781;">$</span> <span class="ok" style="font-weight:700;">ng new my-app --ssr</span></span>
                <span class="cm" style="font-size:.65rem;">SSR + hydration + server routing enabled out of the box</span>
              </div>
              <div class="code-block" style="display:flex;flex-direction:column;gap:.5rem;">
                <span class="cm">// Add SSR to an existing project</span>
                <span><span style="color:#898781;">$</span> <span class="ok" style="font-weight:700;">ng add @angular/ssr</span></span>
                <span class="cm" style="font-size:.65rem;">Generates server files and updates app.config.ts automatically</span>
              </div>
            </div>

            <p style="font-size:.7rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">What each generated file actually does</p>

            <div style="display:flex;flex-direction:column;gap:.75rem;margin-bottom:1.5rem;">
              {[
                {
                  file: 'app.routes.server.ts',
                  badge: 'Main SSR config',
                  badgeColor: 'var(--blue)',
                  desc: 'Defines the renderMode for every route — Server, Prerender, or Client. This is the file you edit most. If a route is missing here, Angular defaults to Server mode.',
                  example: "{ path: 'home', renderMode: RenderMode.Prerender },\n{ path: 'profile', renderMode: RenderMode.Server },"
                },
                {
                  file: 'server.ts',
                  badge: 'Node.js entry point',
                  badgeColor: 'var(--green)',
                  desc: 'The Express/Node server that boots Angular SSR. For every incoming request it calls Angular\'s request handler, which runs your components on the server and returns the rendered HTML string. You rarely edit this — but knowing it exists explains why deployment requires a Node.js host, not just a static CDN.',
                  example: null
                },
                {
                  file: 'app.config.server.ts',
                  badge: 'Server-only providers',
                  badgeColor: 'var(--orange)',
                  desc: 'Providers that only apply when Angular runs on Node.js. Use this to override browser providers with server-safe alternatives — e.g. a different HTTP base URL for server-side API calls, or a server-safe logging service.',
                  example: null
                },
                {
                  file: 'app.config.ts',
                  badge: 'Updated automatically',
                  badgeColor: '#6b7280',
                  desc: 'ng add @angular/ssr adds provideClientHydration() here. This single provider does three things: tells Angular to adopt existing DOM nodes instead of recreating them, enables the HTTP Transfer Cache, and activates the hydration event replay buffer.',
                  example: "provideClientHydration(\n  withHttpTransferCache()   // Angular 17\n  // withFetch()            // Angular 18+ (recommended)\n)"
                },
              ].map(({ file, badge, badgeColor, desc, example }) => (
                <div style="background:var(--surface);border:1px solid var(--grid);border-radius:.75rem;padding:1rem 1.1rem;">
                  <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.5rem;flex-wrap:wrap;">
                    <code style="font-size:.7rem;font-weight:700;background:rgba(0,0,0,.06);padding:.15rem .5rem;border-radius:.3rem;color:var(--ink-1);">{file}</code>
                    <span style={`font-size:.6rem;font-weight:800;letter-spacing:.07em;color:white;background:${badgeColor};padding:.15rem .5rem;border-radius:99px;text-transform:uppercase;`}>{badge}</span>
                  </div>
                  <p style="font-size:.72rem;color:var(--ink-2);line-height:1.7;margin-bottom:0;">{desc}</p>
                  {example && (
                    <div class="code-block" style="margin-top:.65rem;font-size:.64rem;line-height:1.75;padding:.65rem .9rem;">
                      <span class="cm" set:html={example.replace(/\n/g, '<br/>')}></span>
                    </div>
                  )}
                </div>
              ))}
            </div>

            <p style="font-size:.7rem;font-weight:800;letter-spacing:.09em;color:var(--red);text-transform:uppercase;margin-bottom:.9rem;">Common first-run gotchas</p>

            <div style="display:flex;flex-direction:column;gap:.65rem;margin-bottom:.5rem;">
              {[
                { icon: '🔴', title: 'Hydration mismatch error in DevTools', body: 'Means the HTML your server produced is different from what Angular expects in the browser. Usually caused by code that reads browser globals (window, document) during server render. Fix: guard with isPlatformBrowser() or afterNextRender().' },
                { icon: '🔴', title: 'window is not defined', body: 'Your code runs on Node.js where window doesn\'t exist. Wrap any window/document/localStorage access in afterNextRender() or inject PLATFORM_ID and check isPlatformBrowser().' },
                { icon: '🟠', title: 'Page content flickers on first load', body: 'Hydration is off or provideClientHydration() is missing from app.config.ts. Without it Angular discards the server HTML and rebuilds the DOM from scratch, causing a visible flash.' },
                { icon: '🟠', title: 'API called twice (once server, once browser)', body: 'Transfer Cache is not enabled. Add withHttpTransferCache() (Angular 17) or withFetch() (Angular 18+) inside provideClientHydration(). See section 08 for the full explanation.' },
                { icon: '🔵', title: 'ng serve still runs CSR — where is SSR?', body: 'ng serve runs dev mode which uses CSR by default for faster iteration. SSR runs when you deploy. To test SSR locally: ng build then node dist/my-app/server/server.mjs.' },
              ].map(({ icon, title, body }) => (
                <div style="display:flex;gap:.75rem;align-items:flex-start;background:var(--surface);border:1px solid var(--grid);border-radius:.65rem;padding:.7rem .9rem;">
                  <span style="font-size:1rem;flex-shrink:0;margin-top:.05rem;">{icon}</span>
                  <div>
                    <p style="font-size:.71rem;font-weight:700;color:var(--ink-1);margin-bottom:.2rem;">{title}</p>
                    <p style="font-size:.68rem;color:var(--ink-2);line-height:1.6;">{body}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <hr class="divider" />

          <!-- ── 11 Takeaways ── -->
          <section id="takeaways" class="section reveal">
            <p class="eyebrow">Key Takeaways</p>
            <h2 class="sec-title">What to Remember</h2>
            <div class="card">
              {[
                '<strong>CSR = slow first load + bad SEO.</strong> Browser does all the work. Use only for pages behind login.',
                '<strong>SSR = fast first paint + great SEO.</strong> Server sends ready HTML. Use for public, per-user pages.',
                '<strong>SSG = instant + cheapest to host.</strong> HTML built at deploy time. Use for blogs, docs, marketing.',
                '<strong>Hybrid rendering</strong> mixes all three per route — Home = Prerender, Profile = Server, Dashboard = Client.',
                '<strong>Hydration</strong> stops Angular discarding server HTML — it claims existing DOM nodes and attaches interactivity.',
                '<strong>HTTP Transfer Cache</strong> stops double-fetching — the server\'s API response rides in the HTML.',
                '<strong>Browser APIs</strong> (window, document, localStorage) crash on the server — guard with <code style="background:var(--page);padding:.05rem .3rem;border-radius:.2rem;">afterNextRender()</code>.',
              ].map(text => (
                <div class="tk-item">
                  <div class="tk-dot"></div>
                  <p class="tk-text" set:html={text} />
                </div>
              ))}
            </div>
          </section>

        </div><!-- end main -->


      </div><!-- end cols -->
    </div><!-- end shell -->
  </div>
  </main>
  <Footer />
</MainLayout>

<script is:inline>
  (function () {
    var navItems = document.querySelectorAll('.left-nav-item');
    var sections  = document.querySelectorAll('section[id]');
    var dividers  = document.querySelectorAll('hr.divider');

    // Reveal all elements immediately (no scroll-fade with tab nav)
    document.querySelectorAll('.reveal').forEach(function (el) {
      el.classList.add('visible');
    });

    function showSection(targetId) {
      // Hide every section and every divider between them
      sections.forEach(function (s) { s.style.display = 'none'; });
      dividers.forEach(function (d) { d.style.display = 'none'; });

      // Show only the target
      var target = document.getElementById(targetId);
      if (target) { target.style.display = ''; }

      // Update nav active highlight
      navItems.forEach(function (item) {
        item.classList.toggle('active', item.getAttribute('href') === '#' + targetId);
      });

      // Scroll to top of content
      window.scrollTo({ top: 412, behavior: 'smooth' });
    }

    // Boot: show section 01
    showSection('csr-problem');

    // Wire up nav clicks
    navItems.forEach(function (item) {
      item.addEventListener('click', function (e) {
        e.preventDefault();
        showSection(this.getAttribute('href').replace('#', ''));
      });
    });
  })();
</script>
