                </div>
                <span class="code-filename">app.routes.server.ts</span>
              </div>
              <div class="code-block" style="border-top-left-radius:0;border-top-right-radius:0;">
                <span class="ky">import</span> &#123; RenderMode, ServerRoute &#125; <span class="ky">from</span> <span class="vl">&#39;@angular/ssr&#39;</span>;<br/>
                <br/>
                <span class="ky">export const</span> <span class="fn">serverRoutes</span>: <span class="fn">ServerRoute</span>[] = [<br/>
                <br/>
                &nbsp;&nbsp;<span class="cm">// 💧 Packaged water — build once at deploy, serve forever</span><br/>
