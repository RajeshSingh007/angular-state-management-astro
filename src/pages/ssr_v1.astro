                    <div style="display:flex;gap:.6rem;align-items:flex-start;font-size:.74rem;color:var(--ink-muted);line-height:1.6;">
                      <span style="color:var(--blue);font-weight:900;flex-shrink:0;">→</span>
                      <span><strong style="color:var(--ink);">{step}</strong> — {detail}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div class="code-bar" style="border-radius:0;">
                <div class="code-dots">
                  <div class="code-dot" style="background:#ff5f57;"></div>
                  <div class="code-dot" style="background:#febc2e;"></div>
                  <div class="code-dot" style="background:#28c840;"></div>
                </div>
                <span class="code-filename">Browser at this moment — DevTools console</span>
              </div>
              <div class="code-body" style="border-radius:0 0 var(--radius) var(--radius);font-size:.7rem;line-height:1.9;border-top:var(--border-w) solid var(--border);">
                <span class="fn">document</span>.<span class="hi">querySelector</span>(<span class="st">'h1'</span>).<span class="hi">textContent</span>&nbsp;<span style="color:var(--ink-light);font-style:italic;">// "Hello, World!"  ✅ visible</span><br/>
                <span class="fn">document</span>.<span class="hi">querySelector</span>(<span class="st">'h1'</span>).<span class="hi">onclick</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style="color:var(--ink-light);font-style:italic;">// null             ❌ no Angular yet</span><br/>
                <span class="fn">document</span>.<span class="hi">querySelector</span>(<span class="st">'h1'</span>).<span class="hi">__ngContext__</span>&nbsp;<span style="color:var(--ink-light);font-style:italic;">// undefined        ❌ no Angular yet</span>
              </div>
            </div>

            <!-- Phase 3 -->
            <div class="phase-block phase-block-green">
              <div class="phase-head">
                <div class="phase-banner">
                  <span class="phase-badge phase-badge-green">PHASE 3</span>
                  <span style="font-size:.85rem;">⚡</span>
                  <p class="phase-label">Angular Boots — Component Object meets DOM Node</p>
                </div>
                <div class="phase-steps">
                  {[
                    ["Angular's JS bundle finishes downloading and executes", 'Angular starts bootstrapping in the browser'],
                    ['Angular creates a new HelloComponent instance', 'A brand new Component Object in browser heap memory'],
                    ['ngOnInit() runs again — this time in the browser', 'platform = "Browser" is set'],
                    ['Hydration: Angular reads ng-state map', 'Connects Component Object to the existing &lt;h1&gt; DOM Node — no DOM recreation, no flicker'],
                    ['Event handlers attached to DOM Nodes', 'Change detection wired. The static page is now a live Angular app'],
                  ].map(([step, detail]) => (
                    <div class="phase-step-row">
                      <span class="phase-arrow phase-arrow-green">→</span>
                      <span><strong style="color:var(--ink);">{step}</strong> — <span set:html={detail}></span></span>
                    </div>
                  ))}
                </div>
              </div>
              <div class="code-bar" style="border-radius:0;">
                <div class="code-dots">
                  <div class="code-dot" style="background:#ff5f57;"></div>
                  <div class="code-dot" style="background:#febc2e;"></div>
                  <div class="code-dot" style="background:#28c840;"></div>
                </div>
                <span class="code-filename">After hydration completes — DevTools console</span>
