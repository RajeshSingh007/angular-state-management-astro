              <div class="code-body" style="font-size:.67rem;">
                <span class="ky">export const</span> routes = [<br/>
                &nbsp;&nbsp;&#123;<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">path</span>: <span class="st">''</span>,<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">component</span>: <span class="fn">HomeComponent</span><br/>
                &nbsp;&nbsp;&#125;,<br/>
                &nbsp;&nbsp;&#123;<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">path</span>: <span class="st">'products/:id'</span>,<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">component</span>: <span class="fn">ProductDetailComponent</span><br/>
                &nbsp;&nbsp;&#125;,<br/>
                &nbsp;&nbsp;&#123;<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">path</span>: <span class="st">'dashboard'</span>,<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">component</span>: <span class="fn">DashboardComponent</span><br/>
                &nbsp;&nbsp;&#125;<br/>
                ];
              </div>
            </div>
            <div class="code-wrap">
              <div class="code-bar"><div class="code-dots"><div class="code-dot" style="background:#ff5f57;"></div><div class="code-dot" style="background:#febc2e;"></div><div class="code-dot" style="background:#28c840;"></div></div><span class="code-filename">app.routes.server.ts — "how to serve it?"</span></div>
              <div class="code-body" style="font-size:.67rem;">
                <span class="ky">export const</span> serverRoutes = [<br/>
                &nbsp;&nbsp;&#123;<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">path</span>: <span class="st">''</span>,<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">renderMode</span>: RenderMode.<span class="ok">Prerender</span><br/>
                &nbsp;&nbsp;&#125;,<br/>
                &nbsp;&nbsp;&#123;<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">path</span>: <span class="st">'products/:id'</span>,<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">renderMode</span>: RenderMode.<span class="ok">Server</span>,<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">headers</span>: &#123; <span class="st">'Cache-Control'</span>: <span class="st">'max-age=3600'</span> &#125;<br/>
                &nbsp;&nbsp;&#125;,<br/>
                &nbsp;&nbsp;&#123;<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">path</span>: <span class="st">'dashboard'</span>,<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">renderMode</span>: RenderMode.<span class="ok">Server</span>,<br/>
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">headers</span>: &#123; <span class="st">'Cache-Control'</span>: <span class="st">'no-store'</span> &#125;<br/>
                &nbsp;&nbsp;&#125;<br/>
                ];
              </div>
            </div>
          </div>
          <div class="desc-rows">
            <div class="desc-row"><span class="desc-icon">📋</span><span><code>app.routes.ts</code> answers: <strong style="color:var(--ink);">"When the user visits /products/123, show ProductDetailComponent."</strong> — This is pure Angular, runs in the browser.</span></div>
            <div class="desc-row"><span class="desc-icon">🖥️</span><span><code>app.routes.server.ts</code> answers: <strong style="color:var(--ink);">"When the server receives a request for /products/123, run Angular and cache the result for 1 hour."</strong> — Read only by the server, never the browser.</span></div>
            <div class="desc-row"><span class="desc-icon">🔗</span><span>Angular matches them by <strong style="color:var(--ink);">the same path string</strong>. For <code>products/:id</code>: use ProductDetailComponent (routes) AND render on server with cache (server routes).</span></div>
          </div>
          <div class="callout callout-orange-left">
            <header class="callout-title callout-title-orange">Hotel analogy</header>
            <p><code>app.routes.ts</code> is the <strong style="color:var(--ink);">room directory</strong> — "Room 101 is a standard room, Room 201 is a suite."<br/><code>app.routes.server.ts</code> is the <strong style="color:var(--ink);">housekeeping schedule</strong> — "Standard rooms cleaned daily, suites every 12 hours."<br/>Two separate lists about the same rooms. One answers <em>what</em> the room is. The other answers <em>how</em> to service it.</p>
          </div>
        </div>

        <!-- 3 Things Per Route -->
        <div>
          <header class="subsec-label">3 Things You Can Set Per Route</header>
          <div class="sol-steps">
            <div class="sol-step">
              <div class="sol-num sol-num-red">1</div>
              <div>
                <p class="card-title"><code>renderMode</code> — how the HTML is produced</p>
                <p class="card-body"><code>RenderMode.Prerender</code> — built once at deploy time, served as a static file. Zero server cost per visit.<br/><code>RenderMode.Server</code> — Angular runs on the server for every request and builds fresh HTML.<br/><code>RenderMode.Client</code> — no SSR, Angular boots entirely in the browser (same as default Angular).</p>
              </div>
            </div>
            <div class="sol-step">
              <div class="sol-num sol-num-orange">2</div>
              <div>
                <p class="card-title"><code>headers</code> — how long the browser and CDN should keep a copy</p>
                <p class="card-body"><code>Cache-Control: max-age=3600</code> means "keep this response for 1 hour — don't ask the server again." <code>no-store</code> means "throw it away immediately — always ask the server." Without this, your dashboard could get cached by a CDN and served to the wrong user.</p>
              </div>
            </div>
            <div class="sol-step">
              <div class="sol-num sol-num-blue">3</div>
              <div>
                <p class="card-title"><code>status</code> / <code>redirectTo</code> — real HTTP codes, not fake browser ones</p>
                <p class="card-body">Without SSR, Angular handles 404s inside the browser — but the server still returns HTTP 200 to everyone. Google sees a 200 for a page that doesn't exist and thinks it's fine. With Server Routing, <code>status: 404</code> sends a genuine 404 HTTP response. <code>redirectTo + status: 301</code> sends a permanent redirect that browsers and search engines both honour.</p>
              </div>
            </div>
          </div>
        </div>

      </section>

      <!-- ════════════ 12 CODE ANATOMY ════════════ -->
      <section data-sid="code-anatomy" class="section sec-panel">
        <p class="eyebrow">12 · Code Anatomy Lab</p>
        <h2 class="sec-title">What Does a <span>"Component Object"</span> Look Like in Real Code?</h2>
        <p class="sec-lead">
          The words "component object," "HTML string," and "DOM node" appear in every SSR explanation —
          but what do they look like in actual Angular code? This section traces a single
          <strong>HelloWorld component</strong> through every transformation it goes through,
          from a class definition to a live pixel on screen.
        </p>

        <!-- Three Things -->
        <div class="mental-section">
          <header class="subsec-label">Three Things, Three Completely Different Natures</header>
          <div class="g3">
            <div class="sticker sticker-top-orange">
              <header class="sticker-title">🧩 Component Object</header>
              <p class="card-body">A class instance in JS memory. Has properties, methods, lifecycle hooks. Angular creates one on server AND in browser.</p>
              <code style="font-size:.68rem;background:var(--orange-pale);color:var(--orange);padding:.2rem .5rem;border-radius:var(--radius);display:block;">new HelloComponent()</code>
            </div>
            <div class="sticker sticker-top-blue">
              <header class="sticker-title">📄 HTML String</header>
              <p class="card-body">Plain text bytes — no Angular, no click handlers. Produced by evaluating the template, then sent over HTTP.</p>
              <code style="font-size:.68rem;background:var(--blue-pale);color:#0076a8;padding:.2rem .5rem;border-radius:var(--radius);display:block;">"&lt;h1&gt;Hello, World!&lt;/h1&gt;"</code>
            </div>
            <div class="sticker sticker-top-green">
              <header class="sticker-title">🌳 DOM Node</header>
              <p class="card-body">A live browser object created when the browser parses the HTML string. Can receive event listeners.</p>
              <code style="font-size:.68rem;background:var(--green-pale);color:var(--green-dark);padding:.2rem .5rem;border-radius:var(--radius);display:block;">document.querySelector('h1')</code>
            </div>
          </div>
        </div>

        <!-- The Code -->
        <div class="mental-section">
          <header class="subsec-label">One File — All Three Concepts</header>
          <div class="code-wrap">
            <div class="code-bar">
              <div class="code-dots">
                <div class="code-dot" style="background:#ff5f57;"></div>
                <div class="code-dot" style="background:#febc2e;"></div>
                <div class="code-dot" style="background:#28c840;"></div>
              </div>
              <span class="code-filename">hello.component.ts — blueprint (not the runtime object)</span>
            </div>
            <div class="code-body" style="font-size:.72rem;line-height:2.1;">
              <span style="color:var(--ink-light);font-style:italic;">// ── 🧩 CLASS BLUEPRINT: Angular reads this file and creates a Component Object from it ──</span><br/>
              <span style="color:var(--ink-light);font-style:italic;">// ── The Component Object only exists in memory at runtime — you cannot see it here ──</span><br/>
              <span class="ky">@Component</span>(&#123;<br/>
              &nbsp;&nbsp;<span class="hi">selector</span>: <span class="st">'app-hello'</span>,<span style="color:var(--ink-light);font-style:italic;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// 🌳 Angular matches this tag to a DOM Node</span><br/>
              <br/>
              &nbsp;&nbsp;<span style="color:#a78bfa;font-style:italic;">// ── 📄 TEMPLATE: Angular evaluates this → produces the HTML String ──</span><br/>
              &nbsp;&nbsp;<span class="hi">template</span>: <span class="st">`</span><br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span class="ok">&lt;<span class="ky">h1</span>&gt;</span><span class="st">Hello, &#123;&#123; name &#125;&#125;!</span><span class="ok">&lt;/<span class="ky">h1</span>&gt;</span><span style="color:var(--ink-light);font-style:italic;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// 🌳 → &lt;h1&gt; DOM Node in browser</span><br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span class="ok">&lt;<span class="ky">p</span>&gt;</span><span class="st">Running on: &#123;&#123; platform &#125;&#125;</span><span class="ok">&lt;/<span class="ky">p</span>&gt;</span><span style="color:var(--ink-light);font-style:italic;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// 🌳 → &lt;p&gt; DOM Node in browser</span><br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span class="ok">&lt;<span class="ky">button</span> <span class="hi">(click)</span>=<span class="st">"onClick()"</span>&gt;</span><span class="st">Clicked &#123;&#123; count &#125;&#125; times</span><span class="ok">&lt;/<span class="ky">button</span>&gt;</span><span style="color:var(--ink-light);font-style:italic;">&nbsp;// 🌳 → &lt;button&gt; DOM Node — (click) wired in browser only</span><br/>
              &nbsp;&nbsp;<span class="st">`</span>,<br/>
              &#125;)<br/>
              <span class="ky">export class</span> <span class="fn">HelloComponent</span> &#123;<span style="color:var(--ink-light);font-style:italic;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// 🧩 blueprint — Angular calls new HelloComponent() from this</span><br/>
              <br/>
              &nbsp;&nbsp;<span style="color:var(--ink-light);font-style:italic;">// 🧩 These define WHAT the Component Object will contain when Angular creates it:</span><br/>
              &nbsp;&nbsp;<span class="hi">name</span>     = <span class="st">'World'</span>;<span style="color:var(--ink-light);font-style:italic;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// → fills &#123;&#123; name &#125;&#125; in the template</span><br/>
              &nbsp;&nbsp;<span class="hi">platform</span> = <span class="st">''</span>;<span style="color:var(--ink-light);font-style:italic;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// → set to 'Server' or 'Browser'</span><br/>
              &nbsp;&nbsp;<span class="hi">count</span>    = <span class="vl">0</span>;<span style="color:var(--ink-light);font-style:italic;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// → fills &#123;&#123; count &#125;&#125; in the template</span><br/>
              <br/>
              &nbsp;&nbsp;<span class="ky">constructor</span>(<span class="ky">private</span> <span class="hi">platformId</span> = <span class="fn">inject</span>(<span class="hi">PLATFORM_ID</span>)) &#123;&#125;<br/>
              <br/>
              &nbsp;&nbsp;<span style="color:var(--ink-light);font-style:italic;">// 🧩 Lifecycle hook — runs when the component object is created:</span><br/>
              &nbsp;&nbsp;<span class="fn">ngOnInit</span>() &#123;<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">this</span>.<span class="hi">platform</span> = <span class="fn">isPlatformBrowser</span>(<span class="hi">this</span>.<span class="hi">platformId</span>)<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;? <span class="st">'Browser'</span>&nbsp;&nbsp;<span style="color:var(--ink-light);font-style:italic;">// ← browser component object runs THIS branch</span><br/>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: <span class="st">'Server'</span>;&nbsp;&nbsp;<span style="color:var(--ink-light);font-style:italic;">// ← server component object runs THIS branch</span><br/>
              &nbsp;&nbsp;&#125;<br/>
              <br/>
              &nbsp;&nbsp;<span style="color:var(--ink-light);font-style:italic;">// 🧩 onClick method — exists in BOTH server and browser Component Objects</span><br/>
              &nbsp;&nbsp;<span style="color:var(--ink-light);font-style:italic;">// ⚠️ On the server: this method EXISTS in memory but is never triggered</span><br/>
              &nbsp;&nbsp;<span style="color:var(--ink-light);font-style:italic;">// ⚠️ The server has no screen, no user, no mouse — clicks only happen in a browser</span><br/>
              &nbsp;&nbsp;<span style="color:var(--ink-light);font-style:italic;">// ⚠️ In the browser: Angular wires this to the &lt;button&gt; DOM Node via addEventListener()</span><br/>
              &nbsp;&nbsp;<span class="fn">onClick</span>() &#123;<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span class="hi">this</span>.<span class="hi">count</span>++;<span style="color:var(--ink-light);font-style:italic;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;// updates count → Angular updates the DOM</span><br/>
              &nbsp;&nbsp;&#125;<br/>
              &#125;
            </div>
          </div>
        </div>

        <!-- Run 1 vs Run 2 -->
        <div class="mental-section">
          <header class="subsec-label">The same code runs twice — a different job each time</header>
          <div class="g2">
            <div class="sticker sticker-top-orange">
              <header class="sticker-title">🖥️ Run 1 — Server (Node.js)</header>
              <div style="display:flex;flex-direction:column;gap:.5rem;font-size:.75rem;color:var(--ink-muted);line-height:1.6;">
                <p>• <code style="background:var(--orange-pale);color:var(--orange);padding:.1rem .3rem;border-radius:6px;">new HelloComponent()</code> created in Node.js RAM</p>
                <p>• <code style="background:var(--orange-pale);color:var(--orange);padding:.1rem .3rem;border-radius:6px;">ngOnInit()</code> runs — platform = "Server"</p>
