---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
---
<MainLayout
  title="Angular SSR — Visual Deep Dive"
  description="A visual guide to Angular Server-Side Rendering, Hydration, Hybrid Rendering and the HTTP Transfer Cache.">
  <Navbar active="/ssr" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

  <style>
    /* ── TOKENS — exact Duolingo Design.md spec ── */
    :root {
      /* Colors */
      --green:        #58cc02;   /* Eager Green */
      --green-dark:   #46a302;
      --green-light:  #d7ffb8;   /* Storybook Green */
      --green-pale:   #f0fde4;
      --blue:         #1cb0f6;   /* Spark Blue */
      --blue-light:   #ccedfd;
      --blue-pale:    #e8f7fe;
      --ink:          #4b4b4b;   /* Charcoal — hero headings, primary body */
      --ink-muted:    #777777;   /* Pencil Gray — secondary body text */
      --ink-light:    #afafaf;   /* Faded Gray — disabled, borders */
      --night-ink:    #000437;   /* Night Ink — deep accent */
      --surface:      #ffffff;   /* Paper White */
      --page:         #ffffff;
      --border:       #e5e5e5;
      --red:          #ff4b4b;
      --red-light:    #ffd7d7;
      --red-pale:     #fff0f0;
      --yellow:       #ffd900;
      --yellow-pale:  #fffae0;
      --purple:       #ce82ff;
      --purple-pale:  #f7eeff;
      --orange:       #ff9600;
      --orange-pale:  #fff3de;
      /* Typography */
      --font-head:    'Nunito', system-ui, sans-serif; /* Substitute for Feather */
      --font-body:    'Nunito', system-ui, sans-serif; /* Substitute for din-round */
      --font-code:    'JetBrains Mono', monospace;
      /* Duolingo Type Scale Tokens */
      --text-caption:    13px;  --lh-caption:  1.23; --ls-base: 0.053em;
      --text-body:       15px;  --lh-body:     1.47;
      --text-heading-sm: 19px;  --lh-hsm:      1.33;
      --text-heading:    32px;  --lh-heading:  1.21;
      --text-display:    64px;  --lh-display:  1.2;  --ls-display: -0.02em;
      --fw-medium: 500;  --fw-bold: 700;
      /* Duolingo additional color tokens */
      --lingot-lime:    #a5ed6e;
      --graphite:       #3c3c3c;
      --eel-dark-blue:  #042c60;
      /* Shapes — 12px everywhere per spec */
      --radius:       12px;
      --border-w:     2px;
      /* Spacing — Design.md scale */
      --sp-8:   8px;  --sp-12: 12px; --sp-16: 16px; --sp-24: 24px;
      --sp-32: 32px;  --sp-40: 40px; --sp-48: 48px; --sp-64: 64px;
      --sp-80: 80px;  --sp-96: 96px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; }

    body {
      background: var(--page);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: var(--text-body);
      font-weight: var(--fw-medium);
      line-height: var(--lh-body);
      letter-spacing: var(--ls-base);
    }

    p {
      font-size: var(--text-body);
      line-height: var(--lh-body);
      letter-spacing: var(--ls-base);
      font-weight: var(--fw-medium);
      color: var(--ink-muted);
    }

    /* ── PAGE SHELL ── */
    .page-max { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }

    /* ── HERO ── */
    .hero {
      background: var(--surface);
      border-bottom: var(--border-w) solid var(--border);
      padding: 5rem 1.5rem 4rem;
    }
    .hero-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    @media (max-width: 800px) { .hero-inner { grid-template-columns: 1fr; } }

    .hero-eyebrow {
      display: inline-block;
      background: var(--green-light);
      color: var(--green-dark);
      border: var(--border-w) solid var(--green);
      border-radius: var(--radius);
      font-size: .75rem;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: .3rem 1rem;
      margin-bottom: 1.25rem;
    }

    .hero h1 {
      font-family: var(--font-head);
      font-size: clamp(2.4rem, 5vw, 3.6rem);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -.02em;
      color: var(--ink);
      margin-bottom: 1.25rem;
    }
    .hero h1 span { color: var(--green); }

    .hero-lead {
      font-size: 1.05rem;
      color: var(--ink-muted);
      line-height: 1.75;
      margin-bottom: 2rem;
      max-width: 46ch;
    }

    .hero-pills { display: flex; flex-wrap: wrap; gap: .5rem; }
    .pill {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      background: var(--page);
      border: var(--border-w) solid var(--border);
      border-radius: var(--radius);
      font-size: .78rem;
      font-weight: 700;
      color: var(--ink);
      padding: .3rem .9rem;
    }
    .pill-dot { width: .45rem; height: .45rem; border-radius: 50%; background: var(--green); flex-shrink: 0; }

    /* ── HERO ILLUSTRATION ── */
    .hero-illo {
      background: var(--green-pale);
      border: var(--border-w) solid var(--green);
      border-radius: var(--radius);
      padding: 2rem;
      position: relative;
    }

    /* ── SECTION ── */
    .section {
      padding: 5rem 0;
      border-bottom: var(--border-w) solid var(--border);
    }
    .section:last-of-type { border-bottom: none; }

    .section-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    .section-split.flip { direction: rtl; }
    .section-split.flip > * { direction: ltr; }
    @media (max-width: 800px) { .section-split { grid-template-columns: 1fr; } .section-split.flip { direction: ltr; } }

    .eyebrow {
      display: inline-block;
      font-size: var(--text-caption);
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--green-dark);
      margin-bottom: .75rem;
    }

    .sec-title {
      font-family: var(--font-head);
      font-size: clamp(1.6rem, 3vw, 3rem);
      font-weight: 900;
      line-height: 1.2;
      letter-spacing: -.02em;
      color: var(--green);   /* Eager Green — spec: display headlines ARE green */
      margin-bottom: 1rem;
    }
    .sec-title span { color: var(--ink); }

    .sec-lead {
      font-size: var(--text-heading-sm);
      color: var(--ink-muted);
      line-height: var(--lh-hsm);
      letter-spacing: var(--ls-base);
      font-weight: var(--fw-medium);
      margin-bottom: 1.75rem;
    }

    /* ── TYPOGRAPHY UTILITIES ── */
    .card-body  { font-size: var(--text-body); color: var(--ink-muted); line-height: var(--lh-body); letter-spacing: var(--ls-base); font-weight: var(--fw-medium); }
    .card-title { font-size: var(--text-body); font-weight: var(--fw-bold); color: var(--ink); letter-spacing: var(--ls-base); margin-bottom: .25rem; }
    .sticker-header { display: flex; align-items: center; gap: .6rem; margin-bottom: .5rem; }
    .sticker-icon   { font-size: 1.25rem; flex-shrink: 0; }
    .sticker-label  { font-size: var(--text-body); font-weight: 800; color: var(--ink); letter-spacing: var(--ls-base); }
    .hero-banner-text { font-size: var(--text-caption); font-weight: 900; color: white; letter-spacing: var(--ls-base); }
    .phase-label  { font-size: var(--text-caption); font-weight: 800; color: var(--ink); letter-spacing: var(--ls-base); line-height: var(--lh-caption); }
    .callout-point { font-size: var(--text-body); color: var(--green-dark); font-weight: var(--fw-bold); letter-spacing: var(--ls-base); }
    .code-body-sm { font-size: .68rem; }
    .subsec-label {
      font-size: var(--text-caption); font-weight: 800; letter-spacing: .09em;
      text-transform: uppercase; color: var(--green-dark); margin-bottom: 1rem;
    }
    /* ── SECTION-01 WORKER CARDS ── */
    .worker-tag     { font-size: var(--text-caption); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin-bottom: .3rem; }
    .worker-action  { font-size: var(--text-body); font-weight: var(--fw-bold); color: var(--ink); margin-bottom: .3rem; }
    .worker-trigger { font-size: var(--text-caption); font-weight: var(--fw-bold); margin-top: .5rem; }
    .worker-name    { font-size: var(--text-caption); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: .75rem 1rem .2rem; }
    .worker-body    { padding: 0 1rem .75rem; }
    .flow-header    { font-size: var(--text-caption); font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
    .step-label     { font-size: var(--text-body); font-weight: var(--fw-bold); color: var(--ink); margin-bottom: .15rem; }
    .step-body      { font-size: var(--text-caption); color: var(--ink-muted); line-height: var(--lh-caption); }

    /* ── SECTION-01 LAYOUT UTILITIES ── */
    .sec-stickers   { display: flex; flex-direction: column; gap: var(--sp-12); margin-bottom: var(--sp-24); }
    .tl-card-title  { font-size: var(--text-body); font-weight: var(--fw-bold); color: var(--ink); letter-spacing: var(--ls-base); margin-bottom: var(--sp-12); }
    .tl-card-note   { font-size: var(--text-caption); color: var(--ink-muted); line-height: var(--lh-body); letter-spacing: var(--ls-base); margin-top: var(--sp-12); }

    /* browser-worker overview cards */
    .browser-systems { margin-top: var(--sp-24); }
    .worker-cards { display: flex; flex-direction: column; gap: var(--sp-12); margin-bottom: var(--sp-16); }
    .worker-card {
      background: var(--surface); border: var(--border-w) solid var(--border);
      border-radius: var(--radius); padding: var(--sp-16);
    }
    .worker-card-blue   { border-top: 3px solid var(--blue); }
    .worker-card-orange { border-top: 3px solid var(--orange); }
    .worker-card-green  { border-top: 3px solid var(--green); }
    .worker-tag-blue    { color: var(--blue); }
    .worker-tag-orange  { color: var(--orange); }
    .worker-tag-green   { color: var(--green-dark); }
    .worker-trigger-blue   { color: var(--blue); }
    .worker-trigger-orange { color: var(--orange); }
    .worker-trigger-green  { color: var(--green-dark); }

    /* dom-note callout */
    .dom-note {
      background: var(--surface); border: var(--border-w) solid var(--border);
      border-radius: var(--radius); padding: var(--sp-12) var(--sp-16);
      margin-bottom: var(--sp-24); font-size: var(--text-caption);
      color: var(--ink-muted); line-height: var(--lh-body);
    }

    /* worker detail cards */
    .worker-detail-cards { display: flex; flex-direction: column; gap: var(--sp-16); margin-bottom: var(--sp-24); }
    .worker-detail-card  { background: var(--surface); border: var(--border-w) solid var(--border); border-radius: var(--radius); }
    .worker-detail-blue   { border-left: 4px solid var(--blue); }
    .worker-detail-orange { border-left: 4px solid var(--orange); }
    .worker-detail-green  { border-left: 4px solid var(--green); }
    .worker-name-blue   { color: var(--blue); }
    .worker-name-orange { color: var(--orange); }
    .worker-name-green  { color: var(--green-dark); }
    .worker-detail-code {
      border-top: var(--border-w) solid var(--border);
      border-radius: 0 0 var(--radius) var(--radius); overflow: hidden;
    }

    /* CSR vs SSR flow blocks */
    .flow-section { display: flex; flex-direction: column; gap: var(--sp-16); margin-bottom: var(--sp-24); }
    .flow-block   { background: var(--surface); border: var(--border-w) solid var(--border); border-radius: var(--radius); overflow: hidden; }
    .flow-block-header { padding: var(--sp-8) var(--sp-16); }
    .flow-block-csr .flow-block-header { background: var(--red-pale);   border-bottom: var(--border-w) solid var(--red-light); }
    .flow-block-ssr .flow-block-header { background: var(--green-pale); border-bottom: var(--border-w) solid var(--green-light); }
    .flow-block-csr .flow-header { color: var(--red); }
    .flow-block-ssr .flow-header { color: var(--green-dark); }
    .flow-block-body { padding: var(--sp-12) var(--sp-16); display: flex; flex-direction: column; gap: var(--sp-8); }
    .flow-step {
      display: flex; gap: var(--sp-8); align-items: flex-start;
      border-radius: 8px; padding: var(--sp-8) var(--sp-12);
    }
    .flow-step-num {
      min-width: 1.25rem; height: 1.25rem; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: .58rem; font-weight: 900; flex-shrink: 0; margin-top: .05rem;
    }
    .flow-step-red    { background: var(--red-pale);    border: 1px solid var(--red-light); }
    .flow-step-orange { background: var(--orange-pale); border: 1px solid #ffd7b5; }
    .flow-step-green  { background: var(--green-pale);  border: 1px solid var(--green-light); }
    .flow-step-blue   { background: var(--blue-pale);   border: 1px solid var(--blue-light); }
    .flow-step-num-red    { border: 1.5px solid var(--red-light);   color: var(--red); }
    .flow-step-num-orange { border: 1.5px solid #ffd7b5;            color: var(--orange); }
    .flow-step-num-green  { border: 1.5px solid var(--green-light); color: var(--green-dark); }
    .flow-step-num-blue   { border: 1.5px solid var(--blue-light);  color: #0076a8; }

    /* diff comparison block */
    .diff-block       { background: var(--surface); border: var(--border-w) solid var(--border); border-radius: var(--radius); padding: var(--sp-16) var(--sp-24); }
    .diff-block-title { font-size: var(--text-body); font-weight: var(--fw-bold); color: var(--ink); letter-spacing: var(--ls-base); margin-bottom: var(--sp-12); }
    .diff-items       { display: flex; flex-direction: column; gap: var(--sp-12); }
    .diff-item        { border-radius: var(--radius); padding: var(--sp-12) var(--sp-16); }
    .diff-item-csr    { background: var(--red-pale);   border: 1px solid var(--red-light); }
    .diff-item-ssr    { background: var(--green-pale); border: 1px solid var(--green-light); }
    .diff-item-label  { font-size: var(--text-caption); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin-bottom: .25rem; }
    .diff-item-csr .diff-item-label { color: var(--red); }
    .diff-item-ssr .diff-item-label { color: var(--green-dark); }

    /* ── LAYOUT HELPERS ── */
    .mb-lg  { margin-bottom: var(--sp-32); }
    .mb-md  { margin-bottom: var(--sp-24); }

    /* ── CALLOUT TITLE VARIANTS ── */
    .callout-title-green  { color: var(--green-dark); }
    .callout-title-blue   { color: #0076a8; }
    .callout-title-orange { color: #92400e; }
    .callout-title-red    { color: #9b1c1c; }
    .callout-title-yellow { color: #856800; }

    /* ── STICKER CONTENT ── */
    .sticker-emoji { font-size: 1.5rem; margin-bottom: .5rem; line-height: 1; }
    .sticker-title { font-size: var(--text-body); font-weight: var(--fw-bold); color: var(--ink); letter-spacing: var(--ls-base); margin-bottom: .35rem; }

    /* ── STICKER ACCENT BORDERS ── */
    .sticker-top-orange { border-top:  3px solid var(--orange); }
    .sticker-top-green  { border-top:  3px solid var(--green); }
    .sticker-top-blue   { border-top:  3px solid var(--blue); }
    .sticker-top-red    { border-top:  3px solid var(--red); }
    .sticker-left-green { border-left: 3px solid var(--green); }
    .sticker-left-blue  { border-left: 3px solid var(--blue); }
    .sticker-left-red   { border-left: 3px solid var(--red); }

    /* ── CHIP INSIDE FLEX COL ── */
    .mode-card .chip { align-self: flex-start; }

    /* ── NUMBERED SOLUTION STEPS (sec 07, 08, 09, 10) ── */
    .sol-steps { display: flex; flex-direction: column; gap: var(--sp-8); }
    .sol-step   { display: flex; gap: var(--sp-16); align-items: flex-start; background: var(--surface); border: var(--border-w) solid var(--border); border-radius: var(--radius); padding: var(--sp-12) var(--sp-16); }
    .sol-step-err { background: var(--red-pale); border-color: var(--red-light); }
    .sol-num    { min-width: 1.7rem; height: 1.7rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .65rem; font-weight: 900; flex-shrink: 0; }
    .sol-num-red    { background: var(--red-pale);    border: 1px solid var(--red-light);   color: var(--red); }
    .sol-num-orange { background: var(--orange-pale); border: 1px solid #fed7aa;            color: var(--orange); }
    .sol-num-green  { background: var(--green-pale);  border: 1px solid var(--green-light); color: var(--green-dark); }
    .sol-num-blue   { background: var(--blue-pale);   border: 1px solid var(--blue-light);  color: #0076a8; }
    .sol-num-purple { background: #fdf4ff;             border: 1px solid #e9d5ff;             color: #7e22ce; }
    .sol-num-err    { background: #fee2e2;             border: 1px solid #fca5a5;             color: var(--red); }

    /* ── HYDRATION STEP COLORS ── */
    .hyd-num-blue   { background: var(--blue-pale);   border-color: var(--blue);   color: var(--ink); }
    .hyd-num-yellow { background: var(--yellow-pale); border-color: var(--yellow); color: var(--ink); }
    .hyd-num-green  { background: var(--green-pale);  border-color: var(--green);  color: var(--ink); }

    /* ── CUSTOM CALLOUT VARIANTS ── */
    .callout-red-left    { background: var(--red-pale);    border: var(--border-w) solid var(--red-light);    border-left: 4px solid var(--red); }
    .callout-orange-left { background: var(--orange-pale); border: var(--border-w) solid #fed7aa;              border-left: 4px solid var(--orange); }
    .callout-blue-left   { background: var(--blue-pale);   border: var(--border-w) solid var(--blue-light);   border-left: 4px solid var(--blue); }

    /* ── SECTION 06 HYBRID ── */
    .hotel-row  { display: flex; gap: var(--sp-8); align-items: flex-start; font-size: var(--text-body); }
    .icon-shrink { flex-shrink: 0; }
    .route-card-head { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-8); }
    .route-section-title { font-size: var(--text-body); font-weight: var(--fw-bold); color: var(--ink); letter-spacing: var(--ls-base); margin-bottom: var(--sp-12); }

    /* ── TRANSFER CACHE STEPS ── */
    .tc-steps { display: flex; flex-direction: column; gap: var(--sp-8); }
    .tc-step  { display: flex; gap: var(--sp-12); align-items: flex-start; background: var(--surface); border: var(--border-w) solid var(--border); border-radius: var(--radius); padding: var(--sp-12) var(--sp-16); }
    .tc-num   { min-width: 1.65rem; height: 1.65rem; border-radius: 50%; background: var(--green-light); border: var(--border-w) solid var(--green); display: flex; align-items: center; justify-content: center; font-size: .65rem; font-weight: 900; color: var(--green-dark); flex-shrink: 0; }

    /* ── BEFORE/AFTER CODE PANELS ── */
    .ba-code-panel    { border-radius: var(--radius); overflow: hidden; }
    .ba-code-bad      { border: var(--border-w) solid var(--red-light); }
    .ba-code-good     { border: var(--border-w) solid var(--green-light); }
    .ba-code-head     { padding: .6rem 1rem; }
    .ba-code-bad  .ba-code-head  { background: var(--red-pale);   border-bottom: var(--border-w) solid var(--red-light); }
    .ba-code-good .ba-code-head  { background: var(--green-pale); border-bottom: var(--border-w) solid var(--green-light); }
    .ba-code-bad  .ba-code-head header,
    .ba-code-good .ba-code-head header { font-size: var(--text-body); font-weight: var(--fw-bold); letter-spacing: var(--ls-base); }
    .ba-code-bad  .ba-code-head header { color: var(--red); }
    .ba-code-good .ba-code-head header { color: var(--green-dark); }

    /* ── SETUP FILE CARDS .map() ── */
    .setup-file-card { background: var(--surface); border: var(--border-w) solid var(--border); border-radius: var(--radius); padding: var(--sp-16); }
    .setup-file-head { display: flex; align-items: center; gap: var(--sp-8); margin-bottom: var(--sp-8); flex-wrap: wrap; }
    .setup-file-name { font-size: .72rem; font-weight: 700; background: rgba(0,0,0,.05); padding: .15rem .5rem; border-radius: var(--radius); color: var(--ink); }
    .setup-badge     { font-size: .62rem; font-weight: 800; letter-spacing: .07em; color: white; padding: .15rem .5rem; border-radius: var(--radius); text-transform: uppercase; }
    .badge-blue      { background: var(--blue); }
    .badge-green-dk  { background: var(--green-dark); }
    .badge-orange    { background: var(--orange); }
    .badge-gray      { background: var(--ink-light); }

    /* ── SECTION 12 PHASE BLOCKS ── */
    .phase-block        { border-radius: var(--radius); overflow: hidden; }
    .phase-block-orange { background: var(--orange-pale); border: var(--border-w) solid var(--orange); border-left: 4px solid var(--orange); }
    .phase-block-green  { background: var(--green-pale);  border: var(--border-w) solid var(--green);  border-left: 4px solid var(--green); }
    .phase-head   { padding: var(--sp-16) var(--sp-24) var(--sp-12); }
    .phase-banner { display: flex; align-items: center; gap: var(--sp-8); margin-bottom: var(--sp-12); }
    .phase-badge  { font-size: .62rem; font-weight: 900; padding: .2rem .6rem; border-radius: var(--radius); letter-spacing: .06em; color: white; }
    .phase-badge-orange { background: var(--orange); }
    .phase-badge-green  { background: var(--green); }
    .phase-steps { display: flex; flex-direction: column; gap: var(--sp-8); margin-bottom: var(--sp-12); }
    .phase-step-row   { display: flex; gap: var(--sp-8); align-items: flex-start; font-size: var(--text-caption); color: var(--ink-muted); line-height: var(--lh-body); }
    .phase-arrow          { font-weight: 900; flex-shrink: 0; color: var(--orange); }
    .phase-arrow-green    { color: var(--green-dark); }

    /* ── SECTION 12 API TABLE ROWS ── */
    .api-rows     { font-size: .72rem; display: flex; flex-direction: column; }
    .api-row      { display: flex; justify-content: space-between; align-items: baseline; padding: .3rem 0; border-bottom: 1px solid var(--border); gap: var(--sp-12); }
    .api-lbl      { font-weight: 700; white-space: nowrap; }
    .api-lbl-green { color: var(--green-dark); }
    .api-lbl-blue  { color: var(--blue); }
    .api-lbl-red   { color: var(--red); }
    .api-desc      { color: var(--ink-muted); text-align: right; }
    .api-desc-err  { color: #dc2626; font-weight: 600; text-align: right; }

    /* ── SECTION 04 WORLD/MENTAL-MODEL ── */
    .mental-section   { margin-bottom: var(--sp-32); }
    .analogy-grid3    { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--sp-12); margin-bottom: var(--sp-16); }
    .analogy-grid2    { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-16); }

    /* ── SECTION 07 RESTAURANT ANALOGY ── */
    .menu-items { display: flex; flex-direction: column; gap: var(--sp-8); }
    .menu-item  { display: flex; gap: var(--sp-12); align-items: flex-start; }
    .menu-icon  { font-size: var(--text-body); flex-shrink: 0; }
    .explain-rows { display: flex; flex-direction: column; gap: var(--sp-8); margin-bottom: var(--sp-16); }
    .explain-row  { display: flex; gap: var(--sp-12); align-items: flex-start; font-size: var(--text-caption); color: var(--ink-muted); line-height: var(--lh-body); }
    .explain-num  { font-weight: var(--fw-bold); flex-shrink: 0; }
    .explain-num-green { color: var(--green-dark); }
    .explain-num-blue  { color: var(--blue); }
    .desc-rows { display: flex; flex-direction: column; gap: var(--sp-8); margin-bottom: var(--sp-16); }
    .desc-row  { display: flex; gap: var(--sp-12); align-items: flex-start; font-size: var(--text-caption); color: var(--ink-muted); line-height: var(--lh-body); }
    .desc-icon { font-size: var(--text-body); flex-shrink: 0; }

    /* ── FLEX COLUMN HELPERS ── */
    .flex-col-sm { display: flex; flex-direction: column; gap: var(--sp-8); }
    .flex-col-md { display: flex; flex-direction: column; gap: var(--sp-12); }
    .flex-col-lg { display: flex; flex-direction: column; gap: var(--sp-24); }

    /* ── STICKER LIST ── */
    .sticker-list { display: flex; flex-direction: column; gap: var(--sp-8); font-size: var(--text-caption); color: var(--ink-muted); line-height: var(--lh-body); }

    /* ── STICKER CARD ── */
    .sticker {
      background: var(--surface);
      border: var(--border-w) solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      transition: transform .15s, border-color .15s;
    }
    .sticker:hover { transform: translateY(-2px); border-color: var(--green); }

    .sticker-green  { background: var(--green-pale);  border-color: var(--green); }
    .sticker-blue   { background: var(--blue-pale);   border-color: var(--blue); }
    .sticker-red    { background: var(--red-pale);    border-color: var(--red); }
    .sticker-yellow { background: var(--yellow-pale); border-color: var(--yellow); }
    .sticker-purple { background: var(--purple-pale); border-color: var(--purple); }
    .sticker-orange { background: var(--orange-pale); border-color: var(--orange); }

    /* ── TAG / CHIP ── */
    .chip {
      display: inline-block;
      font-size: .68rem;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      padding: .2rem .65rem;
      border-radius: var(--radius);
      border: var(--border-w) solid;
    }
    .chip-green  { background: var(--green-light); color: var(--green-dark); border-color: var(--green); }
    .chip-blue   { background: var(--blue-light);  color: #0076a8;           border-color: var(--blue); }
    .chip-red    { background: var(--red-light);   color: #c0392b;           border-color: var(--red); }
    .chip-yellow { background: var(--yellow-pale); color: #856800;           border-color: var(--yellow); }
    .chip-purple { background: var(--purple-pale); color: #7b2cbf;           border-color: var(--purple); }
    .chip-orange { background: var(--orange-pale); color: #974f00;           border-color: var(--orange); }

    /* ── GRIDS ── */
    .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .g3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
    @media (max-width: 760px) { .g3 { grid-template-columns: 1fr; } }
    @media (max-width: 560px) { .g2 { grid-template-columns: 1fr; } }

    /* ── MODE CARDS ── */
    .mode-card {
      background: var(--surface);
      border: var(--border-w) solid var(--border);
      border-radius: var(--radius);
      padding: 1.75rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: .75rem;
      transition: transform .15s, border-color .15s;
    }
    .mode-card:hover { transform: translateY(-2px); border-color: var(--ink); }
    .mode-card.csr { border-color: var(--red);    background: var(--red-pale); }
    .mode-card.ssr { border-color: var(--blue);   background: var(--blue-pale); }
    .mode-card.ssg { border-color: var(--green);  background: var(--green-pale); }

    .mode-emoji { font-size: 2.5rem; line-height: 1; }
    .mode-name  { font-size: var(--text-caption); font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    .mode-title { font-family: var(--font-head); font-size: 1.1rem; font-weight: 900; color: var(--ink); margin-bottom: .35rem; }
    .mode-desc  { font-size: var(--text-body); color: var(--ink-muted); line-height: var(--lh-body); letter-spacing: var(--ls-base); }
    .mode-analogy {
      background: rgba(0,0,0,.05); border: 1.5px solid rgba(0,0,0,.08);
      border-radius: var(--radius); padding: .65rem .85rem;
      font-size: var(--text-caption); line-height: var(--lh-body); color: var(--ink-muted);
    }
    .mode-pros  { display: flex; flex-direction: column; gap: .2rem; font-size: var(--text-body); }
    .pro { color: var(--green-dark); font-weight: var(--fw-bold); }
    .con { color: var(--red); font-weight: var(--fw-bold); }
    .mode-code  {
      font-family: var(--font-code);
      font-size: .72rem;
      font-weight: 700;
      background: rgba(0,0,0,.06);
      border: var(--border-w) solid rgba(0,0,0,.1);
      border-radius: var(--radius);
      padding: .4rem .8rem;
      margin-top: auto;
      color: var(--ink);
    }

    /* ── TIMELINE ── */
    .timeline-card {
      background: var(--surface);
      border: var(--border-w) solid var(--border);
      border-radius: var(--radius);
      padding: 1.75rem;
      overflow-x: auto;
    }
    .timeline { display: flex; min-width: 32rem; }
    .tl-step { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; }
    .tl-step + .tl-step::before {
      content: '';
      position: absolute;
      top: 1.1rem;
      right: 50%; left: -50%;
      height: 3px;
    }
    .tl-step.bad  + .tl-step.bad::before  { background: var(--red-light); }
    .tl-step.good + .tl-step.good::before { background: var(--green-light); }
    .tl-step.mixed + .tl-step::before     { background: var(--border); }

    .tl-dot {
      width: 2.2rem; height: 2.2rem; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: .72rem; font-weight: 900; z-index: 1; position: relative; flex-shrink: 0;
      border: var(--border-w) solid;
    }
    .tl-dot.bad   { background: var(--red-pale);   border-color: var(--red);   color: var(--red); }
    .tl-dot.good  { background: var(--green-pale);  border-color: var(--green); color: var(--green-dark); }
    .tl-dot.mixed { background: var(--page);         border-color: var(--border); color: var(--ink-muted); }

    .tl-label { font-size: .68rem; font-weight: 800; color: var(--ink); text-align: center; margin-top: .5rem; max-width: 6rem; line-height: 1.35; }
    .tl-sub   { font-size: .6rem;  color: var(--ink-muted); text-align: center; margin-top: .1rem; max-width: 6rem; line-height: 1.3; }
    .tl-time  { font-size: .58rem; font-weight: 800; margin-top: .3rem; padding: .12rem .45rem; border-radius: var(--radius); border: 1.5px solid; }
    .tl-time.bad  { background: var(--red-pale);   color: var(--red);        border-color: var(--red); }
    .tl-time.good { background: var(--green-pale); color: var(--green-dark); border-color: var(--green); }

    /* ── MATRIX ── */
    .matrix {
      background: var(--surface);
      border: var(--border-w) solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .matrix-head {
      display: grid;
      grid-template-columns: 1.8fr 1fr 1fr 1fr;
      background: var(--ink);
      padding: .85rem 1.25rem;
      gap: .5rem;
    }
    .mh-cell { font-size: .7rem; font-weight: 800; color: rgba(255,255,255,.6); text-align: center; }
    .mh-cell:first-child { text-align: left; }
    .mh-col {
      display: flex; flex-direction: column; align-items: center; gap: .25rem;
      font-family: var(--font-head); font-size: .8rem; font-weight: 900; color: white;
    }
    .matrix-row {
      display: grid;
      grid-template-columns: 1.8fr 1fr 1fr 1fr;
      padding: .8rem 1.25rem;
      border-bottom: 1.5px solid var(--border);
      gap: .5rem;
      align-items: center;
      transition: background .12s;
    }
    .matrix-row:last-child { border-bottom: none; }
    .matrix-row:hover { background: var(--green-pale); }
    .ma { font-size: .8rem; font-weight: 800; color: var(--ink); }
    .mc { font-size: .78rem; color: var(--ink-muted); text-align: center; }
    .check { color: var(--green-dark); font-weight: 900; }
    .cross { color: var(--red); font-weight: 900; }

    /* ── CALLOUT ── */
    .callout {
      border-radius: var(--radius);
      padding: 1.1rem 1.25rem;
      font-size: .88rem;
      line-height: 1.75;
      border: var(--border-w) solid;
    }
    .callout-green  { background: var(--green-pale);  border-color: var(--green); }
    .callout-blue   { background: var(--blue-pale);   border-color: var(--blue); }
    .callout-yellow { background: var(--yellow-pale); border-color: var(--yellow); }
    .callout-red    { background: var(--red-pale);    border-color: var(--red); }
    .callout-title  { font-weight: 900; font-size: .9rem; margin-bottom: .4rem; }

    /* ── CODE BLOCK ── */
    .code-wrap { border: var(--border-w) solid var(--border); border-radius: var(--radius); overflow: hidden; }
    .code-bar {
      display: flex; align-items: center; justify-content: space-between;
      background: var(--ink); padding: .55rem 1rem;
    }
    .code-dots { display: flex; gap: .35rem; }
    .code-dot  { width: .5rem; height: .5rem; border-radius: 50%; }
    .code-filename { font-size: .65rem; font-weight: 700; color: rgba(255,255,255,.5); font-family: var(--font-code); }
    .code-body {
      background: #1a1a2e;
      padding: 1.1rem 1.25rem;
      font-family: var(--font-code);
      font-size: .75rem;
      line-height: 2;
      overflow-x: auto;
      color: #d4d4d4;
    }
    .cm { color: #6a737d; font-style: italic; }
    .ky { color: #79b8ff; }
    .fn { color: #ffd700; }
    .st { color: #f97316; }
    .ok { color: #56d364; }
    .hi { color: #ffffff; font-weight: 700; }
    .rd { color: #ff7b72; }
    .vl { color: #d2a8ff; }

    /* ── HYDRATION STEPS ── */
    .hyd-step {
      display: flex; gap: 1.1rem; align-items: flex-start;
      background: var(--surface); border: var(--border-w) solid var(--border);
      border-radius: var(--radius); padding: 1rem 1.25rem;
      transition: transform .15s, border-color .15s;
    }
    .hyd-step:hover { transform: translateX(4px); border-color: var(--green); }
    .hyd-num {
      min-width: 2rem; height: 2rem; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: .7rem; font-weight: 900; flex-shrink: 0;
      border: var(--border-w) solid;
    }
    .hyd-lbl { font-size: .85rem; font-weight: 800; color: var(--ink); margin-bottom: .2rem; }
    .hyd-body { font-size: .8rem; color: var(--ink-muted); line-height: 1.65; }

    /* ── BEFORE / AFTER ── */
    .ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    @media (max-width: 580px) { .ba-grid { grid-template-columns: 1fr; } }
    .ba-panel { border: var(--border-w) solid; border-radius: var(--radius); overflow: hidden; }
    .ba-panel.bad  { border-color: var(--red); }
    .ba-panel.good { border-color: var(--green); }
    .ba-head { padding: .65rem 1rem; font-size: .72rem; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; }
    .ba-head.bad  { background: var(--red-pale);   color: var(--red); }
    .ba-head.good { background: var(--green-pale); color: var(--green-dark); }
    .ba-body { padding: 1rem 1.1rem; background: var(--surface); }
    .ba-step { display: flex; gap: .6rem; align-items: flex-start; font-size: .8rem; margin-bottom: .45rem; line-height: 1.55; }
    .ba-step:last-child { margin-bottom: 0; }
    .ba-n {
      min-width: 1.3rem; height: 1.3rem; border-radius: 50%;
      font-size: .6rem; font-weight: 900; display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; margin-top: .1rem; border: 1.5px solid;
    }
    .ba-n.bad     { background: var(--red-pale);   border-color: var(--red);   color: var(--red); }
    .ba-n.good    { background: var(--green-pale); border-color: var(--green); color: var(--green-dark); }
    .ba-n.neutral { background: var(--page);       border-color: var(--border); color: var(--ink-muted); }
    .s-bad  { color: var(--red);        font-weight: 800; }
    .s-good { color: var(--green-dark); font-weight: 800; }

    /* ── ROUTE CARDS ── */
    .route-card {
      background: var(--surface); border: var(--border-w) solid var(--border);
      border-radius: var(--radius); padding: .9rem 1rem;
      display: flex; flex-direction: column; gap: .35rem;
      transition: transform .15s, border-color .15s;
    }
    .route-card:hover { transform: translateY(-2px); border-color: var(--green); }
    .route-path { font-family: var(--font-code); font-size: .8rem; font-weight: 700; color: var(--ink); }
    .route-desc { font-size: .77rem; color: var(--ink-muted); line-height: 1.55; }
    .mode-pre { background: var(--green-light); color: var(--green-dark); border-color: var(--green); }
    .mode-srv { background: var(--blue-light);  color: #0076a8;           border-color: var(--blue); }
    .mode-csr { background: var(--red-light);   color: #c0392b;           border-color: var(--red); }

    /* ── VERDICT BOX ── */
    .verdict {
      background: var(--ink);
      border-radius: var(--radius);
      padding: 1.5rem 2rem;
      text-align: center;
    }
    .verdict p { font-size: .9rem; font-weight: 700; color: rgba(255,255,255,.75); line-height: 1.8; }
    .vbad  { color: #ff8080; font-weight: 900; }
    .vgood { color: var(--green); font-weight: 900; }

    /* ── TAKEAWAY LIST ── */
    .tk-item {
      display: flex; gap: .85rem; align-items: flex-start;
      padding: 1rem 0; border-bottom: 1.5px solid var(--border);
    }
    .tk-item:last-child { border-bottom: none; }
    .tk-dot {
      width: .55rem; height: .55rem; border-radius: 50%;
      background: var(--green); border: 2px solid var(--green-dark);
      flex-shrink: 0; margin-top: .55rem;
    }
    .tk-text { font-size: .88rem; color: var(--ink-muted); line-height: 1.75; }
    .tk-text strong { color: var(--ink); }

    /* ── WORLD CARDS ── */
    .world-row { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
    .world-card {
      flex: 1; min-width: 140px;
      background: var(--surface); border: var(--border-w) solid var(--border);
      border-radius: var(--radius); padding: 1.25rem; text-align: center;
      transition: transform .15s;
    }
    .world-card:hover { transform: translateY(-2px); border-color: var(--green); }
    .world-icon { font-size: 2rem; margin-bottom: .5rem; }
    .world-name { font-size: .85rem; font-weight: 900; color: var(--ink); margin-bottom: .35rem; }
    .world-desc { font-size: .75rem; color: var(--ink-muted); line-height: 1.6; }
    .world-arrow { font-size: 1.5rem; color: var(--ink-light); flex-shrink: 0; }

    /* ── APP SHELL — content + right sidebar ── */
    .app-shell {
      display: grid;
      grid-template-columns: 256px 1fr;
      align-items: start;
      max-width: 1360px;
      margin: 0 auto;
    }
    @media (max-width: 900px) { .app-shell { grid-template-columns: 1fr; } }

    .content-pane { min-height: 80vh; padding: 0 2rem 4rem 2rem; }

    /* ── SECTION PANELS — only active one is visible ── */
    .sec-panel { display: none; }
    .sec-panel.active { display: block; }

    /* ── TIMELINE SIDEBAR ── */
    .tl-sidebar {
      position: sticky;
      top: 64px;
      height: calc(100vh - 64px);
      overflow-y: auto;
      border-right: var(--border-w) solid var(--border);
      background: var(--surface);
      padding: 2rem 0 4rem;
    }
    @media (max-width: 900px) { .tl-sidebar { display: none; } }

    .tl-sidebar-title {
      font-size: .65rem;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--ink-light);
      padding: 0 1.25rem 1rem;
    }

    .tl-list {
      display: flex;
      flex-direction: column;
      padding: 0 1rem;
      gap: 0;
      position: relative;
    }

    /* single continuous connector line running through all sections & group labels */
    .tl-list::before {
      content: '';
      position: absolute;
      left: calc(1rem + .5rem + .65rem - 1px);
      top: 12px;
      bottom: 24px;
      width: 2px;
      background: var(--border);
      z-index: 0;
    }

    .tl-item {
      display: flex;
      align-items: flex-start;
      gap: .65rem;
      padding: .55rem .4rem;
      border-radius: var(--radius);
      cursor: pointer;
      border: var(--border-w) solid transparent;
      background: transparent;
      text-align: left;
      width: 100%;
      transition: background .15s, border-color .15s;
      position: relative;
      z-index: 1;
    }
    .tl-item:hover { background: var(--green-pale); border-color: var(--green); }
    .tl-item.active { background: var(--green-pale); border-color: var(--green); }

    .tl-badge {
      min-width: 1.3rem;
      height: 1.3rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .58rem;
      font-weight: 900;
      flex-shrink: 0;
      border: 2px solid var(--border);
      background: var(--surface);
      color: var(--ink-light);
      transition: all .15s;
    }
    .tl-item.active .tl-badge,
    .tl-item:hover .tl-badge {
      background: var(--green);
      border-color: var(--green-dark);
      color: white;
    }

    .tl-meta { display: flex; flex-direction: column; gap: .1rem; }
    .tl-step-num {
      font-size: .58rem;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--ink-light);
    }
    .tl-item.active .tl-step-num { color: var(--green-dark); }

    .tl-step-label {
      font-size: .76rem;
      font-weight: 700;
      color: var(--ink-muted);
      line-height: 1.35;
    }
    .tl-group-label {
      font-size: .6rem;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--ink-light);
      padding: .9rem 1rem .4rem;
    }
    .tl-group-label:first-child { padding-top: .25rem; }


    /* ── DIVIDER ── */
    .divider { border: none; border-top: var(--border-w) solid var(--border); }

    /* ── HERO SVG ILLUSTRATION ── */
    .illo-box {
      background: var(--green-pale);
      border: var(--border-w) solid var(--green);
      border-radius: var(--radius);
      padding: 1.75rem;
    }
    .illo-row { display: flex; gap: .6rem; align-items: center; margin-bottom: .65rem; }
    .illo-row:last-child { margin-bottom: 0; }
    .illo-node {
      flex: 1; display: flex; align-items: center; gap: .5rem;
      background: var(--surface); border: var(--border-w) solid var(--border);
      border-radius: var(--radius); padding: .6rem .85rem;
      font-size: .75rem; font-weight: 800; color: var(--ink);
    }
    .illo-node.accent-green { border-color: var(--green); background: var(--green-pale); color: var(--green-dark); }
    .illo-node.accent-red   { border-color: var(--red);   background: var(--red-pale);   color: var(--red); }
