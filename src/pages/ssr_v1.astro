  <script>
    const items   = document.querySelectorAll('.tl-item');
    const panels  = document.querySelectorAll('.sec-panel');

    function activate(sid) {
      items.forEach(i  => i.classList.toggle('active',  i.dataset.target === sid));
      panels.forEach(p => p.classList.toggle('active',  p.dataset.sid    === sid));
      window.scrollTo({ top: document.querySelector('.app-shell').offsetTop - 72, behavior: 'smooth' });
    }

    items.forEach(item => item.addEventListener('click', () => activate(item.dataset.target)));
  </script>
