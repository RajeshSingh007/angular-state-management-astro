---
interface Props {
  gradient: string;
  title: string;
  subtitle: string;
  pills: string[];
}
const { gradient, title, subtitle, pills } = Astro.props;
---
<div class="relative my-10 rounded-2xl overflow-hidden reveal" style={`background: ${gradient}`}>
  <div class="px-8 py-7 text-center">
    <p class="text-white/70 text-xs font-bold uppercase tracking-widest mb-2">✅ All concepts loaded</p>
    <h3 class="text-white text-2xl font-extrabold mb-2">{title}</h3>
    <p class="text-white/80 text-sm max-w-xl mx-auto mb-4" set:html={subtitle} />
    <div class="flex flex-wrap justify-center gap-3 text-xs font-semibold">
      {pills.map((pill, i) => (
        <span class={`px-3 py-1.5 rounded-full border ${i === pills.length - 1 ? 'bg-white/10 text-green-200 border-green-300/30' : 'bg-white/10 text-white/80 border-white/20'}`}>
          {pill}
        </span>
      ))}
    </div>
  </div>
</div>
