---
interface Props {
  points: string[];
  color?: 'purple' | 'blue' | 'green' | 'amber';
}
const { points, color = 'purple' } = Astro.props;
const colors = {
  purple: { bg: 'bg-purple-50', border: 'border-purple-400', title: 'text-purple-800', dot: 'bg-purple-500' },
  blue:   { bg: 'bg-blue-50',   border: 'border-blue-400',   title: 'text-blue-800',   dot: 'bg-blue-500' },
  green:  { bg: 'bg-green-50',  border: 'border-green-400',  title: 'text-green-800',  dot: 'bg-green-500' },
  amber:  { bg: 'bg-amber-50',  border: 'border-amber-400',  title: 'text-amber-800',  dot: 'bg-amber-500' },
};
const c = colors[color];
---
<div class={`${c.bg} border-2 ${c.border} rounded-2xl p-6 reveal`}>
  <h4 class={`font-extrabold text-base mb-4 ${c.title}`}>🎯 Key Takeaways</h4>
  <ul class="space-y-3">
    {points.map(p => (
      <li class="flex items-start gap-3 text-sm text-gray-700">
        <span class={`mt-1 w-2 h-2 rounded-full shrink-0 ${c.dot}`}></span>
        <span set:html={p} />
      </li>
    ))}
  </ul>
</div>
