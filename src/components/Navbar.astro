---
interface Props {
  active?: string;
  step?: string;
}
const { active = '', step } = Astro.props;

const ssrPaths = ['/ssr', '/ssr_v1'];
const signalPaths = ['/signal_v1'];

const topics = [
  { href: '/ssr_v1',    label: 'SSR',     emoji: '🌐', desc: 'Server-Side Rendering', isActive: ssrPaths.includes(active),    soon: false },
  { href: '/signal_v1', label: 'Signals', emoji: '⚡', desc: 'Angular Signals',        isActive: signalPaths.includes(active), soon: false },
];

// Parse "Step 2 of 4" → { cur: 2, total: 4 }
let stepCur = 0, stepTotal = 0;
if (step) {
  const m = step.match(/(\d+)\D+(\d+)/);
  if (m) { stepCur = +m[1]; stepTotal = +m[2]; }
}
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;700;800;900&display=swap" rel="stylesheet" />

<nav class="dln-nav" id="navbar">
  <div class="dln-inner">

    <!-- Logo -->
    <a href="/ssr_v1" class="dln-logo">
      <span class="dln-logo-bolt">⚡</span>
      <span class="dln-logo-name">Angular <span class="dln-logo-accent">Deep Dives</span></span>
    </a>

    <!-- Topic pills (desktop) -->
    <ul class="dln-topics" role="list">
      {topics.map(t => (
        <li>
          <a
            href={t.soon ? undefined : t.href}
            class={`dln-pill${t.isActive ? ' dln-pill--on' : ''}${t.soon ? ' dln-pill--soon' : ''}`}
            aria-current={t.isActive ? 'page' : undefined}
            tabindex={t.soon ? -1 : undefined}
          >
            <span class="dln-pill-icon">{t.emoji}</span>
            <span class="dln-pill-lbl">{t.label}</span>
            {t.soon && <span class="dln-badge-soon">Soon</span>}
          </a>
        </li>
      ))}
    </ul>

    <!-- Step progress dots (course pages only) -->
    {step && stepTotal > 0 && (
      <div class="dln-steps" aria-label={step} title={step}>
        {Array.from({ length: stepTotal }, (_, i) => (
          <span class={`dln-dot${i < stepCur ? ' dln-dot--done' : ''}${i === stepCur - 1 ? ' dln-dot--active' : ''}`}></span>
        ))}
        <span class="dln-steps-label">{stepCur}/{stepTotal}</span>
      </div>
    )}

    <!-- Theme picker -->
    <div class="dln-theme-wrap" id="dln-theme-wrap">
      <button class="dln-theme-btn" id="dln-theme-btn" aria-label="Change theme" title="Change theme">
        <span class="dln-theme-dot" id="dln-theme-dot"></span>
      </button>
      <div class="dln-theme-panel" id="dln-theme-panel" aria-hidden="true">
        <div class="dln-theme-grid" id="dln-theme-grid"></div>
      </div>
    </div>

    <!-- Burger (mobile) -->
    <button class="dln-burger" id="dln-burger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

  </div>

  <!-- Mobile dropdown -->
  <div class="dln-mobile" id="dln-mobile" aria-hidden="true">
    {topics.map(t => (
      <a
        href={t.soon ? undefined : t.href}
        class={`dln-mob-row${t.isActive ? ' dln-mob-row--on' : ''}${t.soon ? ' dln-mob-row--soon' : ''}`}
      >
        <span class="dln-mob-icon">{t.emoji}</span>
        <span class="dln-mob-text">
          <span class="dln-mob-lbl">{t.label}</span>
          <span class="dln-mob-desc">{t.desc}</span>
        </span>
        {t.soon
          ? <span class="dln-badge-soon">Soon</span>
          : t.isActive
            ? <span class="dln-mob-check">✓</span>
            : <span class="dln-mob-arrow">→</span>
        }
      </a>
    ))}
  </div>
</nav>

<style>
  /* ── Duolingo design tokens (self-contained) ── */
  .dln-nav {
    --green:      #58cc02;
    --green-dk:   #46a302;
    --green-pale: #f0fce8;
    --ink:        #4b4b4b;
    --ink-muted:  #777777;
    --border:     #e5e5e5;
    --surface:    #ffffff;
    --radius:     12px;
    --ls:         0.053em;
    --font:       'Nunito', system-ui, sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; }

  .dln-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 200;
    background: var(--surface);
    border-bottom: 1.5px solid var(--border);
    font-family: var(--font);
  }

  /* ── Inner bar ── */
  .dln-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 60px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* ── Logo ── */
  .dln-logo {
    display: flex;
    align-items: center;
    gap: .45rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .dln-logo-bolt { font-size: 1.35rem; line-height: 1; }
  .dln-logo-name {
    font-size: .92rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: var(--ls);
    white-space: nowrap;
  }
  .dln-logo-accent { color: var(--green-dk); }

  /* ── Topic pills ── */
  .dln-topics {
    display: flex;
    align-items: center;
    gap: .35rem;
    list-style: none;
    padding: 0;
    flex: 1;
  }

  .dln-pill {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .38rem .75rem;
    border-radius: var(--radius);
    border: 1.5px solid transparent;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: var(--ls);
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: background .15s, border-color .15s, color .15s;
    background: transparent;
  }
  .dln-pill:hover:not(.dln-pill--soon) {
    background: var(--green-pale);
    border-color: var(--green);
    color: var(--ink);
  }
  .dln-pill--on {
    background: var(--green-pale);
    border-color: var(--green);
    color: var(--green-dk);
  }
  .dln-pill--soon { opacity: .42; cursor: not-allowed; pointer-events: none; }

  .dln-pill-icon { font-size: .85rem; line-height: 1; }
  .dln-pill-lbl  { line-height: 1; }

  .dln-badge-soon {
    font-size: .52rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    background: var(--border);
    color: var(--ink-muted);
    padding: .1rem .3rem;
    border-radius: var(--radius);
    line-height: 1.4;
  }

  /* ── Step progress dots ── */
  .dln-steps {
    display: flex;
    align-items: center;
    gap: .28rem;
    flex-shrink: 0;
  }
  .dln-dot {
    width: .42rem;
    height: .42rem;
    border-radius: 50%;
    background: var(--border);
    transition: background .15s, width .15s, height .15s;
  }
  .dln-dot--done   { background: var(--green); }
  .dln-dot--active { background: var(--green-dk); width: .55rem; height: .55rem; }
  .dln-steps-label {
    font-size: .62rem;
    font-weight: 800;
    color: var(--ink-muted);
    letter-spacing: .06em;
    margin-left: .15rem;
  }

  /* ── Burger ── */
  .dln-burger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: 1.5px solid transparent;
    cursor: pointer;
    padding: .45rem .5rem;
    border-radius: 8px;
    margin-left: auto;
    flex-shrink: 0;
    transition: border-color .15s, background .15s;
  }
  .dln-burger:hover { background: var(--green-pale); border-color: var(--green); }
  .dln-burger span  { display: block; width: 20px; height: 2px; background: var(--ink); border-radius: 2px; }

  /* ── Mobile menu ── */
  .dln-mobile {
    display: none;
    flex-direction: column;
    gap: .3rem;
    padding: .75rem 1rem 1rem;
    border-top: 1.5px solid var(--border);
    background: var(--surface);
  }
  .dln-mobile.open { display: flex; }

  .dln-mob-row {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .65rem .9rem;
    border-radius: var(--radius);
    border: 1.5px solid transparent;
    text-decoration: none;
    color: var(--ink-muted);
    transition: background .15s, border-color .15s, color .15s;
  }
  .dln-mob-row:hover:not(.dln-mob-row--soon) {
    background: var(--green-pale);
    border-color: var(--green);
    color: var(--ink);
  }
  .dln-mob-row--on   { background: var(--green-pale); border-color: var(--green); color: var(--green-dk); }
  .dln-mob-row--soon { opacity: .42; pointer-events: none; }

  .dln-mob-icon  { font-size: 1.15rem; line-height: 1; flex-shrink: 0; }
  .dln-mob-text  { display: flex; flex-direction: column; gap: .1rem; flex: 1; min-width: 0; }
  .dln-mob-lbl   { font-size: .82rem; font-weight: 800; letter-spacing: var(--ls); color: inherit; }
  .dln-mob-desc  { font-size: .68rem; font-weight: 500; color: var(--ink-muted); }
  .dln-mob-check { font-size: .75rem; font-weight: 900; color: var(--green-dk); flex-shrink: 0; }
  .dln-mob-arrow { font-size: .75rem; color: var(--ink-muted); flex-shrink: 0; }

  /* ── Theme Picker ── */
  .dln-theme-wrap { position: relative; flex-shrink: 0; }

  .dln-theme-btn {
    width: 30px; height: 30px;
    border-radius: 50%;
    border: 2px solid var(--border);
    background: var(--surface);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: border-color .15s;
    flex-shrink: 0;
  }
  .dln-theme-btn:hover { border-color: var(--green); }

  .dln-theme-dot {
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--green);
    display: block;
    pointer-events: none;
  }

  .dln-theme-panel {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: .75rem;
    box-shadow: 0 8px 24px rgba(0,0,0,.12);
    z-index: 300;
    min-width: 200px;
  }
  .dln-theme-panel.open { display: block; }

  .dln-theme-heading {
    font-size: .65rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: .5rem;
  }

  .dln-theme-grid {
    display: grid;
    grid-template-columns: repeat(4, 37px);
    gap: 8px;
  }

  .dln-theme-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .2rem;
  }

  :global(.dln-theme-swatch) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2.5px solid transparent;
    cursor: pointer;
    padding: 0;
    transition: transform .12s, box-shadow .12s;
    display: block;
  }
  :global(.dln-theme-swatch:hover) { transform: scale(1.15); box-shadow: 0 2px 8px rgba(0,0,0,.2); }
  :global(.dln-theme-swatch.active) { border-color: #1a1a1a; box-shadow: 0 0 0 2px #fff inset; }

  .dln-theme-swatch-label {
    font-size: .52rem;
    font-weight: 700;
    color: var(--ink-muted);
    text-align: center;
    line-height: 1.2;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .dln-topics, .dln-steps { display: none; }
    .dln-burger { display: flex; }
  }
</style>

<script is:inline>
  const burger = document.getElementById('dln-burger');
  const mobile = document.getElementById('dln-mobile');
  if (burger && mobile) {
    burger.addEventListener('click', () => {
      const open = mobile.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
      mobile.setAttribute('aria-hidden', String(!open));
    });
    document.addEventListener('click', (e) => {
      if (!burger.contains(e.target) && !mobile.contains(e.target)) {
        mobile.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        mobile.setAttribute('aria-hidden', 'true');
      }
    });
  }

  // ── Theme Picker ──
  (function() {
    var THEMES = [
      { name: 'Classic Green',   short: 'Classic',  green: '#58cc02', dark: '#46a302', light: '#d7ffb8', pale: '#f0fde4' },
      { name: 'Blue Ocean',      short: 'Blue',     green: '#1cb0f6', dark: '#0a95da', light: '#b3e5fc', pale: '#e8f7ff' },
      { name: 'Super Purple',    short: 'Purple',   green: '#8549ba', dark: '#6a35a0', light: '#e0c8ff', pale: '#f4eeff' },
      { name: 'Midnight Indigo', short: 'Indigo',   green: '#4338ca', dark: '#3730a3', light: '#c7d2fe', pale: '#eef2ff' },
      { name: 'Midnight Navy',   short: 'Navy',     green: '#1e40af', dark: '#1e3a8a', light: '#bfdbfe', pale: '#eff6ff' },
      { name: 'Orange Torch',    short: 'Orange',   green: '#f97316', dark: '#ea6c00', light: '#fed7aa', pale: '#fff7ed' },
      { name: 'Ruby Red',        short: 'Ruby',     green: '#ef4444', dark: '#dc2626', light: '#fecaca', pale: '#fef2f2' },
      { name: 'Rose Gold',       short: 'Rose',     green: '#e11d91', dark: '#be185d', light: '#fbcfe8', pale: '#fdf2f8' },
      { name: 'Amber Gold',      short: 'Amber',    green: '#d97706', dark: '#b45309', light: '#fde68a', pale: '#fffbeb' },
      { name: 'Teal Jade',       short: 'Teal',     green: '#0d9488', dark: '#0f766e', light: '#99f6e4', pale: '#f0fdfa' },
      { name: 'Slate Dark',      short: 'Slate',    green: '#475569', dark: '#334155', light: '#cbd5e1', pale: '#f1f5f9' },
      { name: 'Emerald',         short: 'Emerald',  green: '#10b981', dark: '#059669', light: '#a7f3d0', pale: '#ecfdf5' },
    ];

    function applyTheme(t, save) {
      var r = document.documentElement;
      r.style.setProperty('--green', t.green);
      r.style.setProperty('--green-dark', t.dark);
      r.style.setProperty('--green-light', t.light);
      r.style.setProperty('--green-pale', t.pale);
      var nav = document.querySelector('.dln-nav');
      if (nav) {
        nav.style.setProperty('--green', t.green);
        nav.style.setProperty('--green-dk', t.dark);
        nav.style.setProperty('--green-pale', t.pale);
      }
      document.querySelectorAll('.dln-theme-swatch').forEach(function(s) {
        s.classList.toggle('active', s.dataset.name === t.name);
      });
      if (save) localStorage.setItem('dln-theme', t.name);
    }

    var saved = localStorage.getItem('dln-theme');
    var initial = THEMES.find(function(t) { return t.name === saved; }) || THEMES[0];
    applyTheme(initial, false);

    var grid = document.getElementById('dln-theme-grid');
    var panel = document.getElementById('dln-theme-panel');
    var btn = document.getElementById('dln-theme-btn');
    var wrap = document.getElementById('dln-theme-wrap');

    if (grid) {
      THEMES.forEach(function(t) {
        var swatch = document.createElement('button');
        swatch.className = 'dln-theme-swatch';
        swatch.dataset.name = t.name;
        swatch.style.background = t.green;
        swatch.title = t.name;
        if (t.name === initial.name) swatch.classList.add('active');
        swatch.addEventListener('click', function(e) {
          e.stopPropagation();
          applyTheme(t, true);
          if (panel) { panel.classList.remove('open'); panel.setAttribute('aria-hidden', 'true'); }
        });
        grid.appendChild(swatch);
      });
    }

    if (btn && panel) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var open = panel.classList.toggle('open');
        panel.setAttribute('aria-hidden', String(!open));
      });
      document.addEventListener('click', function(e) {
        if (wrap && !wrap.contains(e.target)) {
          panel.classList.remove('open');
          panel.setAttribute('aria-hidden', 'true');
        }
      });
    }
  })();
</script>
